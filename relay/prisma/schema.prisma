// ============================================================================
//  Schema del RELÉ LOCAL (modo sin conexión)
// ============================================================================
//  Copia reducida del schema de producción (prisma/schema.prisma) con SOLO lo
//  que el salón necesita para seguir operando si se cae el internet: tomar un
//  pedido de mesa, mandarlo a cocina, imprimirlo y marcarlo servido.
//
//  Deliberadamente NO incluye inventario, fiscal, suscripciones, delivery,
//  promociones, reservas ni caja: están fuera del alcance offline acordado, y
//  arrastrarlos solo sumaría peso y riesgo de sincronización.
//
//  Los ids son cuid igual que en producción: eso es lo que permite fusionar
//  después las filas creadas acá contra la nube sin que choquen.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/relay-client"
}

datasource db {
  provider = "postgresql"
  url      = env("RELAY_DATABASE_URL")
}

enum Currency {
  USD
  EUR
}

enum OrderChannel {
  DINE_IN
  DELIVERY
  PICKUP
  BAR
}

enum OrderStatus {
  NEEDS_CONFIRMATION
  NEEDS_PAYMENT
  PENDING
  KITCHEN
  SERVED
  CANCELLED
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

/// Configuración del restaurante que el relé necesita para cobrar bien.
/// Se baja de la nube en el snapshot de catálogo (Fase 2).
model Restaurant {
  id                   String   @id
  name                 String
  baseCurrency         Currency @default(USD)
  serviceChargeEnabled Boolean  @default(false)
  ivaEnabled           Boolean  @default(false)
  /// Última tasa conocida. Si el corte se alarga, se sigue usando esta —
  /// el pedido congela la que tenía al momento, igual que en producción.
  exchangeRate         Decimal  @default(1) @db.Decimal(18, 4)
  /// Cuándo se sincronizó por última vez desde la nube.
  syncedAt             DateTime @default(now())

  zones    Zone[]
  tables   Table[]
  kitchens Kitchen[]
  products Product[]
  sessions TableSession[]
  orders   Order[]
}

model Zone {
  id           String @id
  restaurantId String
  name         String
  priority     Int    @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables     Table[]

  @@map("zones")
}

model Table {
  id           String  @id
  restaurantId String
  zoneId       String?
  number       String
  qrToken      String  @unique
  seats        Int     @default(4)
  isActive     Boolean @default(true)
  /// Mesas unidas: la miembro apunta a la principal, que es la que lleva la cuenta.
  mergedIntoTableId String?

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  zone       Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  sessions   TableSession[]
  orders     Order[]

  @@map("tables")
}

model Kitchen {
  id           String @id
  restaurantId String
  name         String
  priority     Int    @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@map("kitchens")
}

model Product {
  id           String  @id
  restaurantId String
  kitchenId    String?
  name         String
  price        Decimal @db.Decimal(12, 2)
  isAvailable  Boolean @default(true)
  /// "SIMPLE" | "VARIANTS"
  pricingMode  String  @default("SIMPLE")
  categoryName String?
  priority     Int     @default(0)

  restaurant         Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kitchen            Kitchen?               @relation(fields: [kitchenId], references: [id], onDelete: SetNull)
  variants           ProductVariant[]
  modifierCategories ProductModifierLink[]

  @@map("products")
}

model ProductVariant {
  id               String  @id
  productId        String
  name             String
  priceBase        Decimal @db.Decimal(12, 2)
  packagingFeeBase Decimal @default(0) @db.Decimal(12, 2)
  discountBase     Decimal @default(0) @db.Decimal(12, 2)
  isAvailable      Boolean @default(true)
  priority         Int     @default(0)

  product        Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierPrices ModifierVariantPrice[]

  @@map("product_variants")
}

/// Vínculo producto <-> categoría de modificadores, con el override de máximo
/// por producto que ya existe en producción.
model ProductModifierLink {
  id                    String @id
  productId             String
  modifierCategoryId    String
  maxSelectionsOverride Int?

  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierCategory  ModifierCategory  @relation(fields: [modifierCategoryId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierCategoryId])
  @@map("product_modifier_links")
}

model ModifierCategory {
  id            String  @id
  restaurantId  String
  name          String
  isRequired    Boolean @default(false)
  allowMultiple Boolean @default(false)
  maxSelections Int?
  minSelections Int?
  priority      Int     @default(0)

  modifiers Modifier[]
  products  ProductModifierLink[]

  @@map("modifier_categories")
}

model Modifier {
  id           String  @id
  categoryId   String
  name         String
  priceBase    Decimal @default(0) @db.Decimal(12, 2)
  discountBase Decimal @default(0) @db.Decimal(12, 2)
  isAvailable  Boolean @default(true)
  maxQuantity  Int?
  priority     Int     @default(0)

  category      ModifierCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variantPrices ModifierVariantPrice[]

  @@map("modifiers")
}

model ModifierVariantPrice {
  id         String  @id
  modifierId String
  variantId  String
  priceBase  Decimal @db.Decimal(12, 2)

  modifier Modifier       @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([modifierId, variantId])
  @@map("modifier_variant_prices")
}

/// Cuenta abierta de una mesa. Creada acá si nació durante el corte.
model TableSession {
  id               String             @id @default(cuid())
  restaurantId     String
  tableId          String
  customerName     String
  customerIdNumber String
  customerPhone    String?
  label            String?
  status           TableSessionStatus @default(OPEN)
  openedAt         DateTime           @default(now())
  closedAt         DateTime?

  /// false = nació en el relé y todavía no se subió a la nube (ver Fase 4).
  syncedToCloud Boolean @default(false)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([restaurantId, tableId, status])
  @@map("table_sessions")
}

model Order {
  id           String @id @default(cuid())
  restaurantId String

  /// Correlativo LOCAL del relé, independiente del de la nube. Al sincronizar,
  /// la nube asigna el número definitivo y este queda solo como referencia
  /// para rastrear la comanda impresa (ver offlineTicketRef).
  localNumber Int
  /// Lo que se imprime en la comanda mientras no hay internet: "R-1", "R-2"...
  /// Así el mesero sabe de un vistazo que ese pedido nació sin conexión.
  offlineTicketRef String

  channel        OrderChannel
  status         OrderStatus  @default(KITCHEN)
  tableId        String?
  tableSessionId String?

  currency          Currency
  subtotalBase      Decimal  @db.Decimal(12, 2)
  serviceChargeBase Decimal  @default(0) @db.Decimal(12, 2)
  ivaBase           Decimal  @default(0) @db.Decimal(12, 2)
  totalBase         Decimal  @db.Decimal(12, 2)
  exchangeRate      Decimal  @db.Decimal(18, 4)
  totalBs           Decimal  @db.Decimal(18, 2)
  tipBase           Decimal  @default(0) @db.Decimal(12, 2)

  customerName     String?
  customerIdNumber String?
  customerPhone    String?
  placedByUserId   String?
  placedByUserName String?

  /// false = todavía no subió a la nube (ver Fase 4).
  syncedToCloud Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSession TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  items        OrderItem[]

  @@unique([restaurantId, localNumber])
  @@index([restaurantId, syncedToCloud])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  variantName String?
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)
  note        String?
  kitchenName String?

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  modifiers OrderItemModifier[]

  @@map("order_items")
}

model OrderItemModifier {
  id          String  @id @default(cuid())
  orderItemId String
  modifierId  String?
  name        String
  priceBase   Decimal @db.Decimal(12, 2)
  quantity    Int     @default(1)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("order_item_modifiers")
}
