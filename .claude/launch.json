{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "api-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 4000
    },
    {
      "name": "print-station",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "print-station", "-l", "5500"],
      "port": 5500
    }
  ]
}
