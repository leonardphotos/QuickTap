# Copia este archivo a .env en el VPS y completa los valores reales.
# NUNCA subas el .env real a git.

# ---- Servidor ----
NODE_ENV=production
PORT=4000

# ---- Base de datos (PostgreSQL) ----
# Formato: postgresql://USUARIO:CONTRASEÑA@localhost:5432/quicktap?schema=public&sslmode=require
# sslmode=require cifra la conexión sin exigir un certificado firmado por una CA real (Postgres
# en el VPS usa el snakeoil autofirmado que instala el paquete por defecto) — sslmode=verify-full
# rompería la conexión contra ese certificado. Confirma primero con `SHOW ssl;` en psql que el
# Postgres de destino tiene ssl=on antes de agregar esto, o el arranque falla.
DATABASE_URL="postgresql://quicktap:CAMBIA_ESTA_CONTRASEÑA@localhost:5432/quicktap?schema=public&sslmode=require"

# ---- Auth ----
# Genera uno nuevo y único para producción, ej: openssl rand -base64 48
JWT_SECRET="CAMBIA_ESTE_SECRETO"
JWT_EXPIRES_IN=7d
# Token del Dashboard maestro (equipo QuickTap): dura menos que el de un restaurante
# porque ve todos los tenants. Opcional, por defecto 12h.
# PLATFORM_JWT_EXPIRES_IN=12h

# ---- CORS ----
# El dominio real donde sirves el frontend (con https, sin barra final).
# http://localhost:5500 es obligatorio: la Estación de Impresión empaquetada
# (print-station/) abre su HTML desde un servidor estático local en ese
# puerto en la computadora de la caja de cada restaurante, y desde ahí llama
# a este backend por HTTPS — sin ese origen aquí, el login da "Failed to fetch"
# por CORS aunque el backend esté funcionando bien.
CORS_ORIGINS=https://tudominio.com,http://localhost:5500

# ---- Tasa de cambio BCV (opcional, ya trae valores por defecto) ----
# EXCHANGE_RATE_USD_URL=https://ve.dolarapi.com/v1/dolares/oficial
# EXCHANGE_RATE_EUR_URL=https://ve.dolarapi.com/v1/euros/oficial
# EXCHANGE_RATE_TTL_HOURS=6

# ---- Correo (restablecer contraseña) ----
# Se envía vía Resend (resend.com) con el dominio quicktap.club verificado
# (SPF/DKIM), así llega firmado como propio sin pasar por Gmail. Crea una
# cuenta gratis en resend.com, verifica el dominio y genera una API key en
# https://resend.com/api-keys. Si se deja sin completar, el código queda
# solo en los logs del servidor y nunca le llega al usuario.
RESEND_API_KEY="CAMBIA_ESTO_POR_TU_API_KEY_DE_RESEND"
MAIL_FROM_EMAIL="noreply@quicktap.club"
MAIL_FROM_NAME="QuickTap.club"

# ---- Dashboard maestro (solo se usa una vez, al correr `npm run seed:platform-admin`) ----
PLATFORM_ADMIN_NAME="Tu nombre"
PLATFORM_ADMIN_EMAIL="tu@correo.com"
PLATFORM_ADMIN_PASSWORD="CAMBIA_ESTA_CONTRASEÑA"
