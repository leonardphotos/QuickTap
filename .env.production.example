# Copia este archivo a .env en el VPS y completa los valores reales.
# NUNCA subas el .env real a git.

# ---- Servidor ----
NODE_ENV=production
PORT=4000

# ---- Base de datos (PostgreSQL) ----
# Formato: postgresql://USUARIO:CONTRASEÑA@localhost:5432/quicktap?schema=public
DATABASE_URL="postgresql://quicktap:CAMBIA_ESTA_CONTRASEÑA@localhost:5432/quicktap?schema=public"

# ---- Auth ----
# Genera uno nuevo y único para producción, ej: openssl rand -base64 48
JWT_SECRET="CAMBIA_ESTE_SECRETO"
JWT_EXPIRES_IN=7d

# ---- CORS ----
# El dominio real donde sirves el frontend (con https, sin barra final).
CORS_ORIGINS=https://tudominio.com

# ---- Tasa de cambio BCV (opcional, ya trae valores por defecto) ----
# EXCHANGE_RATE_USD_URL=https://ve.dolarapi.com/v1/dolares/oficial
# EXCHANGE_RATE_EUR_URL=https://ve.dolarapi.com/v1/euros/oficial
# EXCHANGE_RATE_TTL_HOURS=6

# ---- Dashboard maestro (solo se usa una vez, al correr `npm run seed:platform-admin`) ----
PLATFORM_ADMIN_NAME="Tu nombre"
PLATFORM_ADMIN_EMAIL="tu@correo.com"
PLATFORM_ADMIN_PASSWORD="CAMBIA_ESTA_CONTRASEÑA"
