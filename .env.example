# ---- Servidor ----
NODE_ENV=development
PORT=4000

# ---- Base de datos (PostgreSQL) ----
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://quicktap:quicktap@localhost:5432/quicktap?schema=public"

# ---- Auth ----
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# ---- CORS ----
# Orígenes permitidos separados por coma (frontend del panel + menú público)
CORS_ORIGINS="http://localhost:3000,https://quicktap.club"

# ---- Google OAuth ("Acceder con Google" en login/registro) ----
# GOOGLE_CLIENT_ID="xxxxxxxxxx.apps.googleusercontent.com"

# ---- Correo (restablecer contraseña) ----
# Se envía vía Resend (resend.com) con el dominio quicktap.club verificado.
# Si se deja vacía, el código se imprime en la consola en vez de enviarse
# (útil para probar en desarrollo sin credenciales reales).
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# MAIL_FROM_EMAIL="noreply@quicktap.club"
# MAIL_FROM_NAME="QuickTap.club"
