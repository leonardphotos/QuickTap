# Plantilla de Nginx para QuickTap en un VPS (Namecheap u otro).
# Copia a /etc/nginx/sites-available/quicktap, ajusta el dominio y las rutas,
# luego: ln -s /etc/nginx/sites-available/quicktap /etc/nginx/sites-enabled/
#
# Sirve el build estático del frontend (web/dist) y proxea /api, /uploads y
# /socket.io hacia el backend Node (PM2, puerto 4000) — el mismo esquema que
# usa el proxy de Vite en desarrollo (ver web/vite.config.ts).

server {
    listen 80;
    server_name tudominio.com www.tudominio.com;

    # Certbot reescribe este bloque a HTTPS automáticamente (--nginx).
    root /var/www/quicktap/web/dist;
    index index.html;

    client_max_body_size 10m;

    # API del backend
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Archivos subidos (fotos de producto, logos, comprobantes de pago)
    location /uploads/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
    }

    # Socket.IO: requiere upgrade a WebSocket
    location /socket.io/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Frontend: SPA de React Router, cualquier ruta que no matchee un archivo
    # cae en index.html para que el router del lado del cliente la resuelva.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
