# Plantilla de Nginx para QuickTap en un VPS (Namecheap u otro).
# Copia a /etc/nginx/sites-available/quicktap, ajusta el dominio y las rutas,
# luego: ln -s /etc/nginx/sites-available/quicktap /etc/nginx/sites-enabled/
#
# Sirve el build estático del frontend (web/dist) y proxea /api, /uploads y
# /socket.io hacia el backend Node (PM2, puerto 4000) — el mismo esquema que
# usa el proxy de Vite en desarrollo (ver web/vite.config.ts).

server {
    listen 80;
    server_name tudominio.com www.tudominio.com;

    # Certbot reescribe este bloque a HTTPS automáticamente (--nginx).
    root /var/www/quicktap/web/dist;
    index index.html;

    # Debe superar el mayor límite de subida del backend (15 MB, imagen de cartelera —
    # ver upload.middleware.ts): sin esto Nginx corta en 1 MB y ninguna foto real sube.
    client_max_body_size 25m;

    # Cabeceras de seguridad de todo lo que sirve Nginx directo (el HTML de la SPA y los
    # estáticos). /api y /uploads las traen de Helmet porque van proxied al backend. OJO: en
    # Nginx `add_header` NO se hereda dentro de un location que define sus propios add_header
    # — por eso se repiten en `location = /index.html` de abajo (si no, todo el HTML del panel
    # saldría sin X-Frame-Options y sería enmarcable / clickjacking).
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Compresión: sin listar los tipos, nginx por defecto solo comprime
    # text/html — los bundles JS/CSS (cientos de KB cada uno) viajarían sin
    # comprimir. gzip suele reducirlos ~65-75%.
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript application/wasm image/svg+xml font/woff2;

    # Los archivos de web/dist/assets llevan hash de contenido en el nombre
    # (Vite): si cambia el contenido, cambia el nombre. Por eso se pueden
    # cachear "para siempre" sin riesgo de servir una versión vieja.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # API del backend
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Archivos subidos (fotos de producto, logos, comprobantes de pago)
    location /uploads/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
    }

    # --- SEO ---
    # Estas rutas las sirve el backend, no el estático: Express toma el mismo
    # web/dist/index.html y le inyecta el título, la descripción y la imagen del
    # negocio antes de responder (ver src/modules/seo/seo.service.ts). Hace falta
    # porque los crawlers de WhatsApp/Facebook/Twitter no ejecutan JavaScript: sin
    # esto, compartir un menú por WhatsApp no genera ninguna vista previa.
    #
    # Van ANTES del "location /" de abajo. `^~` evita que otro location por regex
    # les gane la prioridad. Los bundles siguen colgando de /assets/, que sirve
    # Nginx igual que siempre, así que la página carga como antes.
    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /r/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /tienda/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /club/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Páginas SEO fijas por cluster de keywords: mismo mecanismo que /r/ — el
    # backend inyecta título/descripción de cada página en el shell. La lista de
    # rutas vive en src/modules/seo/static-pages.ts; si agregas una allá, agrégala acá.
    location ~ ^/(menu-digital-qr|autopedido-comandas|pedidos-whatsapp|software-delivery|menu-pantalla-tv|inventario-costos|precios|comparativa|para/[a-z0-9-]+)$ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Socket.IO: requiere upgrade a WebSocket
    location /socket.io/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # index.html NUNCA se cachea: es el único archivo que apunta a los bundles con hash, así
    # que un index viejo en caché seguiría cargando la versión anterior tras cada despliegue.
    # Repite las cabeceras de seguridad porque su add_header propio corta la herencia del server.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    # Frontend: SPA de React Router, cualquier ruta que no matchee un archivo
    # cae en index.html para que el router del lado del cliente la resuelva.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
