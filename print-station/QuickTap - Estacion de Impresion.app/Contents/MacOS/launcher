#!/bin/bash
# Estacion de Impresion QuickTap.
# Este script vive en QuickTap - Estacion de Impresion.app/Contents/MacOS/;
# index.html vive junto a él en Contents/Resources/ (la app es autocontenida,
# así funciona igual desde /Applications que desde el .dmg).
cd "$(dirname "$0")/../Resources"

PORT=5500
URL="http://localhost:$PORT"

# Arranca el servidor local solo si no hay uno ya corriendo en ese puerto
# (para no duplicarlo si ya estaba abierto desde antes).
if ! lsof -i "tcp:$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    if command -v python3 >/dev/null 2>&1; then
        nohup python3 -m http.server "$PORT" --bind 127.0.0.1 >/tmp/quicktap-print-station.log 2>&1 &
        disown
    elif command -v npx >/dev/null 2>&1; then
        nohup npx --yes serve -l "$PORT" . >/tmp/quicktap-print-station.log 2>&1 &
        disown
    else
        osascript -e 'display alert "QuickTap" message "No se encontró Python3 ni Node en esta Mac. Instala Python desde python.org (o Node desde nodejs.org) y vuelve a intentar." as critical'
        exit 1
    fi
    sleep 1
fi

# Abre en "modo app" (sin barra de direcciones) si hay Chrome o Edge instalado.
# --kiosk-printing hace que window.print() imprima directo en la impresora
# predeterminada del sistema, sin mostrar el dialogo de "Imprimir" — por eso
# hace falta un --user-data-dir aparte: con el perfil normal de Chrome, si ya
# hay una ventana abierta, el navegador ignora estos flags en la ventana nueva.
PROFILE_DIR="$HOME/Library/Application Support/QuickTapPrintStation"
if [ -d "/Applications/Google Chrome.app" ]; then
    open -na "Google Chrome" --args --app="$URL" --kiosk-printing --user-data-dir="$PROFILE_DIR"
elif [ -d "/Applications/Microsoft Edge.app" ]; then
    open -na "Microsoft Edge" --args --app="$URL" --kiosk-printing --user-data-dir="$PROFILE_DIR"
else
    open "$URL"
fi
