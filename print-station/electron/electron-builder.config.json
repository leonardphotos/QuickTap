{
  "appId": "club.quicktap.impresion",
  "productName": "QuickTap Impresion",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "preload.js",
    "appIcon.ico",
    "package.json",
    "fiscal/**"
  ],
  "asarUnpack": [
    "fiscal/**"
  ],
  "win": {
    "target": "nsis",
    "icon": "appIcon.ico",
    "artifactName": "QuickTap-Impresion-Setup.exe"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  }
}
