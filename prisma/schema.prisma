// ============================================================================
//  QuickTap.club — Esquema de base de datos (PostgreSQL + Prisma)
//  SaaS multi-inquilino para restaurantes.
//
//  Estrategia de aislamiento (multi-tenancy):
//  ------------------------------------------------------------------
//  Modelo "shared database, shared schema": TODAS las tablas de dominio
//  cuelgan de `restaurantId`. Cada consulta DEBE filtrarse por ese campo
//  (lo garantiza el `tenant.middleware` + los servicios). Los índices
//  compuestos `@@index([restaurantId, ...])` mantienen el rendimiento
//  aislado por inquilino.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
//  ENUMS
// ----------------------------------------------------------------------------

enum UserRole {
  OWNER // dueño del restaurante (acceso total)
  STAFF // deprecado: alias de acceso total, ya no se asigna desde la UI de Equipo
  ADMIN // Administrador (acceso total)
  CASHIER // Cajero (acceso total)
  WAITER // Mesero (solo Cocina + Órdenes de Mesa)
  KITCHEN // Cocina (solo Cocina + Órdenes de Mesa)
  SCREEN // Pantalla (vista horizontal de Mesas + Cocina, para un monitor/TV)
  COMANDA // Kiosco de autoservicio (tablet en modo tótem, el cliente pide sin mesero)
  NUMERO // Pantalla que solo muestra avisos de "listo" de Autoservicio/Pickup (mostrador)
  CANCHA // Tablet fija en una cancha (club deportivo): el jugador escanea su QR y pide desde ahí
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

enum MovementType {
  INCOME
  EXPENSE
}

// Tipo de un ingreso manual (botón "Añadir ingreso" en Ventas de hoy / Administración).
enum IncomeCategory {
  TIP // Propina
  DEBT // Cobro de una deuda pendiente del cliente
  OTHER // Otro ingreso
}

// Categoría de un egreso (módulo de Gastos en Administración).
enum ExpenseCategory {
  UTILITIES // Servicios públicos
  SUPPLIES // Compra de producto e insumos
  RENT // Arriendo
  PAYROLL // Nómina
  ADMINISTRATIVE // Gastos administrativos
  MARKETING // Mercadeo y Publicidad
  TRANSPORT // Transporte (fletes, encomiendas, taxis)
  MAINTENANCE // Mantenimiento
  FURNITURE // Muebles
  // --- Gastos de operación/viaje: se llevan igual que los de arriba, pero se separan
  // para que el reporte por categoría no los mezcle todos en "Transporte" u "Otros". ---
  FUEL // Combustible / gasolina
  TRAVEL // Viáticos y viajes
  MEALS // Comidas
  LODGING // Hospedaje / hotel
  OTHER // Otros
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

// Solicitud del comensal desde el menú público, mostrada como aviso en el
// plano de mesas hasta que el mesero la atiende.
enum ServiceRequestType {
  WAITER_CALL // "Llamar al mesonero"
  BILL_REQUEST // "Pedir la cuenta"
}

enum OrderStatus {
  NEEDS_CONFIRMATION // En mesa, esperando que el mesero acepte el pedido (solo si el restaurante lo exige)
  NEEDS_PAYMENT // Pedido de kiosco (rol Comanda): espera que caja confirme el cobro antes de ir a cocina
  PENDING // Pendiente (recién creada)
  KITCHEN // En Cocina (enviada a la ticketera)
  SERVED // Servido / Entregado
  CANCELLED // Cancelado
}

enum OrderChannel {
  DINE_IN // Canal en mesa (QR de la mesa)
  DELIVERY // Delivery a domicilio
  PICKUP // Retiro en local
  BAR // Pedido en barra, sin mesa (igual que Pickup pero sin retiro externo)
}

enum Currency {
  USD
  EUR
}

// Vertical de negocio del tenant. RESTAURANT es el producto original (mesas/comandas/cocina);
// SHOP es el vertical de retail (POS por SKU/variantes, inventario, sin mesas ni cocina);
// SPORTS_CLUB es el vertical de clubes deportivos (canchas reservables por franja horaria) —
// ver AdminLayout, que renderiza un panel completamente distinto según este campo.
enum BusinessType {
  RESTAURANT
  SHOP
  SPORTS_CLUB
}

enum PaymentMethod {
  MOBILE_PAYMENT // Pago Móvil
  ZELLE
  CASH // Efectivo Bs
  CASH_USD // Efectivo $
  CARD // Punto de venta / tarjeta
  BINANCE
  PAYPAL
  TRANSFER // Transferencia bancaria
}

// Cómo se calcula el costo de envío del checkout de delivery.
enum DeliveryPricingMode {
  DISABLED // Sin cobro de envío
  DISTANCE // Tarifa base + precio por Km, desde la ubicación del restaurante
  ZONE // Precio fijo según la zona (polígono) donde caiga la ubicación del cliente
}

// ----------------------------------------------------------------------------
//  SUSCRIPCIÓN A QUICKTAP (leads de la landing, no confundir con PaymentMethod
//  de arriba, que es el checkout del comensal en el menú público)
// ----------------------------------------------------------------------------

enum SubscriptionPlan {
  TRIAL // Prueba gratuita (15 días)
  STARTER // Plan Inicial
  PRO // Plan Pro / Restaurante
  PREMIUM // Plan Premium / Grandes Formatos
  DELIVERY // Plan Solo Delivery: Cocina + pedidos por WhatsApp, sin mesas/QR
  CUSTOM // Plan Personalizado (por sumatoria de mesas/usuarios/pedidos)
  SUCURSALES // [Legado, ya no se ofrece] Todos los beneficios de Pro + hasta 5 sucursales
  DELIVERY_SUCURSALES // [Legado, ya no se ofrece] Plan Solo Delivery + hasta 5 sucursales
  ELITE // Todos los beneficios de Pro + sucursales ilimitadas + soporte prioritario
  SHOP // Plan único de QuickTap Shop (businessType SHOP — Locales Comerciales)
  CLUB // Plan único de QuickTap Club (businessType SPORTS_CLUB — Canchas)
}

enum BillingCycle {
  MONTHLY
  QUARTERLY // 3 meses
  SEMIANNUAL // 6 meses
}

enum SubscriptionPaymentMethod {
  PAGO_MOVIL
  BINANCE
  BANK_TRANSFER
  // Pago vía pasarela Ramblay (C2P / Binance Pay): la aprobación llega sola
  // por webhook, no por revisión manual de comprobante (ver PlanRequest.ramblayPaymentId).
  RAMBLAY
}

// Estado persistido de la suscripción. El bloqueo (cuando vence `periodEnd` +
// 12h de gracia sin pago) se CALCULA en tiempo real (ver subscription.util.ts),
// nunca se persiste como un tercer estado: así, extender `periodEnd` siempre
// "desbloquea" automáticamente sin dejar banderas desincronizadas.
enum RestaurantSubscriptionStatus {
  TRIALING
  ACTIVE
}

// Comprobante de pago: de inscripción (antes de existir la cuenta, sin
// restaurantId todavía) o de mensualidad (ya autenticado, siempre con
// restaurantId). El admin de plataforma los revisa y "activa" la cuenta.
enum PlanRequestKind {
  SIGNUP
  RENEWAL
}

enum PlanRequestStatus {
  PENDING
  APPROVED
  REJECTED // El comprobante no es válido (ej. monto incorrecto, imagen falsa).
  PAYMENT_NOT_RECEIVED // Aún no se refleja el pago en la cuenta del restaurante.
}

// Duración del código de descuento, contada desde su creación.
enum PromoCodeDurationUnit {
  HOUR
  DAY
  MONTH
  YEAR
}

// Solicitud de cotización de QR físicos con tecnología NFC (impermeables, con
// protección UV). El restaurante ya está autenticado; no requiere comprobante
// de pago, solo se revisa y se contacta manualmente desde el Dashboard maestro.
enum QrNfcRequestStatus {
  PENDING
  APPROVED
}

// ----------------------------------------------------------------------------
//  TENANT: Restaurant + Users
// ----------------------------------------------------------------------------

model Restaurant {
  id   String @id @default(cuid())
  // Slug único para la URL pública: quicktap.club/:slug
  slug String @unique

  name        String
  description String?
  logoUrl     String?

  // --- Vertical de negocio (elegido al registrarse, no editable desde el panel) ---
  businessType    BusinessType @default(RESTAURANT)
  // Rubro de retail elegido en el registro (ej: "zapateria", "panaderia") cuando
  // businessType = SHOP. Indexa el catálogo de ejemplo en web/src/data/shopRubros.ts.
  // Null para restaurantes.
  shopRubro       String?
  // Costo de envío de la tienda virtual del local, en su moneda base. Tarifa plana y no
  // zonas/distancia como el delivery del restaurante: un local despacha con su propio
  // motorizado y cobra lo mismo a todo el mundo. 0 = envío sin cargo.
  shopDeliveryFee Decimal?     @db.Decimal(10, 2)

  // --- Configuración de moneda ---
  // Moneda en la que el restaurante coloca sus precios ($ o €).
  // Por defecto la conversión a Bs se resuelve con la tasa BCV vigente (tabla
  // ExchangeRate, global). Si el restaurante activa `exchangeRateManual`, se usa
  // en cambio `manualExchangeRateBs` (fijo hasta que el propio restaurante lo
  // vuelva a editar) — ver exchangeRateService.getRate().
  baseCurrency         Currency @default(USD)
  exchangeRateManual   Boolean  @default(false)
  manualExchangeRateBs Decimal? @db.Decimal(12, 4)

  // --- Contacto / checkout ---
  // Número de WhatsApp en formato internacional SIN "+" (ej: 584141234567).
  whatsappPhone                String?
  // Plantilla personalizable del mensaje de WhatsApp que el mesero/cajero le
  // envía al cliente con su comanda (botón "Enviar vía WhatsApp" en Pedidos).
  // Placeholders disponibles: {{header}}, {{items}}, {{totales}}. Si es null,
  // se usa DEFAULT_COMANDA_WHATSAPP_TEMPLATE (src/utils/whatsapp.ts).
  whatsappOrderMessageTemplate String?

  // --- Chatbot de WhatsApp (vinculado por QR, ver whatsapp-bot.service.ts) ---
  // Interruptor maestro: si está apagado, no se manda ningún mensaje automático
  // aunque la sesión siga vinculada (permite pausar sin desvincular el número).
  whatsappBotEnabled              Boolean @default(false)
  // Número vinculado tal como lo reporta la sesión de WhatsApp (solo informativo,
  // para mostrar "Conectado como +58..." en Ajustes) — no se usa para enviar.
  whatsappBotConnectedNumber      String?
  // Qué eventos del ciclo de vida del pedido disparan un mensaje automático.
  whatsappBotNotifyReceived       Boolean @default(true)
  whatsappBotNotifyReady          Boolean @default(true)
  // Respuesta automática con el saludo + enlace del menú a cada mensaje de texto que escribe un
  // cliente (sin enfriamiento: en hora pico el restaurante prefiere que conteste rápido, aunque
  // sea el mismo contacto escribiendo varias veces — ver handleIncomingMessage en whatsapp-bot.service.ts).
  whatsappBotWelcomeEnabled       Boolean @default(true)
  // Placeholders disponibles: {{restaurant}}, {{link}}. Si es null, se usa
  // DEFAULT_WELCOME_TEMPLATE (whatsapp-bot.service.ts).
  whatsappBotWelcomeMessage       String?
  // Número (solo dígitos) al que el chatbot reenvía cada comprobante de pago (modo
  // PAYMENT_VERIFICATION) o el pedido completo (modo FULL_ORDER) de un pedido
  // delivery/pickup para que el propio restaurante lo revise y responda
  // "Aprobado"/"Rechazado" — ver order-payment-verification.service.ts. null = ese
  // flujo está desactivado (el pedido sigue requiriendo aceptación manual, como hoy).
  whatsappBotPaymentVerifierPhone String?
  // 'PAYMENT_VERIFICATION' (de siempre) = solo abre verificación en métodos de pago que
  // exigen comprobante, esperando la FOTO del cliente. 'FULL_ORDER' = para cualquier
  // pedido sin importar el método de pago, manda el pedido completo al número de
  // whatsappBotPaymentVerifierPhone y espera que el negocio confirme "Aprobado" a mano
  // (sin foto) antes de pasar a cocina. Solo aplica si whatsappBotEnabled.
  whatsappOrderMode               String  @default("PAYMENT_VERIFICATION")

  // --- Apariencia del menú público ---
  // Colores personalizados del menú público (fondo, botones, acentos, texto).
  // JSON flexible para poder agregar nuevas claves sin nuevas migraciones.
  theme Json?

  // --- Cargos opcionales del checkout (aplican sobre el subtotal) ---
  // Interruptor del botón en Inventario: cuando está apagado, los modificadores
  // NO descuentan insumos aunque tengan el vínculo configurado. Permite dejar
  // la configuración armada y activarla cuando el inventario esté cuadrado.
  modifierInventoryLinkEnabled Boolean @default(false)

  // Interruptor de la clave de pantalla (Ajustes → Pantalla de bloqueo). Apagado,
  // nadie del equipo vuelve a ver el teclado de PIN y tampoco se le exige crearlo;
  // los PIN ya configurados se conservan para cuando se vuelva a activar.
  // Arranca en `true` porque el bloqueo ya existía antes de este interruptor.
  lockScreenEnabled    Boolean @default(true)
  serviceChargeEnabled Boolean @default(false) // 10% de servicio
  // 16% de IVA. Solo lo activa el equipo QuickTap desde el Master Dashboard (no autoservicio
  // del restaurante), y solo si ya tiene `rif` registrado — ver master-restaurants.service.ts.
  ivaEnabled           Boolean @default(false)
  // RIF fiscal del restaurante (lo escribe el restaurante en Ajustes). Distinto del `rif` que
  // vive dentro de paymentMethodsConfig, que es el RIF de una cuenta de cobro puntual.
  rif                  String?

  // Precio mensual acordado manualmente por el equipo QuickTap (ej. tarifa negociada al
  // habilitar sucursales fuera de la tabla de precios compartida) — ver Dashboard maestro →
  // Cobro. Cuando tiene valor, ES el precio que se le cobra al restaurante: manda sobre la
  // tarifa pública del plan (ver resolvePrice en plan-request.service.ts). El código
  // promocional se sigue aplicando encima, igual que sobre la tarifa pública.
  // El sufijo "Usd" quedó del nombre original: el monto se interpreta en la moneda vigente de
  // PlatformSettings.subscriptionCurrency, no siempre dólares — se dejó así para no acarrear
  // una migración de columna solo por el nombre.
  customMonthlyPriceUsd Decimal? @db.Decimal(10, 2)

  // Número de cobranza: a dónde el chatbot maestro manda el recordatorio de mensualidad y los
  // datos de pago (ver subscription-reminder.service.ts). Formato internacional sin "+". Es
  // aparte de `whatsappPhone` a propósito — ese es el número público de atención al comensal,
  // que muchas veces atiende un mesero; la cobranza va a quien realmente paga. Si está vacío se
  // cae a `whatsappPhone`, que era el destino único antes de que existiera este campo.
  billingPhone String?

  // --- Migración desde OlaClick (herramienta interna, panel master) ---
  // La API Key de OlaClick del restaurante viaja cifrada (AES-256-GCM, ver
  // master-olaclick-import.crypto.ts) y solo la usa el equipo QuickTap desde
  // /master/*, NUNCA expuesta al propio restaurante ni a rutas públicas.
  // Ver src/modules/master/master-olaclick-import.* y CLAUDE.md.
  olaclickApiKeyEncrypted String?
  olaclickLastSyncAt      DateTime?
  olaclickLastSyncSummary Json?

  // --- Control de pedidos ---
  // Si es false, el menú público queda solo para ver: sin carrito ni checkout
  // (ni en mesa ni por delivery/pickup).
  orderingEnabled          Boolean @default(true)
  // Si es true, los pedidos que el cliente envía desde la mesa (QR) quedan en
  // NEEDS_CONFIRMATION hasta que un mesero los acepte; recién ahí pasan a la
  // cocina. No aplica a pedidos cargados manualmente por el staff.
  requireOrderConfirmation Boolean @default(false)

  // --- Precio de delivery ---
  // Ubicación del local, usada como origen para calcular distancia al cliente.
  deliveryOriginLat   Float?
  deliveryOriginLng   Float?
  deliveryPricingMode DeliveryPricingMode @default(DISABLED)
  // Modo DISTANCE: tarifa fija + precio por Km recorrido.
  deliveryBaseFee     Decimal             @default(0) @db.Decimal(12, 2)
  deliveryPricePerKm  Decimal             @default(0) @db.Decimal(12, 2)

  // --- Despacho automático al cobrar (Ajustes → Delivery) ---
  // Al terminar de cobrar un pedido DELIVERY, abrir solo la ventana de
  // "Equipo de delivery" para que el cajero elija repartidor sin buscar el
  // pedido en la lista. No despacha nada por su cuenta.
  deliveryAutoOpenOnPaid     Boolean @default(false)
  // Un paso más: elige el repartidor automáticamente (rotación por quien
  // lleva más tiempo sin recibir un pedido) y arma su WhatsApp, sin
  // preguntar. Tiene prioridad sobre deliveryAutoOpenOnPaid.
  deliveryAutoAssignOnPaid   Boolean @default(false)
  // Independiente de los dos de arriba: elige el repartidor automáticamente
  // (misma rotación por quien lleva más tiempo sin recibir un pedido) apenas
  // se ACEPTA un pedido DELIVERY, sin esperar a que se cobre. Si el pedido
  // ya tiene repartidor asignado (por este mismo interruptor) el auto-asignado
  // al cobrar no lo vuelve a despachar (ver autoDispatchToCourier).
  deliveryAutoAssignOnAccept Boolean @default(false)

  // Métodos de pago que el restaurante ofrece a SUS clientes en el checkout
  // (distinto de PlatformSettings, que es cómo el restaurante le paga a
  // QuickTap). JSON libre: { CASH: { enabled }, MOBILE_PAYMENT: { enabled,
  // banco, telefono, cedula, titular }, ZELLE: {...}, BINANCE: {...},
  // PAYPAL: {...}, TRANSFER: {...}, CARD: { enabled } }.
  paymentMethodsConfig Json?

  // --- Modo Cartelera: imagen de pantalla completa en vez del menú ---
  fullscreenImageEnabled Boolean @default(false)
  fullscreenImageUrl     String?

  // --- Ajustes -> Pantalla: qué muestra el carrusel del rol SCREEN (ver ScreenPage.tsx) ---
  // "ALL" = todo el catálogo disponible; "CATEGORIES" = solo las categorías en
  // screenCategoryIds; "PRODUCTS" = solo los productos puntuales en screenProductIds.
  screenDisplayMode     String @default("ALL")
  // Arrays de ids como Json (mismo criterio que theme/paymentMethodsConfig en este modelo,
  // no hay precedente de String[] nativo acá) — solo se leen cuando screenDisplayMode los usa.
  screenCategoryIds     Json?
  screenProductIds      Json?
  // Segundos que cada pantalla queda fija antes de rotar a la siguiente. Opciones fijas en la UI: 3/6/10/20.
  screenPageIntervalSec Int    @default(8)
  // Productos por pantalla. Opciones fijas en la UI: 2/4/6.
  screenItemsPerPage    Int    @default(4)

  // Código de 6 dígitos (hasheado, igual que TableSession.pinHash) que el Mesero
  // debe ingresar para eliminar una comanda. Solo lo crea/cambia Dueño/Admin desde
  // Ajustes. Null = todavía no se ha configurado (el Mesero no puede eliminar).
  deleteOrderPinHash String?

  // --- Pantalla de bloqueo ---
  // Minutos de inactividad antes de re-solicitar el PIN, por rol (ej:
  // { "OWNER": 5, "CASHIER": 1, "WAITER": 10 }). Solo Dueño/Admin lo editan
  // desde Ajustes. Un rol sin entrada acá usa DEFAULT_LOCK_SCREEN_MINUTES.
  // La función está siempre activa (no hay forma de desactivarla) — este
  // mapa solo controla la frecuencia, nunca si se pide o no.
  lockScreenIntervals Json @default("{}")

  // --- Suscripción QuickTap ---
  // Arranca en TRIALING con periodEnd = registro + 15 días. Al aprobar un
  // PlanRequest (o activación manual desde el Dashboard maestro) pasa a
  // ACTIVE y periodEnd se extiende según el ciclo. El bloqueo por vencimiento
  // no se persiste: se calcula a partir de periodEnd (ver subscription.util.ts).
  subscriptionStatus RestaurantSubscriptionStatus @default(TRIALING)
  subscriptionPlan   SubscriptionPlan?
  billingCycle       BillingCycle?
  periodEnd          DateTime

  // Plan que acaba de activarse (primera vez o cambio de plan) y todavía no
  // se le mostró al restaurante la pantalla de bienvenida ("Bienvenido al
  // Club"). Se limpia (null) apenas el frontend confirma haberla mostrado.
  // No se toca en una renovación del MISMO plan (ver applyActivation()).
  pendingWelcomePlan SubscriptionPlan?

  // Marca el `periodEnd` para el que ya se mandó el recordatorio de renovación por WhatsApp
  // (ver master-whatsapp/subscription-reminder.service.ts) — evita reenviarlo en cada barrido
  // mientras siga siendo el mismo vencimiento; se vuelve a disparar solo cuando `periodEnd`
  // avanza (renovación) y vuelve a caer a 3 días o menos.
  subscriptionReminderForPeriodEnd DateTime?

  // Botón "Avisar sistema listo" del Dashboard maestro (ver master-restaurants.service.ts):
  // cuándo se le mandó por WhatsApp el aviso de instalación completa + credenciales del equipo +
  // monto a cancelar. Null = todavía no se le avisó. Solo informativo (se puede reenviar).
  installationNoticeSentAt DateTime?

  subscriptionPaymentVerifications SubscriptionPaymentVerification[]

  // --- Sucursales (Plan Sucursales / Delivery Sucursales, tope de 5) ---
  // Una sucursal es otra fila de Restaurant (reutiliza TODO el modelo tal
  // cual: catálogo, inventario, pedidos, equipo, mesas propias) enlazada a
  // su sede principal solo para el reporte consolidado y para heredar
  // plan/vigencia — no paga ni se bloquea de forma independiente (ver
  // isLockedAsync() en src/utils/subscription.ts y applyActivation()).
  parentRestaurantId String?
  parent             Restaurant?  @relation("RestaurantBranches", fields: [parentRestaurantId], references: [id])
  branches           Restaurant[] @relation("RestaurantBranches")

  // Grupo (sede principal + sucursales): "PER_BRANCH" = cada sede su propio stock (de
  // siempre); "SHARED" = una sola bolsa de stock para todas. Solo se cambia desde la
  // sede principal (ver restaurant.service.ts update()).
  inventoryMode     String  @default("PER_BRANCH")
  // Activa la ventana "Casa Matriz" (segundo inventario, aparte del normal, para
  // distribuir a la sede principal y a las sucursales). Solo aplica en la sede
  // principal — no todos los clientes de Sucursales tienen una.
  casaMatrizEnabled Boolean @default(false)

  // --- Adicionales del Plan Personalizado (CUSTOM) ---
  // Para PRO/PREMIUM el acceso a estas funciones ya viene incluido según el
  // plan (ver src/utils/subscription.ts, hasFeature()); estos 4 campos solo
  // importan cuando subscriptionPlan = CUSTOM, marcados al aprobar la
  // solicitud con esos adicionales elegidos.
  customAdministration  Boolean @default(false)
  customInventoryBasic  Boolean @default(false)
  customInventoryRecipe Boolean @default(false)
  customAccountsPayable Boolean @default(false)
  // Bloqueo manual desde el Dashboard maestro, independiente del vencimiento
  // del plan. Si es true, la cuenta queda bloqueada sin importar periodEnd.
  suspended             Boolean @default(false)

  // Cuenta de demostración (sembrada con `npm run seed:demo`): sus pedidos y
  // su facturación se excluyen del reporte financiero del Dashboard maestro.
  isDemo             Boolean   @default(false)
  // Última actividad (request autenticado) de un usuario en la cuenta demo —
  // solo se actualiza cuando isDemo=true. El barrido periódico (ver server.ts)
  // resetea el demo cuando esto queda viejo (pestaña cerrada/abandonada).
  demoLastActivityAt DateTime?
  // Se activa cuando alguien ingresa el código de administrador correcto
  // (Ajustes → Modo administrador). Mientras esté en true, el restaurante
  // demo queda exento del reset automático (ni el barrido de inactividad ni
  // el logout lo reinician) — así el equipo QuickTap puede dejar cambios
  // permanentes (ej. configurar sucursales) sin que se borren.
  demoAdminUnlocked  Boolean   @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  categories             Category[]
  kitchens               Kitchen[]
  products               Product[]
  tables                 Table[]
  orders                 Order[]
  zones                  Zone[]
  tableSessions          TableSession[]
  planRequests           PlanRequest[]
  qrNfcRequests          QrNfcRequest[]
  inventoryItems         InventoryItem[]
  inventoryCategories    InventoryCategory[]
  recipeIngredients      RecipeIngredient[]
  preparations           Preparation[]
  preparationIngredients PreparationIngredient[]
  deliveryCouriers       DeliveryCourier[]
  additionalCharges      AdditionalCharge[]
  quotes                 Quote[]
  deliveryZones          DeliveryZone[]
  movements              Movement[]
  cashSessions           CashSession[]
  suppliers              Supplier[]
  customers              Customer[]
  modifierCategories     ModifierCategory[]
  modifiers              Modifier[]
  productVariants        ProductVariant[]
  schedules              RestaurantSchedule[]
  reservations           Reservation[]
  fiscalInvoicingConfig  FiscalInvoicingConfig?

  // --- QuickTap Shop (businessType = SHOP): catálogo/ventas/caja propios, sin relación con
  // Product/Order (esos son del vertical restaurante) — ver web/src/pages/admin/shop/. ---
  shopProducts         ShopProduct[]
  shopSales            ShopSale[]
  shopPurchases        ShopPurchase[]
  shopStockAdjustments ShopStockAdjustment[]
  shopCashSessions     ShopCashSession[]
  shopCategories       ShopCategory[]
  shopSubcategories    ShopSubcategory[]
  shopServiceSupplies  ShopServiceSupply[]
  // Pedidos que entran por el catálogo público de la tienda virtual (ver ShopOrder).
  shopOrders           ShopOrder[]

  // --- QuickTap Club (businessType = SPORTS_CLUB): canchas y reservas por franja
  // horaria, sin relación con Table/Order — ver web/src/pages/admin/club/. ---
  clubCourts    ClubCourt[]
  clubSchedules ClubSchedule[]
  clubBlocks    ClubCourtBlock[]
  clubBookings  ClubBooking[]
  clubTabOrders ClubTabOrder[]   @relation("ClubTabOrderClub")

  // --- Vínculo club ↔ restaurante: el club terceriza la cocina/barra en un
  // restaurante de QuickTap, que recibe las comandas de las canchas. Los dos
  // lados son un Restaurant, de ahí los nombres explícitos de relación. ---
  clubLinkCodes          ClubLinkCode[]       @relation("ClubLinkCodeRestaurant")
  clubLinkAsClub         ClubRestaurantLink?  @relation("ClubRestaurantLinkClub")
  clubLinksAsKitchen     ClubRestaurantLink[] @relation("ClubRestaurantLinkRestaurant")
  clubTabOrdersToPrepare ClubTabOrder[]       @relation("ClubTabOrderKitchen")
  clubTournaments        ClubTournament[]

  @@index([parentRestaurantId])
  @@map("restaurants")
}

// Horario de apertura/cierre por día de la semana (Ajustes → Horario). Si un
// restaurante no tiene filas aquí, se considera siempre abierto (por defecto,
// retrocompatible con restaurantes ya existentes). dayOfWeek sigue la misma
// convención que Date#getDay(): 0=Domingo, 1=Lunes, ..., 6=Sábado.
model RestaurantSchedule {
  id           String  @id @default(cuid())
  restaurantId String
  dayOfWeek    Int
  isClosed     Boolean @default(false)
  // Hora local del restaurante (America/Caracas), formato "HH:mm". Null si isClosed.
  openTime     String?
  closeTime    String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@map("restaurant_schedules")
}

// ----------------------------------------------------------------------------
//  TASA DE CAMBIO (global, NO por inquilino)
// ----------------------------------------------------------------------------

// Tasa oficial del Banco Central de Venezuela (BCV). Una sola fila vigente
// por moneda, refrescada periódicamente por el ExchangeRateService. Todos
// los restaurantes que facturan en esa moneda comparten la misma tasa.
model ExchangeRate {
  id       String   @id @default(cuid())
  currency Currency @unique

  rateBs Decimal @db.Decimal(18, 4)
  // Fuente del dato (por defecto "BCV"). Útil si en el futuro se agrega otra fuente.
  source String  @default("BCV")

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exchange_rates")
}

model User {
  id           String @id @default(cuid())
  restaurantId String

  email        String
  // Null = cuenta creada solo con "Continuar con Google" (ver googleId), sin contraseña propia.
  passwordHash String?
  name         String
  role         UserRole @default(OWNER)

  // Id de cuenta de Google (claim "sub" del ID token), si esta cuenta se creó o se
  // vinculó con "Continuar con Google". Null = nunca se usó Google en esta cuenta.
  googleId String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Restablecer contraseña por código enviado al correo ---
  resetCodeHash      String?
  resetCodeExpiresAt DateTime?
  resetCodeAttempts  Int       @default(0)

  // Tablet de cancha (rol CANCHA): a qué cancha está atornillada. El QR que se
  // escane en ella tiene que ser de una reserva DE ESA cancha — ver club-tablet.
  // Null en cualquier otro rol.
  clubCourtId String?

  // Acceso a Inventario para roles restringidos (Mesero/Cocina), otorgado
  // individualmente desde Ajustes → Equipo. Los roles de acceso total
  // (OWNER/ADMIN/CASHIER/STAFF) siempre pueden entrar, sin importar esto.
  canAccessInventory Boolean @default(false)

  // Cajero por defecto ahora tiene los mismos permisos que Mesero (más abrir/cerrar caja y ver
  // movimientos del día por método de pago) — este flag, otorgado individualmente desde Ajustes
  // → Equipo, le devuelve el acceso completo de antes (Administración, Productos, Mesas, etc.).
  // No aplica a otros roles.
  cashierFullAccess Boolean @default(false)

  // PIN de 4 dígitos (hasheado) de la Pantalla de bloqueo — personal, cada usuario
  // configura el suyo la primera vez que entra al panel (obligatorio, no se puede
  // omitir). Null = todavía no lo configuró; se le exige antes de poder usar el panel.
  lockPinHash String?

  // --- Personal que presta servicios (barberos, estilistas, manicuristas...) ---
  // Local Comercial: este usuario aparece en el selector "Atendido por" del POS y sus
  // servicios se le acreditan para el reporte por profesional.
  isServiceProvider    Boolean @default(false)
  // % que se lleva de lo que factura (ej. 50 = mitad para él, mitad para el local). Null = 0.
  commissionPercent    Float?
  // Sus PROPIOS datos de cobro (mismo formato que Restaurant.paymentMethodsConfig): en una
  // barbería el cliente le paga directo al barbero a su Pago Móvil/Zelle, aunque la venta se
  // registre igual en el local. Null = se cobra con los datos del local.
  paymentMethodsConfig Json?

  restaurant         Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  clubCourt          ClubCourt?    @relation("UserClubCourt", fields: [clubCourtId], references: [id], onDelete: SetNull)
  placedOrders       Order[]       @relation("OrderPlacedBy")
  acceptedOrders     Order[]       @relation("OrderAcceptedBy")
  assignedTables     Table[]       @relation("TableAssignedWaiter")
  movements          Movement[]
  cashSessionsOpened CashSession[] @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[] @relation("CashSessionClosedBy")

  // El email es único DENTRO de cada restaurante (no globalmente); mismo criterio
  // para googleId (una cuenta de Google puede ser dueña de un restaurante y también
  // staff invitado en otro).
  @@unique([restaurantId, email])
  @@unique([restaurantId, googleId])
  @@index([restaurantId])
  @@map("users")
}

// ----------------------------------------------------------------------------
//  CATÁLOGO: Categories + Products
// ----------------------------------------------------------------------------

model Category {
  id           String @id @default(cuid())
  restaurantId String

  name     String
  // Prioridad de orden (menor = aparece primero en el menú).
  priority Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Origen externo (ej: importada desde OlaClick vía el módulo de migración
  // del panel master — ver src/modules/master/master-olaclick-import.*).
  // Null en categorías creadas normalmente a mano. externalSourceId es el id
  // original en el sistema de origen, usado para no duplicar en re-sync.
  externalSource   String?
  externalSourceId String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([restaurantId, externalSource, externalSourceId])
  @@index([restaurantId, priority])
  @@map("categories")
}

// Estación de cocina (ej: "Cocina Caliente", "Repostería", "Bar") a la que se
// asigna un producto, para que la comanda se divida por estación al momento
// de cocinar. Máximo 10 por restaurante (validado en el service).
model Kitchen {
  id           String @id @default(cuid())
  restaurantId String

  name     String
  priority Int    @default(0)

  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@index([restaurantId, priority])
  @@map("kitchens")
}

model Product {
  id           String  @id @default(cuid())
  restaurantId String
  categoryId   String
  // Estación de cocina donde se prepara (opcional). Null = sin asignar.
  kitchenId    String?

  name            String
  description     String?
  // Precio en la moneda base del restaurante (restaurant.baseCurrency: USD o EUR).
  price           Decimal @db.Decimal(12, 2)
  photoUrl        String?
  // Tiempo aproximado de preparación, en minutos (informativo, opcional).
  prepTimeMinutes Int?

  // Costo del producto para calcular el margen de utilidad (Administración → Margen de utilidad).
  // "RECIPE" = se toma en vivo la suma de RecipeIngredient.costBase (requiere receta armada,
  // solo plan Premium); "MANUAL" = se usa costBase, cargado a mano junto al precio.
  costSource String   @default("MANUAL")
  costBase   Decimal? @db.Decimal(12, 2)

  // Cascada de precio sugerido (Inventario → Recetas → "Precio sugerido"), solo tiene efecto
  // si costSource = RECIPE. recipeBufferPercent = resguardo por fallas al emplatar sobre el
  // costo de materia prima; recipeTargetFoodCostPercent = food cost objetivo con el que se
  // sugiere un precio (costoConResguardo * 100 / este %). Ver recipe.service.ts#getCascade.
  recipeBufferPercent         Decimal @default(10) @db.Decimal(5, 2)
  recipeTargetFoodCostPercent Decimal @default(40) @db.Decimal(5, 2)

  // Disponibilidad para la venta.
  isAvailable Boolean @default(true)

  // Código interno opcional (back-office). Nunca se expone en el menú público.
  sku String?

  // Control de stock simple por producto (independiente del sistema de insumos/receta).
  // stockQuantity null = sin control de stock; en 0 el producto se muestra agotado en el menú público.
  stockControlEnabled Boolean @default(false)
  stockQuantity       Int?
  // A partir de cuántas unidades avisar "por agotarse" (Inventario → Alertas).
  // Null/0 = solo avisa cuando llega a 0. Equivale a InventoryItem.minQuantity.
  stockMinQuantity    Int?
  // Fecha de caducidad, "YYYY-MM-DD" en hora de Caracas — ver InventoryItem.expiryDate.
  expiryDate          String?

  // --- Envase (envase/caja/bolsa) ---
  // Cargo que se suma al total del pedido SOLO cuando el canal es DELIVERY o PICKUP
  // (nunca DINE_IN/BAR — en mesa se sirve sin empaque). "NONE" = no cobra envase;
  // "FIXED" = precio propio (packagingFeeBase); "INVENTORY" = precio y descuento de
  // stock tomados del insumo vinculado (packagingItem, ver InventoryItem.packagingType).
  packagingMode    String   @default("NONE")
  packagingFeeBase Decimal? @db.Decimal(12, 2)
  packagingItemId  String?

  // --- Banderas de marketing ---
  isStar         Boolean @default(false) // Producto Estrella
  isPromo        Boolean @default(false) // Promoción
  isHouseSpecial Boolean @default(false) // Recomendación de la Casa

  // --- Promoción por tiempo: precio especial que solo aplica dentro de una ventana ---
  // (hora del día, días de la semana y/o rango de fechas — las tres condiciones son
  // opcionales e independientes, y TODAS las que estén configuradas deben cumplirse a
  // la vez). Se evalúa en vivo (hora de Caracas) tanto en el menú público como al
  // cobrar (ver src/utils/promo-price.ts) — nunca se persiste si está "activa ahora".
  // Solo aplica a productos de precio simple (pricingMode = SIMPLE), no a variantes.
  promoPriceEnabled Boolean   @default(false)
  promoPrice        Decimal?  @db.Decimal(12, 2)
  // "HH:mm" 24h, hora de Caracas. Null en cualquiera de los dos = sin restricción de hora.
  // Si promoEndTime < promoStartTime se interpreta como un rango que cruza la medianoche.
  promoStartTime    String?
  promoEndTime      String?
  // 0=domingo..6=sábado (igual que Date#getDay()). Vacío = todos los días.
  promoDaysOfWeek   Int[]     @default([])
  // Rango de fechas (inclusive, medianoche a medianoche hora de Caracas). Null = sin límite.
  promoStartDate    DateTime?
  promoEndDate      DateTime?

  // Orden dentro de su categoría.
  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cómo se cobra: "SIMPLE" = un solo precio (el campo `price` de arriba);
  // "VARIANTS" = el cliente elige entre las filas de `variants`, cada una con
  // su propio precio (ej. "Ensalada César" / "Ensalada Mixta").
  pricingMode String @default("SIMPLE")

  // Origen externo (ver Category.externalSource más arriba). importedImageUrl
  // guarda la foto tal cual venía del sistema de origen como referencia — el
  // campo real usado por la app sigue siendo `photoUrl`, que queda null hasta
  // que alguien la confirme/reemplace (ver master-olaclick-import.service.ts).
  externalSource   String?
  externalSourceId String?
  importedImageUrl String?

  restaurant         Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category           Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  kitchen            Kitchen?                  @relation(fields: [kitchenId], references: [id], onDelete: SetNull)
  // Insumo vinculado como envase (packagingMode = INVENTORY). SetNull: si se borra el
  // insumo, el producto no se rompe, solo deja de cobrar/descontar envase.
  packagingItem      InventoryItem?            @relation("ProductPackaging", fields: [packagingItemId], references: [id], onDelete: SetNull)
  orderItems         OrderItem[]
  recipeIngredients  RecipeIngredient[]
  modifierCategories ProductModifierCategory[]
  variants           ProductVariant[]

  @@unique([restaurantId, externalSource, externalSourceId])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, packagingItemId])
  @@index([restaurantId, isAvailable])
  @@index([restaurantId, kitchenId])
  @@map("products")
}

// ----------------------------------------------------------------------------
//  MODIFICADORES: categorías reutilizables entre productos (ej. "Extra",
//  "Elige el término de la carne"), cada una con sus propias opciones.
// ----------------------------------------------------------------------------

model ModifierCategory {
  id           String @id @default(cuid())
  restaurantId String

  name String

  // Obligatorio = el cliente debe elegir algo de esta categoría antes de agregar al carrito.
  isRequired    Boolean @default(false)
  // false = el cliente elige un solo modificador (radio); true = puede elegir varios (checkboxes).
  allowMultiple Boolean @default(false)
  // Límite de selecciones totales cuando allowMultiple=true (permite repetir la misma opción,
  // ej. "Ketchup x4"). null = sin límite. Un producto puntual puede sobreescribirlo, ver
  // ProductModifierCategory.maxSelectionsOverride.
  maxSelections Int?
  // Mínimo de selecciones totales cuando allowMultiple=true. null = usa el default (1 si
  // isRequired, 0 si no).
  minSelections Int?

  // Orden al mostrarse dentro de un producto.
  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  modifiers  Modifier[]
  products   ProductModifierCategory[]

  @@index([restaurantId])
  @@map("modifier_categories")
}

model Modifier {
  id           String @id @default(cuid())
  restaurantId String
  categoryId   String

  name         String
  // Precio adicional al elegir este modificador, en la moneda base del restaurante.
  priceBase    Decimal  @default(0) @db.Decimal(12, 2)
  // Costo (para margen de utilidad) y descuento, igual que en Producto — opcionales.
  costBase     Decimal? @db.Decimal(12, 2)
  discountBase Decimal? @db.Decimal(12, 2)
  // Visible/oculto en el menú público (el ícono de ojo de la referencia).
  isAvailable  Boolean  @default(true)
  // Tope de repetición de este modificador puntual (ej. "Ketchup máx. 2"), independiente del
  // límite de la categoría. null = sin tope propio (solo limita el máximo de la categoría).
  maxQuantity  Int?
  // Código interno opcional (back-office). Nunca se expone en el menú público.
  sku          String?

  // Vínculo con inventario: si este modificador consume un insumo, al vender se
  // descuenta solo. `inventoryQuantity` va SIEMPRE en la unidad base del insumo
  // (kg/lt/unidad) — el formulario deja cargarlo en gr/ml y lo convierte antes
  // de guardar, igual que hace RecipeIngredient.
  inventoryItemId   String?
  inventoryQuantity Decimal? @db.Decimal(12, 4)

  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant    Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category      ModifierCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // SetNull: si se borra el insumo, el modificador sigue vivo (solo deja de
  // descontar) — borrar un insumo no puede tumbar el menú.
  inventoryItem InventoryItem?         @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  variantPrices ModifierVariantPrice[]

  @@index([restaurantId, categoryId])
  @@index([inventoryItemId])
  @@map("modifiers")
}

// Precio propio de un modificador para UNA variante puntual de un producto (ej. "Extra queso"
// cuesta distinto en "Pizza Grande" que en "Pizza Pequeña"). Sin fila acá = el modificador usa
// su Modifier.priceBase de siempre, sin importar la variante elegida — esto es solo el override.
model ModifierVariantPrice {
  id         String  @id @default(cuid())
  modifierId String
  variantId  String
  priceBase  Decimal @db.Decimal(12, 2)

  modifier Modifier       @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([modifierId, variantId])
  @@index([variantId])
  @@map("modifier_variant_prices")
}

// Asocia una categoría de modificadores reutilizable a un producto puntual ("Asociar/Desasociar").
model ProductModifierCategory {
  id                    String @id @default(cuid())
  productId             String
  modifierCategoryId    String
  priority              Int    @default(0)
  // Sobreescribe ModifierCategory.maxSelections solo para este producto. null = usa el de la categoría.
  maxSelectionsOverride Int?

  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierCategory ModifierCategory @relation(fields: [modifierCategoryId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierCategoryId])
  @@map("product_modifier_categories")
}

// ----------------------------------------------------------------------------
//  VARIANTES: cuando un producto se cobra como "Variantes" en vez de precio
//  simple (ej. "Ensaladas" con "César"/"Mixta"/"Pico de Gallo", cada una con
//  su propio precio). El cliente elige exactamente una al pedir.
// ----------------------------------------------------------------------------

model ProductVariant {
  id           String @id @default(cuid())
  restaurantId String
  productId    String

  name             String
  priceBase        Decimal  @db.Decimal(12, 2)
  // Cargo adicional de empaque para esta variante (delivery/pickup), opcional.
  packagingFeeBase Decimal? @db.Decimal(12, 2)
  costBase         Decimal? @db.Decimal(12, 2)
  discountBase     Decimal? @db.Decimal(12, 2)
  isAvailable      Boolean  @default(true)

  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Id de la variante en el sistema de origen (ver Product.externalSource). Sirve
  // para re-sincronizar sin duplicar: una variante creada a mano lo deja en null,
  // y por eso la importación nunca la borra.
  externalSourceId String?

  restaurant     Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product        Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierPrices ModifierVariantPrice[]

  @@unique([productId, externalSourceId])
  @@index([restaurantId, productId])
  @@map("product_variants")
}

// ----------------------------------------------------------------------------
//  ZONAS + MESAS
// ----------------------------------------------------------------------------

// Zona del salón (ej: "Terraza", "Salón principal"). Agrupa mesas para el
// plano de Órdenes de Mesa.
model Zone {
  id           String @id @default(cuid())
  restaurantId String

  name     String
  // Prioridad de orden (menor = aparece primero).
  priority Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables     Table[]

  @@index([restaurantId, priority])
  @@map("zones")
}

model Table {
  id           String  @id @default(cuid())
  restaurantId String
  zoneId       String?

  // Número/identificador visible de la mesa (ej: "5", "Terraza-2").
  number  String
  // Token opaco embebido en el QR. Se usa en la URL pública del QR
  // para resolver la mesa sin exponer IDs internos.
  qrToken String @unique

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Solicitud pendiente del comensal (llamar al mesonero / pedir la cuenta),
  // disparada desde el menú público y atendida desde el plano de mesas.
  serviceRequest   ServiceRequestType?
  serviceRequestAt DateTime?

  // Mesero al que le pertenece esta mesa: asignado a mano desde Equipo, o
  // automático (el primer mesero que acepta un pedido de una mesa sin
  // asignar se la queda). Mientras esté asignada, los pedidos de esta mesa
  // solo le aparecen a él en el Dashboard — el resto de los roles sigue
  // viendo todos los pedidos sin importar esto.
  assignedWaiterId String?

  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  zone           Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  assignedWaiter User?          @relation("TableAssignedWaiter", fields: [assignedWaiterId], references: [id], onDelete: SetNull)
  orders         Order[]
  sessions       TableSession[]
  reservations   Reservation[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@index([zoneId])
  @@index([assignedWaiterId])
  @@map("tables")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// Reserva de mesa hecha por el cliente desde el botón "Mesa" del menú
// público. Queda PENDING hasta que Cajero/Administrador la acepte o la
// cancele desde la pestaña "Reservas" del panel.
model Reservation {
  id               String            @id @default(cuid())
  restaurantId     String
  // Fecha de la reserva (medianoche del día elegido, hora America/Caracas).
  date             DateTime
  // Hora elegida, formato "HH:mm".
  time             String
  partySize        Int
  customerName     String
  customerIdNumber String
  customerPhone    String
  status           ReservationStatus @default(PENDING)
  createdAt        DateTime          @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables     Table[]

  @@index([restaurantId, date])
  @@map("reservations")
}

// ----------------------------------------------------------------------------
//  CUENTA DE MESA (TableSession)
// ----------------------------------------------------------------------------

// Representa la "cuenta abierta" de una mesa: desde el primer pedido hasta que
// el restaurante la cierra desde el dashboard, todos los pedidos DINE_IN de
// esa mesa se acumulan en la misma sesión (Pedido #1, #2, #3...).
model TableSession {
  id           String @id @default(cuid())
  restaurantId String
  tableId      String

  // Capturados una sola vez, al abrir la cuenta (primer pedido de la mesa).
  // El teléfono es obligatorio a nivel de aplicación (order.service.ts) desde
  // que se agregó el botón "Enviar vía WhatsApp" en Pedidos; queda nullable
  // en la BD para no romper cuentas abiertas antes de este cambio.
  customerName     String
  customerIdNumber String
  customerPhone    String?

  // Clave opcional de 4 dígitos para que nadie más pueda pedir en esta mesa
  // sin autorización. Se decide justo después del primer pedido; vive solo
  // mientras la cuenta esté abierta (se resetea al cerrar/rodar la mesa).
  pinHash    String?
  pinSkipped Boolean @default(false)

  // Nombre de la cuenta cuando una mesa tiene varias abiertas a la vez (ej. "Cuenta 1").
  // Null = mesa de una sola cuenta (comportamiento de siempre).
  label String?

  status TableSessionStatus @default(OPEN)

  openedAt DateTime  @default(now())
  closedAt DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([restaurantId, tableId, status])
  @@map("table_sessions")
}

// ----------------------------------------------------------------------------
//  COMANDAS: Orders + OrderItems
// ----------------------------------------------------------------------------

model Order {
  id           String @id @default(cuid())
  restaurantId String

  // Número correlativo legible por inquilino (ej: #1023). Se asigna en el service.
  orderNumber Int

  channel OrderChannel
  status  OrderStatus  @default(PENDING)

  // Mesa asociada (solo canal DINE_IN).
  tableId        String?
  // Cuenta de mesa a la que pertenece este pedido (solo canal DINE_IN).
  tableSessionId String?

  // --- Snapshot de totales (se congelan al crear la orden) ---
  // Moneda en la que el restaurante facturó este pedido (USD o EUR).
  currency          Currency
  subtotalBase      Decimal  @db.Decimal(12, 2)
  // Cargos opcionales congelados al momento del pedido (0 si estaban apagados).
  serviceChargeBase Decimal  @default(0) @db.Decimal(12, 2)
  ivaBase           Decimal  @default(0) @db.Decimal(12, 2)
  totalBase         Decimal  @db.Decimal(12, 2)
  // Tasa BCV aplicada y total convertido a Bs en el momento de la compra.
  exchangeRate      Decimal  @db.Decimal(18, 4)
  totalBs           Decimal  @db.Decimal(18, 2)
  // Propina, en la moneda base del restaurante. Aparte del total (no es un
  // cargo del pedido): la agrega el cliente en mesa o el staff manualmente.
  tipBase           Decimal  @default(0) @db.Decimal(12, 2)
  // Costo de envío calculado en el checkout de delivery (por distancia o por
  // zona). Sí forma parte de totalBase/totalBs, a diferencia de la propina.
  deliveryFeeBase   Decimal  @default(0) @db.Decimal(12, 2)
  // El envío lo escribió el staff a mano al crear el pedido (panel), en vez de salir del
  // cálculo por zona/distancia. Sirve para no pisárselo después: al mover la dirección del
  // cliente el envío se recotiza solo si NO fue manual (ver updateCustomer).
  deliveryFeeManual Boolean  @default(false)
  // Cargo por envase (envase/caja/bolsa) de los productos del pedido. Solo se
  // calcula para canal DELIVERY/PICKUP (nunca DINE_IN/BAR) — ver Product.packagingMode.
  envaseFeeBase     Decimal  @default(0) @db.Decimal(12, 2)

  // --- Datos del cliente ---
  customerName     String?
  // Cédula/documento de identidad, usado para los datos de facturación
  // (principalmente canal DINE_IN).
  customerIdNumber String?
  customerPhone    String?
  customerAddress  String?
  // Coordenadas GPS del cliente (botón "Usar mi ubicación actual" en el
  // checkout de delivery), usadas para calcular el envío por distancia/zona.
  customerLat      Float?
  customerLng      Float?
  paymentMethod    PaymentMethod?
  customerNote     String?

  // Si el pedido lo cargó un mesero/staff desde "Órdenes de Mesa" (en vez de
  // ser el cliente desde su teléfono), queda el usuario que lo tomó.
  placedByUserId String?

  // Mesero/staff que apretó "Aceptar" en un pedido pedido por el cliente
  // (mesa/QR). Junto con placedByUserId, define qué pedidos ve el rol Mesero
  // en el Dashboard (los suyos + los que él aceptó).
  acceptedByUserId String?

  // Repartidor al que se despachó la comanda (botón "Delivery" del panel de
  // Pedidos), para poder ver el movimiento de cada repartidor en Administración.
  deliveryCourierId    String?
  deliveryDispatchedAt DateTime?

  // Botón del reloj en Pedidos: cuenta abierta del cliente, pendiente de
  // cobrar. Aparece en la pestaña "Pendiente por pagar" y en Administración
  // → Cuentas por pagar. Planes Pro/Premium (o CUSTOM con el adicional).
  awaitingPayment Boolean @default(false)

  // Se sella al cerrar caja: la comanda ya quedó saldada en ese turno y sale de la
  // pantalla de Pedidos para no arrastrar el turno anterior. No borra nada — el
  // pedido sigue completo en Administración. Las que aún deben algo NO se sellan,
  // así la deuda queda a la vista hasta que se cobre.
  clearedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant          Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table               Table?                    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSession        TableSession?             @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  placedByUser        User?                     @relation("OrderPlacedBy", fields: [placedByUserId], references: [id], onDelete: SetNull)
  acceptedByUser      User?                     @relation("OrderAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  deliveryCourier     DeliveryCourier?          @relation(fields: [deliveryCourierId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            OrderPayment[]
  // Plural: la factura (FA) y su eventual nota de crédito/débito (NC/ND).
  fiscalInvoices      FiscalInvoice[]
  paymentVerification OrderPaymentVerification?

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([tableSessionId])
  @@map("orders")
}

// Cobro registrado desde los botones "Pagar" / "Pago Fraccionado" del panel
// de Pedidos. Un pedido puede tener varios (pago fraccionado en distintos
// métodos); lo pagado se compara contra totalBase para saber el saldo.
model OrderPayment {
  id                           String        @id @default(cuid())
  orderId                      String
  amountBase                   Decimal       @db.Decimal(12, 2)
  method                       PaymentMethod
  // Descuento aplicado a este pago puntual (no al pedido completo, porque
  // pagos fraccionados distintos pueden llevar descuentos distintos).
  discountPercent              Decimal?      @db.Decimal(5, 2)
  discountBase                 Decimal?      @db.Decimal(12, 2)
  // Ajuste puntual al cargo de servicio de ESTE cobro (perdona parte/todo el servicio de este
  // pago) — mismo criterio que discountPercent/discountBase, nunca toca Order.serviceChargeBase.
  serviceChargeDiscountPercent Decimal?      @db.Decimal(5, 2)
  serviceChargeDiscountBase    Decimal?      @db.Decimal(12, 2)
  // Número de referencia/comprobante (Pago Móvil, Zelle) o de ticket (Punto de venta).
  referenceNumber              String?
  // Foto del comprobante (Pago Móvil/Zelle/Binance/PayPal/Transferencia) — obligatoria para
  // esos métodos al cobrar desde el panel (ver METHODS_REQUIRING_PROOF en order.dto.ts).
  proofImageUrl                String?
  createdAt                    DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_payments")
}

enum OrderPaymentVerificationStatus {
  AWAITING_PROOF // esperando que el cliente mande la foto del comprobante
  PENDING_FORWARD // ya llegó la foto (o, en modo FULL_ORDER, el pedido en sí), pero hay otra verificación en curso para este restaurante — en cola
  AWAITING_VERIFIER // foto (o pedido completo) reenviado al verificador, esperando "Aprobado"/"Rechazado"
  APPROVED
  // Terminal, solo en modo FULL_ORDER (sin foto que reenviar): a diferencia de un
  // rechazo en modo PAYMENT_VERIFICATION, que vuelve a AWAITING_PROOF para que el
  // cliente reenvíe el comprobante, acá no hay nada que reenviar.
  REJECTED
  TIMED_OUT
}

// Estado persistido (a diferencia de lastWelcomeReplyAt, que es solo un Map en memoria) de la
// verificación de pago por WhatsApp de un pedido delivery/pickup: el chatbot manda los datos de
// pago al crear el pedido, espera la foto del comprobante del cliente, se la reenvía al número
// verificador del restaurante (Ajustes -> WhatsApp,
// Restaurant.whatsappBotPaymentVerifierPhone) y, cuando ese número contesta "Aprobado", el
// pedido pasa solo de PENDING a KITCHEN (ver order.service.ts ->
// autoAcceptAfterPaymentApproved). Solo existe una fila por Order (@unique), y solo se crea
// para métodos de pago que requieren comprobante (ver PROOF_REQUIRED_PAYMENT_METHODS en
// src/utils/whatsapp.ts).
model OrderPaymentVerification {
  id            String @id @default(cuid())
  orderId       String @unique
  restaurantId  String
  // Teléfono del cliente normalizado a solo dígitos con código de país (mismo criterio que
  // formatVenezuelanWhatsappPhone), para poder compararlo dígito a dígito contra el JID de
  // WhatsApp de un mensaje entrante.
  customerPhone String

  status OrderPaymentVerificationStatus @default(AWAITING_PROOF)

  proofImageUrl         String?
  proofReceivedAt       DateTime?
  forwardedToVerifierAt DateTime?
  verifierRepliedAt     DateTime?
  resolvedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([restaurantId, customerPhone, status])
  @@map("order_payment_verifications")
}

// Configuración de facturación fiscal (SENIAT) vía Corporación Unidigital
// (docs.unidigital.global). Solo la crea/edita el equipo QuickTap desde el
// Dashboard maestro (ver master-restaurants.service.ts), igual que ivaEnabled —
// nunca autoservicio del restaurante. Cuando enabled=true, cada Order saldado
// por completo (ver order.service.ts -> addPayment) genera automáticamente
// una Factura a través de esta config (ver fiscal-invoicing.service.ts).
model FiscalInvoicingConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  enabled     Boolean @default(false)
  // "QA" (sandbox) o "PRODUCTION" — decide la URL base del cliente HTTP.
  environment String  @default("QA")

  username          String
  // Cifrado (AES-256-GCM, ver fiscal-invoicing.crypto.ts) — nunca texto plano.
  passwordEncrypted String

  // GUID de la Serie 0, cacheado tras el primer login exitoso contra /user/login.
  serieStrongId            String?
  // Correlativo interno por tipo de documento (ej: {"FA": 1042, "NC": 12}) — la
  // numeración de "Number" es responsabilidad de QuickTap, no de Unidigital.
  nextDocumentNumberByType Json    @default("{}")

  // JWT cacheado entre requests (dura 8h) para no loguearse en cada factura.
  accessToken    String?
  tokenExpiresAt DateTime?

  // IGTF (Impuesto a las Grandes Transacciones Financieras): aplica sobre pagos
  // en divisa/cripto. La alícuota vigente y a quién aplica la define el contador
  // del restaurante — por eso es configurable y arranca DESACTIVADO, para no
  // inventar un impuesto que no corresponda.
  igtfEnabled Boolean @default(false)
  igtfRate    Decimal @default(0) @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("fiscal_invoicing_configs")
}

// Historial de documentos fiscales emitidos (o intentados) por Order, vía
// Unidigital. status pasa PENDING (enviado, esperando N° de control, que
// tarda 1-5 min) -> ISSUED (con controlNumber) -> FAILED / VOIDED.
model FiscalInvoice {
  id           String @id @default(cuid())
  // NO es único por pedido: un mismo pedido puede tener su factura (FA) y
  // después una nota de crédito (NC) o de débito (ND) que la corrige. La
  // unicidad real es por (pedido, tipo de documento) — ver @@unique abajo.
  orderId      String
  restaurantId String

  documentType   String // "FA" | "NC" | "ND"
  documentNumber Int

  // GUID que devuelve Unidigital al crear el documento — clave para
  // reconsultar/anular más adelante.
  unidigitalStrongId String?
  controlNumber      Int?

  status       String // "PENDING" | "ISSUED" | "FAILED" | "VOIDED"
  errorMessage String?

  // Contingencia (Providencia 102, art. sobre continuidad operativa): un fallo
  // de red o del API de la imprenta no puede perder la factura. Se reintenta
  // con backoff hasta MAX_ISSUE_ATTEMPTS antes de quedar en revisión manual.
  attempts    Int       @default(0)
  nextRetryAt DateTime?

  // Anulación: nunca se borra la fila, se marca. La corrección fiscal real va
  // por NC/ND, que apunta aquí con replacesInvoiceId.
  voidedAt          DateTime?
  voidReason        String?
  replacesInvoiceId String?
  replaces          FiscalInvoice?  @relation("FiscalInvoiceCorrection", fields: [replacesInvoiceId], references: [id], onDelete: Restrict)
  correctedBy       FiscalInvoice[] @relation("FiscalInvoiceCorrection")

  rawRequestJson  Json?
  rawResponseJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict, NO Cascade: borrar un pedido no puede arrastrarse el documento
  // fiscal. Un documento emitido es inalterable e imborrable — si el pedido se
  // quiere "deshacer" hay que emitir una NC, no eliminar el registro.
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, documentType])
  @@index([restaurantId, status])
  // Cola de contingencia: barrido de pendientes por reintentar.
  @@index([status, nextRetryAt])
  @@map("fiscal_invoices")
}

// Pista de auditoría fiscal (Providencia 102: registro automático e inalterable
// de quién hizo qué sobre un documento fiscal, y cuándo). Solo se inserta —
// nunca se actualiza ni se borra desde el código de la aplicación.
model FiscalAuditLog {
  id           String  @id @default(cuid())
  restaurantId String
  // Puede ser null cuando el evento es previo a existir la factura (ej.
  // ISSUE_ATTEMPT que falló antes de poder crear la fila).
  invoiceId    String?
  orderId      String?

  // "ISSUE_ATTEMPT" | "ISSUED" | "ISSUE_FAILED" | "CONTROL_NUMBER_ASSIGNED"
  // | "VOID_REQUESTED" | "VOIDED" | "CREDIT_NOTE_ISSUED" | "MODIFY_BLOCKED"
  // | "DELETE_BLOCKED" | "CONFIG_CHANGED"
  event String

  // Quién: usuario del restaurante, admin de plataforma, o el sistema (jobs).
  actorType String // "USER" | "PLATFORM_ADMIN" | "SYSTEM"
  actorId   String?
  actorName String?

  // Detalle libre del evento (montos, código de error, payload relevante).
  detail Json?

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([invoiceId])
  @@map("fiscal_audit_logs")
}

// Movimiento manual de caja (botón "Añadir movimiento" en Administración →
// Resumen): ingresos/egresos que no vienen de un pedido, y propinas sueltas.
// Solo lo ven/crean roles de acceso total (OWNER/ADMIN/CASHIER/STAFF).
model Movement {
  id              String       @id @default(cuid())
  restaurantId    String
  type            MovementType
  amountBase      Decimal      @db.Decimal(12, 2)
  description     String
  createdByUserId String?
  createdAt       DateTime     @default(now())

  // --- Botón "Añadir ingreso" (solo aplica cuando type = INCOME) ---
  incomeCategory IncomeCategory?
  // Con qué se recibió (INCOME) o con qué se pagó (EXPENSE) — en gastos sirve para cuadrar
  // la caja: no es lo mismo pagar la gasolina en efectivo que por transferencia.
  paymentMethod  PaymentMethod?

  // --- Módulo de Gastos (todos opcionales; no afectan ingresos/propinas) ---
  category          ExpenseCategory?
  supplierId        String?
  // Insumo reabastecido por este gasto (ej: compra de agua) y cantidad recibida:
  // al crear el movimiento, se suma automáticamente a InventoryItem.quantity.
  inventoryItemId   String?
  inventoryQuantity Decimal?         @db.Decimal(12, 2)
  // Gasto tomado a crédito con el proveedor: cuenta pendiente por pagar
  // (al revés de Order.awaitingPayment, que es lo que el cliente le debe
  // al restaurante). El balance del período lo resta igual, ya esté pagado
  // o no — esto solo lleva el seguimiento de si ya se le pagó al proveedor.
  isCredit          Boolean          @default(false)
  creditPaidAt      DateTime?
  // Fecha real del gasto cuando no es hoy (factura de hace unos días que se carga después).
  // Null = vale createdAt. El balance del período usa esta fecha si está, para que el gasto
  // caiga en el día que ocurrió y no en el que alguien lo escribió.
  expenseDate       DateTime?
  // Nº de factura/recibo/referencia de la transferencia, para conciliar con el soporte físico.
  referenceNumber   String?
  // Foto del recibo (gasolinera, hotel, restaurante). Clave en gastos de viaje: el soporte
  // se pierde y sin él no hay cómo justificar el egreso.
  receiptImageUrl   String?
  // Quién hizo el gasto, cuando no fue quien lo registra (ej. el chofer que cargó gasolina).
  spentByName       String?

  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdByUser User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, isCredit, creditPaidAt])
  @@map("movements")
}

// Proveedor al que se le compran insumos/servicios (módulo de Gastos).
model Supplier {
  id           String @id @default(cuid())
  restaurantId String

  name  String
  phone String?
  // RIF o cédula del proveedor.
  taxId String?

  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  movements  Movement[]

  @@index([restaurantId])
  @@map("suppliers")
}

// Directorio de clientes del restaurante: se crea/actualiza automáticamente
// (upsert por teléfono) cada vez que se abre una cuenta de mesa o se hace un
// pedido de delivery/pickup/manual con teléfono, para poder buscarlo después
// en vez de tipear los datos de nuevo.
model Customer {
  id           String @id @default(cuid())
  restaurantId String

  name     String
  phone    String
  idNumber String?
  address  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Historial de cancha del jugador (vertical SPORTS_CLUB).
  clubBookings ClubBooking[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, name])
  @@map("customers")
}

// Turno de caja (botón "Abrir Caja" / "Cerrar Caja" en Administración → Resumen).
// Solo puede haber una sesión OPEN por restaurante a la vez. Al cerrar se
// congela un snapshot del movimiento del turno en `closingSummary`, para que
// el recibo descargable no cambie si luego se registran movimientos tardíos.
model CashSession {
  id           String            @id @default(cuid())
  restaurantId String
  status       CashSessionStatus @default(OPEN)

  openedByUserId  String?
  openedAt        DateTime @default(now())
  // Saldo declarado al abrir, por método de pago: Record<PaymentMethod, string>.
  openingBalances Json

  closedByUserId String?
  closedAt       DateTime?
  // Correlativo por restaurante, asignado recién al cerrar (igual que Order.orderNumber).
  closeNumber    Int?
  // Snapshot calculado al cerrar: ventas por método + movimientos + totales.
  closingSummary Json?

  // --- Arqueo (conteo físico al cerrar) ---
  // Lo que el cajero CONTÓ de verdad, por método de pago: Record<PaymentMethod, string>.
  // Es opcional: el cierre de siempre (solo resumen del turno, sin contar) sigue siendo
  // válido y deja esto en null. Cuando viene cargado, el snapshot congela también el
  // sobrante/faltante contra lo esperado, que es lo que convierte el cierre en un arqueo.
  countedBalances Json?

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  openedByUser User?      @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)
  closedByUser User?      @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status])
  @@index([restaurantId, closeNumber])
  @@map("cash_sessions")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  // Referencia al producto (puede quedar en null si el producto se borra),
  // pero conservamos un snapshot del nombre y precio para historial.
  productId String?

  productName String
  // Nombre de la variante elegida (si el producto usa "Precio por variantes"), congelado igual que productName.
  variantName String?
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int     @default(1)
  lineTotal   Decimal @db.Decimal(12, 2)

  // Cuánto de esta línea ya se cobró (fraccionar pago por ítems). Nunca supera `quantity`;
  // no es la fuente de verdad de "pedido saldado" (eso sigue siendo por monto en Order/OrderPayment).
  paidQuantity Int @default(0)

  // Nota de cocina (ej: "Sin cebolla").
  note String?

  // Snapshot de la cocina asignada al producto al momento del pedido (null =
  // sin asignar). Se congela igual que productName: si luego el producto
  // cambia de cocina, este ítem no se mueve retroactivamente de comanda.
  kitchenName    String?
  // Cuándo esa estación de cocina marcó su parte de la comanda como lista.
  // El pedido completo pasa a SERVED solo cuando todos sus ítems tienen esto.
  kitchenReadyAt DateTime?

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@map("order_items")
}

// Modificador elegido en un ítem del pedido — snapshot de nombre/precio, igual que productName.
model OrderItemModifier {
  id          String  @id @default(cuid())
  orderItemId String
  // Referencia al Modifier del catálogo. Se guarda SOLO para poder resolver el
  // insumo vinculado al descontar stock; el resto del renglón sigue siendo
  // snapshot (name/priceBase no cambian si luego editan el modificador). Es
  // nullable a propósito: los pedidos anteriores a este campo no lo tienen, y
  // un modificador borrado no debe romper el histórico.
  modifierId  String?
  name        String
  priceBase   Decimal @db.Decimal(12, 2)
  // Cuántas veces se eligió esta misma opción (ej. "Ketchup x4"). Snapshot, igual que name/priceBase.
  quantity    Int     @default(1)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

// ----------------------------------------------------------------------------
//  SOLICITUD DE PLAN (lead desde la landing, previo al registro de cuenta)
// ----------------------------------------------------------------------------

// Un prospecto elige un plan + método de pago en la landing y sube su
// comprobante. No está ligado a un Restaurant: en este punto del embudo
// todavía no existe la cuenta. Se revisa manualmente por ahora.
model PlanRequest {
  id String @id @default(cuid())

  // SIGNUP: enviado desde la landing, antes de existir la cuenta (restaurantId
  // null hasta que el admin de plataforma lo vincula al aprobar). RENEWAL:
  // enviado autenticado desde el panel del restaurante, restaurantId siempre presente.
  kind         PlanRequestKind   @default(SIGNUP)
  status       PlanRequestStatus @default(PENDING)
  restaurantId String?

  plan         SubscriptionPlan
  billingCycle BillingCycle

  // Solo si plan = CUSTOM: los valores que el prospecto ajustó en el slider.
  customTables          Int?
  customUsers           Int?
  customOrders          Int?
  // Solo si plan = CUSTOM: adicionales elegidos (se copian a Restaurant al aprobar).
  customAdministration  Boolean @default(false)
  customInventoryBasic  Boolean @default(false)
  customInventoryRecipe Boolean @default(false)
  customAccountsPayable Boolean @default(false)

  // Código promocional aplicado (si hubo). El descuento ya está reflejado en priceUsd.
  promoCode       String?
  discountPercent Int?

  // Precio mensual calculado en el servidor a partir del plan/ciclo (o de la fórmula del plan
  // personalizado) y el código promocional. Nunca se confía en un precio enviado por el cliente.
  // El sufijo "Usd" es histórico: la moneda real es PlatformSettings.subscriptionCurrency.
  priceUsd Decimal @db.Decimal(10, 2)

  paymentMethod    SubscriptionPaymentMethod
  // Número de referencia de la transferencia/pago móvil/Binance (antes se
  // subía una foto/PDF del comprobante; ahora el restaurante solo escribe
  // este número y el equipo de QuickTap lo valida contra su banco). Para
  // paymentMethod = RAMBLAY, se llena con el id que devuelve Ramblay al crear
  // el pago (igual que ramblayPaymentId) en vez de un número tecleado a mano.
  paymentReference String

  // Id de la transacción/sesión de pago en Ramblay (solo paymentMethod = RAMBLAY).
  // Correlaciona el webhook de "pago aprobado/rechazado" con esta solicitud.
  ramblayPaymentId String? @unique

  contactName    String
  contactEmail   String
  contactPhone   String?
  restaurantName String?

  createdAt DateTime @default(now())

  restaurant Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  // Abonos del "pago fraccionado" (solo pago manual): cada uno con su propio
  // monto/método/comprobante, hasta cubrir priceUsd — ver plan-request.service.ts.
  // Vacío para una solicitud de pago único de siempre.
  payments   PlanRequestPayment[]

  @@index([restaurantId])
  @@index([kind, status])
  @@map("plan_requests")
}

// Un abono individual de un "pago fraccionado" hacia una PlanRequest (pago
// manual de mensualidad/inscripción). El restaurante puede registrar varios
// hasta cubrir PlanRequest.priceUsd; el equipo QuickTap los revisa todos
// (con su comprobante) antes de "Activar cuenta" desde el Dashboard maestro.
model PlanRequestPayment {
  id               String                    @id @default(cuid())
  planRequestId    String
  amountUsd        Decimal                   @db.Decimal(10, 2)
  paymentMethod    SubscriptionPaymentMethod
  paymentReference String
  proofImageUrl    String
  createdAt        DateTime                  @default(now())

  planRequest PlanRequest @relation(fields: [planRequestId], references: [id], onDelete: Cascade)

  @@index([planRequestId])
  @@map("plan_request_payments")
}

// Solicitud de cotización de QR NFC (hardware físico). Siempre viene de un
// restaurante ya autenticado (no hay flujo público como en PlanRequest), y no
// lleva comprobante: el equipo de QuickTap la revisa y contacta al restaurante.
model QrNfcRequest {
  id String @id @default(cuid())

  restaurantId String

  quantity      Int
  unitPriceUsd  Decimal            @db.Decimal(10, 2)
  totalPriceUsd Decimal            @db.Decimal(10, 2)
  status        QrNfcRequestStatus @default(PENDING)

  contactName  String
  contactEmail String
  contactPhone String?

  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([status])
  @@map("qr_nfc_requests")
}

// Cotización/presupuesto: un total para aprobar (catering, pedido grande, venta al mayor) sin
// cobrar ni afectar cocina/inventario todavía. Sirve tanto para restaurantes como para Locales
// Comerciales — `items` es JSON libre en vez de relaciones a Product/ShopProduct porque cada
// negocio tiene un catálogo con forma distinta; lo único que importa acá es nombre/cantidad/precio
// ya congelados, igual que OrderItem congela lo suyo al momento de la venta real.
model Quote {
  id           String @id @default(cuid())
  restaurantId String

  customerName  String?
  customerPhone String?
  note          String?

  // [{ name, qty, unitPrice }] — snapshot de lo cotizado, no referencias vivas al catálogo.
  items     Json
  totalBase Decimal  @db.Decimal(12, 2)
  currency  Currency

  // Se llena cuando el cliente aprueba y el presupuesto se convierte en una venta real —
  // Order.id para restaurantes, ShopSale.id para Locales Comerciales (un solo campo de texto
  // libre porque son dos tablas distintas; no hay integridad referencial cruzada a propósito).
  convertedToId String?
  createdAt     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("quotes")
}

// Cobro puntual que el equipo QuickTap le suma a un restaurante por fuera de
// la mensualidad (Dashboard maestro → Cobro): setup, diseño, QR NFC, soporte
// extra, etc. Se suma al total de la próxima mensualidad, pero SIEMPRE se
// muestra desglosado y etiquetado como cargo adicional — el restaurante tiene
// que poder ver por qué está pagando más que su tarifa mensual habitual.
model AdditionalCharge {
  id           String @id @default(cuid())
  restaurantId String

  amountUsd   Decimal @db.Decimal(10, 2)
  // El "x motivo" que se le muestra al restaurante al cobrarle.
  description String

  // Se marca al aprobar la solicitud de plan que lo incluyó (ver
  // applyActivation), para que no se vuelva a cobrar en la mensualidad
  // siguiente.
  chargedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, chargedAt])
  @@map("additional_charges")
}

// Códigos de descuento para la pasarela de pago (10%–100%).
model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  // Vencimiento opcional, calculado al crear el código a partir de
  // durationValue + durationUnit (ej. 7 DAY). Null = sin vencimiento.
  expiresAt     DateTime?
  durationValue Int?
  durationUnit  PromoCodeDurationUnit?

  @@map("promo_codes")
}

// Configuración global (no por restaurante) de la plataforma: datos de pago
// mostrados en la pasarela manual. Fila única, JSON flexible.
model PlatformSettings {
  id                   String  @id @default("singleton")
  paymentMethods       Json?
  // Interruptores globales de la pasarela de pago (landing + billing autenticado).
  // Si se apagan ambos, PaymentForm no deja pagar hasta que se reactive uno.
  ramblayEnabled       Boolean @default(true)
  manualPaymentEnabled Boolean @default(true)
  // Interruptor global de los botones "Mejorar con IA" / "Fondo blanco con IA"
  // (ai-photo-service, facturado con una sola API key de Gemini pagada por
  // QuickTap, no por restaurante) — apagarlo bloquea ambos botones en todos
  // los restaurantes y locales a la vez.
  aiPhotoEnabled       Boolean @default(true)
  // Precios/descripción editables por plan desde el Dashboard maestro. Parcial
  // (solo los planes que el master haya tocado); se fusiona con los valores
  // por defecto en platform-settings.service.ts al leer.
  planContent          Json?
  // Moneda en la que QuickTap cobra la mensualidad de sus restaurantes/locales — no confundir
  // con Restaurant.baseCurrency, que es la moneda del MENÚ de cada tenant. Cambiarla no
  // recalcula los precios ya cargados en `planContent`/`customMonthlyPriceUsd`: solo cambia el
  // símbolo con el que se muestran y se cobran de ahí en adelante (ver Dashboard maestro → Planes).
  subscriptionCurrency Currency @default(USD)

  // --- Chatbot de WhatsApp de la plataforma (ver src/modules/master-whatsapp/) ---
  // Mismo mecanismo de vinculación por QR que el bot de cada restaurante
  // (whatsapp-bot.service.ts), pero una única sesión para todo QuickTap: manda el
  // saludo de bienvenida al registrarse un restaurante y los recordatorios de
  // renovación de plan.
  masterWhatsappEnabled         Boolean @default(false)
  masterWhatsappConnectedNumber String?
  // Número (solo dígitos) que recibe el comprobante de cada renovación y responde
  // "Aprobado"/"Rechazado" — igual criterio que Restaurant.whatsappBotPaymentVerifierPhone.
  // null = el recordatorio de pago se sigue mandando, pero no hay a quién reenviarle el
  // comprobante (el equipo QuickTap debe revisarlo a mano en Comprobantes).
  subscriptionVerifierPhone     String?
  // Plantillas editables de los mensajes que manda el bot del master (recordatorio de pago,
  // acuse de comprobante recibido, pago aprobado/rechazado, bienvenida) — parcial, se fusiona
  // con los valores por defecto en platform-settings.service.ts (DEFAULT_MESSAGE_TEMPLATES).
  messageTemplates              Json?

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

enum SubscriptionPaymentVerificationStatus {
  AWAITING_PROOF // esperando que el dueño mande la foto del comprobante de renovación
  PENDING_FORWARD // ya llegó la foto, pero hay otra verificación en curso — en cola
  AWAITING_VERIFIER // foto reenviada al verificador, esperando "Aprobado"/"Rechazado"
  APPROVED
  REJECTED
  TIMED_OUT
}

// Verificación de pago de RENOVACIÓN de plan por el chatbot maestro de WhatsApp (distinto de
// OrderPaymentVerification, que es por pedido de un cliente). Mismas reglas centrales: solo
// puede haber UNA fila en AWAITING_VERIFIER a la vez (acá para toda la plataforma, no por
// restaurante, porque hay un solo número verificador) — así "Aprobado" nunca es ambiguo.
model SubscriptionPaymentVerification {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Teléfono del dueño normalizado a solo dígitos (Restaurant.whatsappPhone), para matchear
  // la foto entrante igual que OrderPaymentVerification.customerPhone.
  ownerPhone String

  status SubscriptionPaymentVerificationStatus @default(AWAITING_PROOF)

  plan         SubscriptionPlan
  billingCycle BillingCycle
  // Monto informado en el recordatorio (referencia — la renovación real usa nextPeriodEnd()
  // sobre plan/billingCycle, nunca este monto, igual criterio que PlanRequest).
  amountUsd    Decimal?         @db.Decimal(10, 2)

  proofImageUrl         String?
  proofReceivedAt       DateTime?
  forwardedToVerifierAt DateTime?
  verifierRepliedAt     DateTime?
  resolvedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerPhone, status])
  @@map("subscription_payment_verifications")
}

// Cuenta del equipo de QuickTap (no de un restaurante) con acceso al
// Dashboard maestro: ve todos los restaurantes, revisa comprobantes, etc.
// ADMIN y MANAGER (Gestor) tienen el mismo acceso total al Dashboard maestro;
// el rol es solo para identificar quién es quién en la lista de cuentas.
enum PlatformAdminRole {
  ADMIN
  MANAGER
}

model PlatformAdmin {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  role         PlatformAdminRole @default(ADMIN)
  createdAt    DateTime          @default(now())

  @@map("platform_admins")
}

/// Borrador/aviso de actualización del equipo QuickTap, editable desde el dashboard master antes
/// de mandarlo por el chatbot de la plataforma (ver src/modules/master-whatsapp/). El flujo es
/// crear -> revisar/editar el texto -> "Enviar", que dispara masterWhatsappBotService.broadcast()
/// solo a los restaurantes/locales activos que coincidan con targetBusinessType.
model PlatformAnnouncement {
  id                 String             @id @default(cuid())
  message            String
  // null = manda a restaurantes y locales por igual.
  targetBusinessType BusinessType?
  status             AnnouncementStatus @default(DRAFT)
  sentAt             DateTime?
  // Cuántos números se encolaron al mandar — congelado en el momento del envío, no se recalcula.
  sentCount          Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, createdAt])
  @@map("platform_announcements")
}

enum AnnouncementStatus {
  DRAFT
  SENT
}

// ----------------------------------------------------------------------------
//  INVENTARIO (solo plan Premium)
//  Lista simple de insumos con cantidad en existencia y stock mínimo, para
//  avisar cuándo hay que reabastecer. No descuenta automáticamente por venta:
//  el equipo ajusta la cantidad manualmente.
// ----------------------------------------------------------------------------
model InventoryCategory {
  id           String @id @default(cuid())
  restaurantId String

  name     String
  priority Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      InventoryItem[]

  @@index([restaurantId, priority])
  @@map("inventory_categories")
}

model InventoryItem {
  id           String  @id @default(cuid())
  restaurantId String
  categoryId   String?

  name             String
  photoUrl         String?
  // Unidad restringida desde el formulario: "kg" | "lt" | "unidad".
  unit             String
  quantity         Decimal  @default(0) @db.Decimal(12, 2)
  minQuantity      Decimal  @default(0) @db.Decimal(12, 2)
  // Costo por 1 unidad (kg/lt/unidad), en la moneda base del restaurante.
  // Se recalcula al cargar un precio + cantidad desde el formulario de
  // insumos, y alimenta el cálculo automático del costo de receta.
  pricePerUnitBase Decimal? @db.Decimal(14, 4)

  // Qué porcentaje de este insumo queda realmente aprovechable tras merma o
  // limpieza (ej. 90 = de 1 kg comprado solo 900 gr sirven). Colchón por
  // fluctuación de precio del proveedor. Ambos ajustan pricePerUnitBase antes
  // de costear una receta o preparación (ver src/modules/inventory/costing.ts)
  // — 100/0 = comportamiento idéntico al de antes de agregar estos campos.
  yieldPercent      Decimal @default(100) @db.Decimal(5, 2)
  correctionPercent Decimal @default(0) @db.Decimal(5, 2)

  // Fecha de caducidad del lote en stock, "YYYY-MM-DD" en hora de Caracas.
  // String y no DateTime a propósito: guardado como fecha UTC, un insumo que
  // vence "el 3" se leería como el 2 en Venezuela (UTC-4). Mismo criterio que
  // ShopProduct.expiryDate. Null = no caduca o no se lleva el control.
  expiryDate String?

  // --- Envase (envase/caja/bolsa) ---
  // No nulo = este insumo está disponible para vincularse como envase de un producto
  // (Product.packagingItemId), sin importar en qué InventoryCategory esté archivado.
  packagingType String?
  // Precio que se le cobra al cliente por 1 unidad de este envase (distinto de
  // pricePerUnitBase, que es costo). Solo tiene efecto cuando packagingType no es null.
  salePriceBase Decimal? @db.Decimal(12, 2)

  // "LOCAL" (de siempre) = insumo normal de esta sede; "CASA_MATRIZ" = vive en la
  // ventana aparte de Casa Matriz (solo existe en la sede principal, ver
  // Restaurant.casaMatrizEnabled). Incluido en la resolución de "compartido/por sede"
  // de src/modules/inventory/inventory-scope.ts.
  locationScope String @default("LOCAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant        Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category          InventoryCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipeLines       RecipeIngredient[]
  preparationLines  PreparationIngredient[]
  modifiers         Modifier[]
  movements         Movement[]
  packagingProducts Product[]               @relation("ProductPackaging")

  @@index([restaurantId])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, packagingType])
  @@index([restaurantId, locationScope])
  @@map("inventory_items")
}

// Registro histórico de una transferencia de insumos entre sedes de un mismo grupo
// (sede principal + sucursales), o entre Casa Matriz y una sede. Snapshot de nombres
// (igual criterio que Order congela productName): el historial no debe cambiar si el
// insumo o la sede se renombran/borran después.
model InventoryTransfer {
  id      String @id @default(cuid())
  // Id de la sede principal del grupo (self o parentRestaurantId) — ancla el
  // historial a un grupo entero sin importar desde qué sede se consulte.
  groupId String

  fromRestaurantId String
  fromScope        String // "LOCAL" | "CASA_MATRIZ"
  fromLocationName String
  toRestaurantId   String
  toScope          String
  toLocationName   String

  itemName String
  unit     String
  quantity Decimal @db.Decimal(12, 2)

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([groupId, createdAt])
  @@map("inventory_transfers")
}

// Línea de receta: cuánto de un insumo (InventoryItem) o de una preparación
// (Preparation, ver más abajo) usa un producto del menú por cada unidad
// vendida, y su costo. Exactamente uno de inventoryItemId/preparationId debe
// estar presente (validado en recipe.dto.ts, no a nivel de DB). Vender el
// producto (al marcarlo SERVED) descuenta insumo(s) base automáticamente —
// si la línea apunta a una preparación, se resuelve recursivamente hasta sus
// insumos (ver resolveConsumedInventoryItems en costing.ts).
model RecipeIngredient {
  id              String  @id @default(cuid())
  restaurantId    String
  productId       String
  inventoryItemId String?
  preparationId   String?

  // Cantidad usada por una unidad del producto, en la unidad base del insumo
  // o preparación vinculada (ej: si el insumo está en "kg", aquí van kg).
  quantity Decimal @db.Decimal(12, 3)
  // Costo de esa cantidad, en la moneda base del restaurante. Snapshot
  // recalculado por recomputeDependentCosts cuando cambia algo aguas arriba.
  costBase Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  preparation   Preparation?   @relation(fields: [preparationId], references: [id], onDelete: Restrict)

  @@index([restaurantId, productId])
  @@index([inventoryItemId])
  @@index([preparationId])
  @@map("recipe_ingredients")
}

// Preparación (sub-receta): una base intermedia reutilizable entre platos
// (fondo, salsa madre, masa) armada a partir de insumos y/o de otras
// preparaciones. No tiene stock propio — es puramente un nodo de costeo; lo
// que se descuenta al vender siempre son los InventoryItem que resuelve en
// la base de esta cadena (ver PreparationIngredient y costing.ts).
model Preparation {
  id            String  @id @default(cuid())
  restaurantId  String
  name          String
  // "kg" | "lt" — una preparación siempre se mide en peso/volumen, nunca "unidad".
  unit          String
  // Cuánto rinde esta preparación, en la unidad declarada arriba (kg/lt) — igual criterio
  // que RecipeIngredient.quantity: gr/ml son solo la conveniencia de entrada en la UI,
  // convertidos antes de guardar. Los insumos que entran pueden sumar más que esto (merma
  // al cocinar), el costo total se reparte entre lo que realmente rinde.
  yieldQuantity Decimal @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant    Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredients   PreparationIngredient[] @relation("PreparationOwner")
  usedInPreps   PreparationIngredient[] @relation("PreparationRef")
  usedInRecipes RecipeIngredient[]

  @@index([restaurantId])
  @@map("preparations")
}

// Línea de ingrediente de una Preparation: apunta a un insumo o a OTRA
// preparación (sub-receta anidada), nunca ambos — mismo criterio de
// RecipeIngredient. onDelete: Restrict en componentPreparation evita borrar
// una preparación que otra sigue usando (el service también valida antes,
// con mensaje claro).
model PreparationIngredient {
  id                     String  @id @default(cuid())
  restaurantId           String
  preparationId          String
  inventoryItemId        String?
  componentPreparationId String?

  // En la unidad propia del ingrediente referenciado (kg/lt/unidad si es insumo, kg/lt si
  // es otra preparación) — gr/ml son solo la conveniencia de entrada en la UI.
  quantity Decimal @db.Decimal(12, 3)
  // Snapshot, mismo criterio que RecipeIngredient.costBase.
  costBase Decimal @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant           Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  preparation          Preparation    @relation("PreparationOwner", fields: [preparationId], references: [id], onDelete: Cascade)
  inventoryItem        InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  componentPreparation Preparation?   @relation("PreparationRef", fields: [componentPreparationId], references: [id], onDelete: Restrict)

  @@index([restaurantId, preparationId])
  @@index([inventoryItemId])
  @@index([componentPreparationId])
  @@map("preparation_ingredients")
}

// ----------------------------------------------------------------------------
//  EQUIPO DE DELIVERY Y ZONAS DE ENVÍO
// ----------------------------------------------------------------------------

// Repartidor externo (no es un usuario del panel): solo nombre + WhatsApp,
// para poder mandarle el resumen del pedido cuando el staff lo despacha.
model DeliveryCourier {
  id           String @id @default(cuid())
  restaurantId String

  name          String
  whatsappPhone String
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([restaurantId])
  @@map("delivery_couriers")
}

// Zona de envío con precio fijo: el admin la dibuja como polígono en el mapa
// de Ajustes. `polygon` es un array de puntos [{lat,lng}, ...] en GeoJSON-ish.
model DeliveryZone {
  id           String @id @default(cuid())
  restaurantId String

  name    String
  price   Decimal @db.Decimal(12, 2)
  polygon Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("delivery_zones")
}

// ----------------------------------------------------------------------------
// QuickTap Shop (businessType = SHOP): catálogo, ventas y caja de un local comercial —
// completamente aparte de Product/Order/CashSession (esos son del vertical restaurante).
// Ver web/src/pages/admin/shop/shopSession.ts para la contraparte de frontend.
// ----------------------------------------------------------------------------

model ShopProduct {
  id           String @id @default(cuid())
  restaurantId String

  name        String
  category    String
  subcategory String
  sku         String
  location    String
  price       Float
  cost        Float
  minStock    Float
  // Foto del producto — obligatoria al crear uno nuevo desde el panel (ver ShopInventoryPage.tsx).
  photoUrl    String?

  // Aparece en el catálogo público de la tienda virtual (/tienda/:slug). Arranca apagado a
  // propósito: el inventario de un local también tiene INSUMOS (cera, shampoo, material de
  // impresión) que se consumen internamente y no se le venden a nadie por internet. Publicar
  // todo por defecto los expondría —con su precio— el día que el local encienda su tienda.
  isPublished Boolean @default(false)

  // Precio mayorista: se aplica en Venta cuando la cantidad del carrito llega a wholesaleMinQty.
  wholesalePrice  Float?
  wholesaleMinQty Float?
  // Precio promocional: si está seteado, gana siempre sobre price y wholesalePrice.
  promoPrice      Float?
  // Fecha de vencimiento (ISO yyyy-mm-dd), texto libre igual que en el frontend.
  expiryDate      String?
  // Marca del producto (ej. "Coca-Cola", "Polar") — separado de la categoría para poder
  // filtrar/agrupar el inventario por marca sin mezclarlo con la clasificación por tipo.
  brand           String  @default("")

  // --- Impresión de gran formato (rubro Agencia de Publicidad) ---
  // 'UNIT' (por defecto) = se vende por unidad, como cualquier producto.
  // 'AREA_ROLL' = se vende por metro cuadrado saliendo de un rollo: el cliente pide una pieza
  // de ancho × alto y se le cobra el ANCHO COMPLETO del rollo del que se corta, porque el
  // sobrante a lo ancho no se reaprovecha (ver web/.../shop/printPricing.ts). Con este modo,
  // `price` y `cost` pasan a ser por m² en vez de por unidad.
  pricingMode String @default("UNIT")
  // Anchos de rollo disponibles en metros, ej. [1.06, 1.37, 1.6, 1.84] para banner. Solo
  // aplica con pricingMode = 'AREA_ROLL'.
  rollWidths  Json?
  // Largo del rollo en metros (típicamente 50) — se usa para derivar el costo por m² a partir
  // de lo que costó el rollo entero, que es como el dueño compra el material.
  rollLengthM Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  variants        ShopProductVariant[]
  // Insumos que consume este producto cuando es un servicio (ver ShopServiceSupply).
  serviceSupplies ShopServiceSupply[]  @relation("ShopServiceSupplyService")

  @@index([restaurantId])
  @@map("shop_products")
}

// Una fila por combinación de variante (ej: Talla M / Color Azul) con su propio stock.
model ShopProductVariant {
  id        String @id @default(cuid())
  productId String

  v1           String
  v2           String
  stock        Float
  // Se vende por peso (Kg): en el carrito la cantidad es decimal, no unidades enteras.
  soldByWeight Boolean @default(false)

  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("shop_product_variants")
}

// Venta del POS de Shop — cada línea se snapshotea completa en ShopSaleItem (independiente de
// ediciones posteriores al producto), mismo criterio que Order/OrderItem del vertical restaurante.
model ShopSale {
  id           String @id @default(cuid())
  restaurantId String

  total         Float
  time          DateTime @default(now())
  customerName  String?
  customerPhone String?
  returned      Boolean  @default(false)
  paymentMethod String?
  // { reference?, hasProof? } — comprobante de Pago Móvil.
  paymentMeta   Json?
  // 'FULL' | 'INSTALLMENT' | null — venta fiada (se paga todo después, o se abonó algo ahora).
  creditTerms   String?
  amountPaidNow Float?

  // --- Cuentas por cobrar (solo aplica cuando creditTerms no es null) ---
  // Fecha en que el cliente se comprometió a pagar el saldo — igual que expiryDate en
  // ShopProduct, texto libre ISO yyyy-mm-dd para no acoplarse a huso horario.
  dueDate   String?
  // Se marca cuando la suma de amountPaidNow + todos los ShopSalePayment iguala el total.
  // Null = todavía tiene saldo pendiente.
  settledAt DateTime?

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      ShopSaleItem[]
  payments   ShopSalePayment[]

  @@index([restaurantId])
  @@index([restaurantId, creditTerms, settledAt])
  @@map("shop_sales")
}

// Abono posterior contra una venta fiada (ShopSale.creditTerms != null) — cada uno reduce el
// saldo pendiente sin tener que reabrir o duplicar la venta original. El saldo se calcula
// siempre en el servicio (total - amountPaidNow - suma de estos pagos), nunca se cachea.
model ShopSalePayment {
  id         String   @id @default(cuid())
  shopSaleId String
  amount     Float
  method     String?
  createdAt  DateTime @default(now())

  shopSale ShopSale @relation(fields: [shopSaleId], references: [id], onDelete: Cascade)

  @@index([shopSaleId])
  @@map("shop_sale_payments")
}

model ShopSaleItem {
  id     String @id @default(cuid())
  saleId String

  // Informativo, sin relación FK — el resto de los campos ya snapshotea todo lo necesario
  // para mostrar/devolver la venta aunque el producto original cambie o se borre.
  productId         String?
  v1                String
  v2                String
  name              String
  category          String?
  qty               Float
  price             Float
  cost              Float
  soldByWeight      Boolean @default(false)
  // Detalle congelado de la línea, para que el recibo y el historial sigan explicando de dónde
  // salió la cantidad. Hoy lo usa la impresión de gran formato: "1,20 × 0,80 m · rollo 1,37" —
  // sin esto, la venta solo diría "1,096" y nadie podría reconstruir qué se imprimió.
  detail            String?
  // Cuánto descontar del stock cuando NO coincide con `qty`. En impresión de gran formato `qty`
  // son los m² que se COBRAN (1,096) pero del rollo se consumen metros LINEALES (0,80): sin este
  // campo se descontaría el número equivocado. Null = descontar `qty`, como el resto del catálogo.
  stockQty          Float?
  // Profesional que prestó ESTE servicio (barbero/estilista). Por línea y no por venta: un
  // mismo ticket puede llevar el corte de un barbero y un producto vendido sin nadie detrás.
  // Sin relación FK: si el usuario se borra, la venta histórica no se toca (igual que productId).
  staffUserId       String?
  // Congelados al momento de la venta, como el resto de los importes: si después se le cambia
  // el % al barbero, lo ya liquidado no se mueve.
  commissionPercent Float?
  commissionBase    Float?

  sale ShopSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([staffUserId])
  @@map("shop_sale_items")
}

// Receta de insumos de un servicio del Local Comercial: qué consume cada "Corte" de los
// productos del propio inventario (shampoo, cera, tinte...). Al vender el servicio, el stock
// de cada insumo baja solo — el barbero no tiene que registrar nada aparte.
//
// El insumo es otro ShopProduct+variante del mismo local, así que se compra y se cuenta con
// las mismas herramientas que el resto del inventario (Registrar compra / Recuento físico).
model ShopServiceSupply {
  id           String @id @default(cuid())
  restaurantId String

  // Servicio que consume el insumo (ej. "Corte de Cabello").
  serviceProductId String
  // Insumo consumido, identificado igual que en las ventas: producto + variante por contenido.
  supplyProductId  String
  supplyV1         String
  supplyV2         String @default("")
  // Cuánto se consume por servicio, en la MISMA unidad en que se lleva el stock del insumo.
  // Un pote de cera que rinde 40 cortes se carga como 0.025 (= 1/40).
  quantity         Float

  createdAt DateTime @default(now())

  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  serviceProduct ShopProduct @relation("ShopServiceSupplyService", fields: [serviceProductId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([serviceProductId])
  @@map("shop_service_supplies")
}

// Compra a proveedor que repone stock (suma unidades, a diferencia de un ajuste de inventario).
model ShopPurchase {
  id           String @id @default(cuid())
  restaurantId String

  supplier    String
  productId   String?
  productName String
  v1          String
  v2          String
  qty         Float
  cost        Float
  time        DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("shop_purchases")
}

// Corrección manual de stock (recuento físico/auditoría): fija el stock a la cantidad contada
// en vez de sumarle unidades, a diferencia de ShopPurchase.
model ShopStockAdjustment {
  id           String @id @default(cuid())
  restaurantId String

  productId   String?
  productName String
  v1          String
  v2          String
  before      Float
  after       Float
  diff        Float
  reason      String
  time        DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("shop_stock_adjustments")
}

// Apertura/cierre de caja del POS de Shop — closedAt null = caja abierta actualmente (a lo sumo
// una por restaurante). Al cerrar se congela el arqueo, igual que CashSession.closingSummary.
model ShopCashSession {
  id           String @id @default(cuid())
  restaurantId String

  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  opening    Float
  salesCount Int?
  totalSales Float?
  expected   Float?
  counted    Float?
  diff       Float?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("shop_cash_sessions")
}

// Categorías/subcategorías del catálogo — el dueño las va creando desde Inventario, no están
// atadas a un rubro en particular (cualquier Local Comercial organiza el suyo desde cero).
model ShopCategory {
  id           String @id @default(cuid())
  restaurantId String
  name         String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name])
  @@map("shop_categories")
}

model ShopSubcategory {
  id           String @id @default(cuid())
  restaurantId String
  category     String
  name         String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, category, name])
  @@map("shop_subcategories")
}

// ----------------------------------------------------------------------------
// Tienda virtual del Local Comercial: pedidos que entran por el catálogo público
// (/tienda/:slug), antes de convertirse en una venta del POS.
//
// Es un modelo aparte de ShopSale a propósito: una venta es algo que YA ocurrió
// (cobrada, stock descontado, dentro de los reportes), mientras que un pedido
// online está pendiente hasta que el dueño lo acepta. Al confirmarlo se crea la
// ShopSale correspondiente y se guarda su id en `shopSaleId` — de ahí en
// adelante el pedido es solo el historial de cómo entró.
// ----------------------------------------------------------------------------
model ShopOrder {
  id           String @id @default(cuid())
  restaurantId String

  // Correlativo por local, para que el dueño y el cliente hablen del "pedido #12".
  orderNumber Int

  // 'PICKUP' = pasa buscando por la tienda | 'DELIVERY' = se le lleva a la dirección.
  mode   String
  // 'PENDING' (recién llegado, sin atender) | 'CONFIRMED' (aceptado, ya generó la venta)
  // | 'CANCELLED'. No hay estados intermedios: el local confirma cuando va a despacharlo.
  status String @default("PENDING")

  customerName    String
  customerPhone   String
  // Solo en DELIVERY. Incluye el enlace de mapa cuando el cliente compartió su ubicación,
  // mismo criterio que Order.customerAddress del vertical restaurante.
  customerAddress String?
  note            String?

  // Método de pago que eligió el cliente (MOBILE_PAYMENT, ZELLE, CASH…), congelado.
  paymentMethod String?

  // Importes congelados al momento del pedido: si mañana suben los precios o cambia la
  // tasa, lo que el cliente aceptó pagar no se mueve (mismo criterio que Order).
  subtotal     Float
  deliveryFee  Float  @default(0)
  total        Float
  exchangeRate Float?
  totalBs      Float?

  // Venta generada al confirmar. Sin relación FK: si la venta se borra o se devuelve, el
  // pedido histórico no se toca (mismo criterio que ShopSaleItem.productId).
  shopSaleId String?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  cancelledAt DateTime?

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      ShopOrderItem[]

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@map("shop_orders")
}

// Línea del pedido online. Snapshotea lo mismo que ShopSaleItem para poder crear la venta
// al confirmar sin volver a mirar el catálogo (que pudo cambiar mientras tanto).
model ShopOrderItem {
  id      String @id @default(cuid())
  orderId String

  // Informativo, sin relación FK — igual que ShopSaleItem.productId.
  productId    String?
  v1           String
  v2           String
  name         String
  category     String?
  qty          Float
  price        Float
  cost         Float
  soldByWeight Boolean @default(false)

  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shop_order_items")
}

// ============================================================================
//  QUICKTAP CLUB (businessType = SPORTS_CLUB) — Canchas de pádel y clubes
//  deportivos. Reservas por franja horaria, con precio de hora pico/valle.
//  Sin relación con Table/Order/Reservation: aquello es del vertical restaurante
//  y no sabe de duraciones ni de solapamientos.
// ============================================================================

enum ClubSport {
  PADEL
  TENIS
  FUTBOL
  BASQUET
  OTRO
}

// Qué ocupa la cancha. Reservas, mantenimiento, clases y torneos comparten UNA
// sola tabla a propósito: así una única restricción de exclusión los protege a
// todos entre sí (un bloqueo por lluvia no puede pisar una reserva ya hecha), y
// el calendario se arma con una sola consulta.
enum ClubBlockKind {
  BOOKING // Reserva de un jugador
  MAINTENANCE // Bloqueo técnico (cristales, lluvia, cambio de red)
  CLASS // Clase de academia
  TOURNAMENT // Partido de torneo
}

enum ClubBlockStatus {
  ACTIVE
  CANCELLED
}

enum ClubBookingStatus {
  PENDING_PAYMENT // Reservada, aún sin cobrar
  CONFIRMED // Pagada (total o parcialmente, según la política del club)
  COMPLETED // Jugada: hubo check-in y ya pasó la hora
  CANCELLED
  NO_SHOW // No se presentó: pasó la hora sin check-in
}

/// Cómo está cerrada la cancha. Cambia el precio y la experiencia (se juega con
/// lluvia o no), así que el jugador lo ve en el enlace público.
enum ClubCourtType {
  LIBRE // al aire libre, sin techo
  TECHADA // techo sobre la pista, laterales abiertos
  INDOOR // cerrada por completo
}

model ClubCourt {
  id           String        @id @default(cuid())
  restaurantId String
  name         String // "Cancha 1", "Central"
  sport        ClubSport     @default(PADEL)
  courtType    ClubCourtType @default(LIBRE)
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  schedules  ClubSchedule[]
  blocks     ClubCourtBlock[]
  /// Tablets fijas montadas en esta cancha (rol CANCHA).
  tablets    User[]           @relation("UserClubCourt")

  @@index([restaurantId, active])
  @@map("club_courts")
}

// Franja de apertura con su precio. La "hora pico" no es un campo aparte: es
// simplemente otra franja del mismo día con otro precio (18:00-22:00 más cara
// que 08:00-14:00). `courtId` null = la franja aplica a todas las canchas.
model ClubSchedule {
  id           String  @id @default(cuid())
  restaurantId String
  courtId      String?

  weekday   Int // 0 = domingo … 6 = sábado
  startTime String // "HH:mm" hora local del club
  endTime   String // "HH:mm" — exclusivo

  // Duración de la franja reservable. Un club suele vender 60 y 90 min; se
  // cargan como dos horarios distintos sobre el mismo tramo si hace falta.
  slotMinutes Int @default(90)

  priceBase Decimal @db.Decimal(12, 2)
  isPeak    Boolean @default(false)
  active    Boolean @default(true)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  court      ClubCourt? @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([restaurantId, weekday])
  @@index([courtId])
  @@map("club_schedules")
}

// Tabla central del calendario. El intervalo es SEMIABIERTO [startsAt, endsAt):
// una reserva 18:00-19:00 y otra 19:00-20:00 NO se solapan.
//
// El doble booking se previene con una restricción EXCLUDE de PostgreSQL sobre
// (courtId, tstzrange) filtrada a status <> 'CANCELLED' — ver la migración. Una
// validación en el servicio no basta: dos jugadores que reservan en el mismo
// segundo pasan ambos la comprobación y ambos insertan.
model ClubCourtBlock {
  id           String @id @default(cuid())
  restaurantId String
  courtId      String

  kind   ClubBlockKind
  status ClubBlockStatus @default(ACTIVE)

  startsAt DateTime
  endsAt   DateTime

  note      String? // Motivo del mantenimiento, nombre del torneo, etc.
  createdAt DateTime @default(now())

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  court      ClubCourt    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  booking    ClubBooking?

  @@index([restaurantId, startsAt])
  @@index([courtId, startsAt])
  @@map("club_court_blocks")
}

model ClubBooking {
  id           String @id @default(cuid())
  restaurantId String
  blockId      String @unique

  // El jugador que reserva. `customerId` ata la reserva al CRM (historial de
  // consumo); nombre, teléfono y cédula se copian igual para que la reserva se
  // sostenga sola aunque el cliente se borre.
  customerId     String?
  playerName     String
  playerPhone    String
  // Obligatoria cuando reserva el jugador desde la web; opcional cuando la carga
  // recepción, porque por teléfono no siempre la dan y no debe trabar el mostrador.
  playerIdNumber String?

  // Congelados al reservar, como en Order: si mañana sube la tasa o el precio de
  // la hora pico, una reserva ya hecha no cambia de precio.
  totalBase    Decimal @db.Decimal(12, 2)
  exchangeRate Decimal @db.Decimal(12, 4)
  totalBs      Decimal @db.Decimal(14, 2)

  // Cuántos jugadores van a dividir el pago (Fase 3). Se guarda desde el inicio
  // porque define el reparto de céntimos y no debe cambiar tras cobrar.
  playerCount Int @default(4)

  // Extras que el jugador pidió tener listos al llegar (agua, pelotas, alquiler
  // de pala). Snapshot JSON a propósito: todavía NO está vinculado al catálogo
  // real de la tienda (ShopProduct), así que no tiene precio ni descuenta stock
  // — es una nota para recepción. Al vincularlo pasará a cobrarse de verdad.
  requestedExtras Json?

  // Nombres de los jugadores cuando la reserva es de 6+ y el jugador confirmó que
  // van a jugar un Americano/Mexicano al reservar. Snapshot de string[] — solo
  // prellena ClubTournamentScreen en la tablet de la cancha, no crea el torneo
  // solo: el personal lo arranca desde ahí con los nombres ya cargados.
  tournamentPlayerNames Json?

  status ClubBookingStatus @default(PENDING_PAYMENT)

  // Cta. abierta / "Deuda" (botón de Caja) — recepción marca que sabe que esto se debe y le hace
  // seguimiento, igual que Order.awaitingPayment. No implica nada sobre cuánto se ha cobrado:
  // eso vive en `payments`, esto es solo la bandera de seguimiento.
  awaitingPayment Boolean @default(false)

  // Token opaco del QR de acceso — mismo patrón que Table.qrToken: no codifica
  // datos de la reserva, solo identifica. El servidor resuelve y valida.
  accessToken String @unique

  checkedInAt DateTime? // Lo marca el escáner de recepción
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  restaurant Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  block      ClubCourtBlock       @relation(fields: [blockId], references: [id], onDelete: Cascade)
  customer   Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments   ClubBookingPayment[]
  // Lo que el jugador fue pidiendo desde la tablet de la cancha. Se cobra junto
  // con la cancha en la misma Caja — ver `withBookingMoney` en club.service.ts.
  tabOrders  ClubTabOrder[]

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([customerId])
  @@map("club_bookings")
}

// Cobro de la Caja de canchas — mismo patrón que OrderPayment: varios pagos por
// reserva (pago completo, o fraccionado entre los jugadores), cada uno con su
// propio método/referencia/comprobante. Sin descuento ni ajuste de servicio (a
// diferencia de OrderPayment): una reserva es una sola línea, no hay ítems ni
// cargo de servicio que ajustar puntualmente.
model ClubBookingPayment {
  id              String        @id @default(cuid())
  bookingId       String
  amountBase      Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  referenceNumber String?
  proofImageUrl   String?
  createdAt       DateTime      @default(now())

  booking ClubBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("club_booking_payments")
}

// ============================================================================
//  Vínculo club ↔ restaurante y consumo en cancha
// ============================================================================
//  Un club deportivo casi nunca cocina: terceriza la barra/cocina en un
//  restaurante vecino que ya usa QuickTap. El restaurante genera un código en
//  sus Ajustes, el club lo canjea en los suyos, y a partir de ahí las comandas
//  que los jugadores piden desde la tablet de la cancha le llegan al
//  restaurante con el nombre de la cancha haciendo de "mesa".
//
//  El dinero NO cambia de tenant: el consumo se suma a la reserva y se cobra en
//  la Caja del club, junto con la cancha. Al restaurante le llega la comanda
//  para preparar y llevar, no una venta.
// ============================================================================

/// Código de un solo uso que el restaurante genera para que un club se vincule.
/// Vive 1 hora (ver CLUB_LINK_CODE_TTL_MINUTES en club-link.service.ts).
model ClubLinkCode {
  id           String    @id @default(cuid())
  restaurantId String
  code         String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  usedByClubId String?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation("ClubLinkCodeRestaurant", fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, expiresAt])
  @@map("club_link_codes")
}

/// Vínculo activo. Un club tiene un solo restaurante que le prepara los pedidos
/// (de ahí el @unique en clubId); un restaurante sí puede atender varios clubes.
model ClubRestaurantLink {
  id           String   @id @default(cuid())
  clubId       String   @unique
  restaurantId String
  createdAt    DateTime @default(now())

  club       Restaurant @relation("ClubRestaurantLinkClub", fields: [clubId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation("ClubRestaurantLinkRestaurant", fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("club_restaurant_links")
}

enum ClubTabOrderStatus {
  PENDING // recién pedido desde la tablet
  PREPARING // el restaurante lo aceptó
  DELIVERED // ya se llevó a la cancha
  CANCELLED
}

enum ClubTabItemSource {
  CLUB_STORE // ShopProduct del propio club (descuenta stock)
  RESTAURANT // Product del restaurante vinculado (genera comanda, no toca stock del club)
}

/// Un pedido hecho desde la tablet de la cancha. Vive en el tenant del CLUB
/// (`restaurantId`), porque ahí es donde se cobra. `kitchenRestaurantId` es el
/// restaurante vinculado que debe prepararlo: lo resuelve el servidor desde
/// ClubRestaurantLink, nunca llega del cliente.
model ClubTabOrder {
  id           String             @id @default(cuid())
  restaurantId String
  bookingId    String
  /// Snapshot del nombre de la cancha ("Cancha 2") — es la "mesa" que ve el
  /// restaurante para saber a dónde llevar los productos. Congelado a propósito:
  /// si luego renombran la cancha, la comanda vieja no debe cambiar.
  courtName    String
  status       ClubTabOrderStatus @default(PENDING)

  totalBase    Decimal @db.Decimal(12, 2)
  exchangeRate Decimal @db.Decimal(12, 4)
  totalBs      Decimal @db.Decimal(14, 2)

  kitchenRestaurantId String?
  deliveredAt         DateTime?
  createdAt           DateTime  @default(now())

  restaurant Restaurant    @relation("ClubTabOrderClub", fields: [restaurantId], references: [id], onDelete: Cascade)
  kitchen    Restaurant?   @relation("ClubTabOrderKitchen", fields: [kitchenRestaurantId], references: [id], onDelete: SetNull)
  booking    ClubBooking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  items      ClubTabItem[]

  @@index([restaurantId, status])
  @@index([bookingId])
  @@index([kitchenRestaurantId, status])
  @@map("club_tab_orders")
}

/// Línea de un pedido de cancha. Congela nombre y precio al momento del pedido,
/// igual que OrderItem — el catálogo puede cambiar después.
model ClubTabItem {
  id              String            @id @default(cuid())
  tabOrderId      String
  source          ClubTabItemSource
  /// ShopProduct.id o Product.id según `source`. Informativo, sin FK: el producto
  /// del restaurante vive en otro tenant y puede borrarse.
  sourceProductId String?
  /// Variante del ShopProduct a descontar (los productos de la tienda del club
  /// se crean con una única variante "Unidad" — ver clubStoreApi.ts).
  variantV1       String?
  productName     String
  unitPrice       Decimal           @db.Decimal(12, 2)
  quantity        Int               @default(1)
  lineTotal       Decimal           @db.Decimal(12, 2)

  order ClubTabOrder @relation(fields: [tabOrderId], references: [id], onDelete: Cascade)

  @@index([tabOrderId])
  @@map("club_tab_items")
}

// ============================================================================
//  Torneos sociales de pádel (Americano / Mexicano)
// ============================================================================
//  Un torneo social no es un cuadro de eliminatorias: los jugadores compiten
//  INDIVIDUALMENTE y cambian de pareja en cada ronda. Los puntos que anota tu
//  pareja son tuyos, y la clasificación es la suma de todo lo que anotaste.
//
//  Americano: las parejas rotan buscando que juegues con y contra todo el
//  mundo — los cruces salen de un reparto equitativo (ver generateAmericano).
//  Mexicano: los cruces salen de la tabla de posiciones de la ronda anterior
//  (1º+4º vs 2º+3º), así que los que van ganando siempre se enfrentan entre sí.
//
//  Se corre desde la tablet de la cancha, que es donde están los jugadores.
// ============================================================================

enum ClubTournamentFormat {
  AMERICANO
  MEXICANO
}

enum ClubTournamentStatus {
  RUNNING
  FINISHED
}

/// Cómo se decide que un partido terminó.
enum ClubTournamentScoring {
  POINTS // se juega hasta repartir `pointsPerMatch` puntos entre los dos equipos
  TIME // se juega `minutesPerRound` minutos y vale el marcador que quede
}

model ClubTournament {
  id              String                @id @default(cuid())
  restaurantId    String
  name            String
  format          ClubTournamentFormat
  scoring         ClubTournamentScoring @default(POINTS)
  /// Puntos que se reparten en cada partido (modo POINTS). Ej: 24 → 16-8, 13-11…
  pointsPerMatch  Int                   @default(24)
  /// Duración de cada ronda en minutos (modo TIME).
  minutesPerRound Int                   @default(15)
  /// Canchas donde se juega, en orden. Se congelan los nombres: el torneo es de
  /// una tarde y renombrar una cancha después no debe reescribir su historia.
  courtNames      Json
  status          ClubTournamentStatus  @default(RUNNING)
  /// Última ronda generada. 0 = todavía ninguna.
  currentRound    Int                   @default(0)
  createdAt       DateTime              @default(now())
  finishedAt      DateTime?

  restaurant Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  players    ClubTournamentPlayer[]
  matches    ClubTournamentMatch[]

  @@index([restaurantId, status])
  @@map("club_tournaments")
}

model ClubTournamentPlayer {
  id           String @id @default(cuid())
  tournamentId String
  name         String
  sortOrder    Int    @default(0)

  tournament ClubTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("club_tournament_players")
}

/// Un partido de una ronda: dos parejas, una cancha y un marcador.
/// Los cuatro jugadores se guardan sueltos (no hay entidad "pareja") porque la
/// pareja solo existe durante este partido — en la ronda siguiente se deshace.
model ClubTournamentMatch {
  id           String @id @default(cuid())
  tournamentId String
  round        Int
  /// Nombre de la cancha donde se juega, congelado (ver courtNames).
  courtName    String

  teamAPlayer1Id String
  teamAPlayer2Id String
  teamBPlayer1Id String
  teamBPlayer2Id String

  /// Null = todavía no se cargó el resultado.
  scoreA Int?
  scoreB Int?

  createdAt DateTime  @default(now())
  playedAt  DateTime?

  tournament ClubTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, round])
  @@map("club_tournament_matches")
}
