// ============================================================================
//  QuickTap.club — Esquema de base de datos (PostgreSQL + Prisma)
//  SaaS multi-inquilino para restaurantes.
//
//  Estrategia de aislamiento (multi-tenancy):
//  ------------------------------------------------------------------
//  Modelo "shared database, shared schema": TODAS las tablas de dominio
//  cuelgan de `restaurantId`. Cada consulta DEBE filtrarse por ese campo
//  (lo garantiza el `tenant.middleware` + los servicios). Los índices
//  compuestos `@@index([restaurantId, ...])` mantienen el rendimiento
//  aislado por inquilino.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
//  ENUMS
// ----------------------------------------------------------------------------

enum UserRole {
  OWNER // dueño del restaurante (acceso total)
  STAFF // deprecado: alias de acceso total, ya no se asigna desde la UI de Equipo
  ADMIN // Administrador (acceso total)
  CASHIER // Cajero (acceso total)
  WAITER // Mesero (solo Cocina + Órdenes de Mesa)
  // Tablet compartida de meseros: pantalla de solo un teclado de 4 dígitos. El mesero no
  // elige su nombre — la clave sola identifica cuál WAITER es (ver auth.service.ts
  // identifyWaiterByPin). Por eso la clave de un WAITER debe ser única dentro del restaurante.
  WAITER_TABLET
  KITCHEN // Cocina (solo Cocina + Órdenes de Mesa)
  SCREEN // Pantalla (vista horizontal de Mesas + Cocina, para un monitor/TV)
  COMANDA // Kiosco de autoservicio (tablet en modo tótem, el cliente pide sin mesero)
  NUMERO // Pantalla que solo muestra avisos de "listo" de Autoservicio/Pickup (mostrador)
  CANCHA // Tablet fija en una cancha (club deportivo): el jugador escanea su QR y pide desde ahí
  COACH // Profesor de la academia: solo su agenda, pasar lista y sus honorarios
  VERIFICADOR // Puerta de un evento: escanea entradas y puede vender en el sitio
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

enum MovementType {
  INCOME
  EXPENSE
}

// Tipo de un ingreso manual (botón "Añadir ingreso" en Ventas de hoy / Administración).
enum IncomeCategory {
  TIP // Propina
  DEBT // Cobro de una deuda pendiente del cliente
  OTHER // Otro ingreso
}

// Categoría de un egreso (módulo de Gastos en Administración).
enum ExpenseCategory {
  UTILITIES // Servicios públicos
  SUPPLIES // Compra de producto e insumos
  RENT // Arriendo
  PAYROLL // Nómina
  ADMINISTRATIVE // Gastos administrativos
  MARKETING // Mercadeo y Publicidad
  TRANSPORT // Transporte (fletes, encomiendas, taxis)
  MAINTENANCE // Mantenimiento
  FURNITURE // Muebles
  // --- Gastos de operación/viaje: se llevan igual que los de arriba, pero se separan
  // para que el reporte por categoría no los mezcle todos en "Transporte" u "Otros". ---
  FUEL // Combustible / gasolina
  TRAVEL // Viáticos y viajes
  MEALS // Comidas
  LODGING // Hospedaje / hotel
  OTHER // Otros
}

// Soporte documental de un gasto: factura fiscal (deducible/declarable) vs. nota de entrega
// (el proveedor no maneja factura fiscal, solo comprobante de despacho).
enum ExpenseDocumentType {
  FISCAL_INVOICE // Factura fiscal
  DELIVERY_NOTE // Nota de entrega
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

// Solicitud del comensal desde el menú público, mostrada como aviso en el
// plano de mesas hasta que el mesero la atiende.
enum ServiceRequestType {
  WAITER_CALL // "Llamar al mesonero"
  BILL_REQUEST // "Pedir la cuenta"
}

enum OrderStatus {
  NEEDS_CONFIRMATION // En mesa, esperando que el mesero acepte el pedido (solo si el restaurante lo exige)
  NEEDS_PAYMENT // Pedido de kiosco (rol Comanda): espera que caja confirme el cobro antes de ir a cocina
  PENDING // Pendiente (recién creada)
  KITCHEN // En Cocina (enviada a la ticketera)
  SERVED // Servido / Entregado
  CANCELLED // Cancelado
}

enum OrderChannel {
  DINE_IN // Canal en mesa (QR de la mesa)
  DELIVERY // Delivery a domicilio
  PICKUP // Retiro en local
  BAR // Pedido en barra, sin mesa (igual que Pickup pero sin retiro externo)
  EXPRESS // Venta de mostrador al paso: sin mesa y sin datos del cliente
}

enum Currency {
  USD
  EUR
}

// Vertical de negocio del tenant. RESTAURANT es el producto original (mesas/comandas/cocina);
// SHOP es el vertical de retail (POS por SKU/variantes, inventario, sin mesas ni cocina);
// SPORTS_CLUB es el vertical de clubes deportivos (canchas reservables por franja horaria) —
// ver AdminLayout, que renderiza un panel completamente distinto según este campo.
enum BusinessType {
  RESTAURANT
  SHOP
  SPORTS_CLUB
  /// Administrativo: contabilidad y administración de una o varias empresas, sin punto de
  /// venta ni catálogo. Es el único vertical donde el inquilino no ES el negocio sino quien lo
  /// administra — por eso todo cuelga de Company y no de Restaurant (ver ese modelo).
  ADMIN_OFFICE
}

// ─────────────────────────────────────────────────────────────────────────────
//  Vertical Administrativo: contabilidad y administración multi-empresa.
// ─────────────────────────────────────────────────────────────────────────────

/// Naturaleza de una cuenta contable. Decide de qué lado suma: un activo y un gasto crecen
/// al debe, un pasivo, el patrimonio y los ingresos crecen al haber.
enum AccountKind {
  ASSET // Activo
  LIABILITY // Pasivo
  EQUITY // Patrimonio
  INCOME // Ingreso
  EXPENSE // Gasto
}

/// Una empresa administrada. Es la pieza central de este vertical: un contador o un
/// administrador lleva varias a la vez desde la misma cuenta, y TODO lo contable cuelga de
/// acá, no del Restaurant. Sin esto habría que crear un inquilino por empresa y obligar a
/// cerrar sesión para cambiar de una a otra.
model Company {
  id           String @id @default(cuid())
  restaurantId String

  name                 String
  /// RIF / NIT / CUIT: el identificador fiscal, como lo llame el país.
  taxId                String?
  address              String?
  phone                String?
  email                String?
  logoUrl              String?
  /// Moneda en la que se llevan los libros de ESTA empresa. Dos empresas del mismo
  /// administrador pueden llevarse en monedas distintas.
  currency             Currency @default(USD)
  /// Mes en que arranca el ejercicio (1 = enero). No todas cierran en diciembre.
  fiscalYearStartMonth Int      @default(1)
  active               Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  accounts   LedgerAccount[]
  entries    JournalEntry[]
  contacts   BusinessContact[]

  @@index([restaurantId, active])
  @@map("companies")
}

/// Cuenta del plan contable. `code` es el número con el que se la nombra en el balance
/// ("1.1.01 Caja"), y el árbol se arma con `parentId` para poder totalizar por rama.
model LedgerAccount {
  id        String @id @default(cuid())
  companyId String

  code     String
  name     String
  kind     AccountKind
  parentId String?
  /// Solo las cuentas de detalle reciben asientos; las de agrupación totalizan a sus hijas.
  postable Boolean     @default(true)
  active   Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   LedgerAccount?  @relation("PlanDeCuentas", fields: [parentId], references: [id], onDelete: SetNull)
  children LedgerAccount[] @relation("PlanDeCuentas")
  lines    JournalLine[]

  @@unique([companyId, code])
  @@index([companyId, kind])
  @@map("ledger_accounts")
}

/// Asiento contable. Agrupa las líneas de una operación; la suma del debe tiene que igualar
/// a la del haber, y eso se valida al guardar.
model JournalEntry {
  id        String @id @default(cuid())
  companyId String

  /// Correlativo por empresa, para poder citar "el asiento 143".
  number      Int
  date        DateTime
  description String
  /// De dónde salió: cargado a mano, importado, o generado por otro módulo.
  source      String    @default("MANUAL")
  reference   String?
  /// Un asiento anulado no se borra: se marca y se contra-asienta, porque un libro con
  /// agujeros no es un libro.
  voidedAt    DateTime?
  voidReason  String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   JournalLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@map("journal_entries")
}

/// Línea de un asiento: una cuenta y un monto, al debe o al haber.
model JournalLine {
  id        String @id @default(cuid())
  entryId   String
  accountId String

  /// Exactamente uno de los dos es mayor a cero.
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  detail    String?
  /// Contra quién es la operación, cuando aplica (cliente, proveedor, empleado).
  contactId String?

  entry   JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account LedgerAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  contact BusinessContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

/// Cliente, proveedor o empleado de una empresa. Uno solo puede ser varias cosas a la vez
/// —hay proveedores que también compran— así que son banderas y no un tipo único.
model BusinessContact {
  id        String @id @default(cuid())
  companyId String

  name       String
  taxId      String?
  email      String?
  phone      String?
  address    String?
  isCustomer Boolean @default(false)
  isSupplier Boolean @default(false)
  isEmployee Boolean @default(false)
  notes      String?
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   JournalLine[]

  @@index([companyId, active])
  @@map("business_contacts")
}

enum PaymentMethod {
  MOBILE_PAYMENT // Pago Móvil
  ZELLE
  CASH // Efectivo Bs
  CASH_USD // Efectivo $
  CARD // Punto de venta / tarjeta
  BINANCE
  PAYPAL
  TRANSFER // Transferencia bancaria
}

// Cómo se calcula el costo de envío del checkout de delivery.
enum DeliveryPricingMode {
  DISABLED // Sin cobro de envío
  DISTANCE // Tarifa base + precio por Km, desde la ubicación del restaurante
  ZONE // Precio fijo según la zona (polígono) donde caiga la ubicación del cliente
}

// ----------------------------------------------------------------------------
//  SUSCRIPCIÓN A QUICKTAP (leads de la landing, no confundir con PaymentMethod
//  de arriba, que es el checkout del comensal en el menú público)
// ----------------------------------------------------------------------------

enum SubscriptionPlan {
  TRIAL // Prueba gratuita (15 días)
  STARTER // Plan Inicial
  PRO // Plan Pro / Restaurante
  PREMIUM // Plan Premium / Grandes Formatos
  DELIVERY // Plan Solo Delivery: Cocina + pedidos por WhatsApp, sin mesas/QR
  CUSTOM // Plan Personalizado (por sumatoria de mesas/usuarios/pedidos)
  SUCURSALES // [Legado, ya no se ofrece] Todos los beneficios de Pro + hasta 5 sucursales
  DELIVERY_SUCURSALES // [Legado, ya no se ofrece] Plan Solo Delivery + hasta 5 sucursales
  ELITE // Todos los beneficios de Pro + sucursales ilimitadas + soporte prioritario
  SHOP // Plan base de QuickTap Shop (businessType SHOP): operación diaria + CRM, sin contabilidad avanzada ni sucursales
  ELITE_SHOP // Plan Elite de QuickTap Shop: todo lo del Shop + órdenes de pago, contabilidad, bancos, proveedores, libros y sucursales
  CLUB // Plan único de QuickTap Club (businessType SPORTS_CLUB — Canchas)
  OFFICE // Plan único del vertical Administrativo (businessType ADMIN_OFFICE): contabilidad multi-empresa
}

enum BillingCycle {
  MONTHLY
  QUARTERLY // 3 meses
  SEMIANNUAL // 6 meses
  ANNUAL // 12 meses
}

enum SubscriptionPaymentMethod {
  PAGO_MOVIL
  BINANCE
  BANK_TRANSFER
  // Pago vía pasarela Ramblay (C2P / Binance Pay): la aprobación llega sola
  // por webhook, no por revisión manual de comprobante (ver PlanRequest.ramblayPaymentId).
  RAMBLAY
}

// Estado persistido de la suscripción. El bloqueo (cuando vence `periodEnd` +
// 12h de gracia sin pago) se CALCULA en tiempo real (ver subscription.util.ts),
// nunca se persiste como un tercer estado: así, extender `periodEnd` siempre
// "desbloquea" automáticamente sin dejar banderas desincronizadas.
enum RestaurantSubscriptionStatus {
  TRIALING
  ACTIVE
}

// Comprobante de pago: de inscripción (antes de existir la cuenta, sin
// restaurantId todavía) o de mensualidad (ya autenticado, siempre con
// restaurantId). El admin de plataforma los revisa y "activa" la cuenta.
enum PlanRequestKind {
  SIGNUP
  RENEWAL
  // Mejora de plan a mitad de período: paga solo la diferencia prorrateada por los días que
  // le quedan, y al aprobarse el plan cambia SIN mover periodEnd (ver applyActivation).
  UPGRADE
}

enum PlanRequestStatus {
  PENDING
  APPROVED
  REJECTED // El comprobante no es válido (ej. monto incorrecto, imagen falsa).
  PAYMENT_NOT_RECEIVED // Aún no se refleja el pago en la cuenta del restaurante.
}

// Duración del código de descuento, contada desde su creación.
enum PromoCodeDurationUnit {
  HOUR
  DAY
  MONTH
  YEAR
}

// Solicitud de cotización de QR físicos con tecnología NFC (impermeables, con
// protección UV). El restaurante ya está autenticado; no requiere comprobante
// de pago, solo se revisa y se contacta manualmente desde el Dashboard maestro.
enum QrNfcRequestStatus {
  PENDING
  APPROVED
}

// ----------------------------------------------------------------------------
//  TENANT: Restaurant + Users
// ----------------------------------------------------------------------------

model Restaurant {
  id   String @id @default(cuid())
  // Slug único para la URL pública: quicktap.club/:slug
  slug String @unique

  name        String
  description String?
  logoUrl     String?

  // --- Vertical de negocio (elegido al registrarse, no editable desde el panel) ---
  businessType    BusinessType @default(RESTAURANT)
  // Rubro de retail elegido en el registro (ej: "zapateria", "panaderia") cuando
  // businessType = SHOP. Indexa el catálogo de ejemplo en web/src/data/shopRubros.ts.
  // Null para restaurantes.
  shopRubro       String?
  // Costo de envío de la tienda virtual del local, en su moneda base. Tarifa plana y no
  // zonas/distancia como el delivery del restaurante: un local despacha con su propio
  // motorizado y cobra lo mismo a todo el mundo. 0 = envío sin cargo.
  shopDeliveryFee Decimal?     @db.Decimal(10, 2)

  // --- Configuración de moneda ---
  // Moneda en la que el restaurante coloca sus precios ($ o €).
  // Por defecto la conversión a Bs se resuelve con la tasa BCV vigente (tabla
  // ExchangeRate, global). Si el restaurante activa `exchangeRateManual`, se usa
  // en cambio `manualExchangeRateBs` (fijo hasta que el propio restaurante lo
  // vuelva a editar) — ver exchangeRateService.getRate().
  baseCurrency         Currency @default(USD)
  exchangeRateManual   Boolean  @default(false)
  manualExchangeRateBs Decimal? @db.Decimal(12, 4)
  // Doble precio (Local Comercial): tasa propia para Pago Móvil/Transferencia en el POS,
  // normalmente más alta que la de referencia — el precio en $ del catálogo no cambia, solo
  // el monto en Bs que se cobra por esos dos métodos. Null = sin doble precio configurado,
  // esos métodos siguen usando la tasa de referencia como siempre. Ver ShopPosPage.tsx.
  shopBsSaleRate       Decimal? @db.Decimal(12, 4)

  // --- Contacto / checkout ---
  // Número de WhatsApp en formato internacional SIN "+" (ej: 584141234567).
  whatsappPhone                String?
  // Plantilla personalizable del mensaje de WhatsApp que el mesero/cajero le
  // envía al cliente con su comanda (botón "Enviar vía WhatsApp" en Pedidos).
  // Placeholders disponibles: {{header}}, {{items}}, {{totales}}. Si es null,
  // se usa DEFAULT_COMANDA_WHATSAPP_TEMPLATE (src/utils/whatsapp.ts).
  whatsappOrderMessageTemplate String?

  // --- Chatbot de WhatsApp (vinculado por QR, ver whatsapp-bot.service.ts) ---
  // Interruptor maestro: si está apagado, no se manda ningún mensaje automático
  // aunque la sesión siga vinculada (permite pausar sin desvincular el número).
  whatsappBotEnabled              Boolean @default(false)
  // Número vinculado tal como lo reporta la sesión de WhatsApp (solo informativo,
  // para mostrar "Conectado como +58..." en Ajustes) — no se usa para enviar.
  whatsappBotConnectedNumber      String?
  // Qué eventos del ciclo de vida del pedido disparan un mensaje automático.
  whatsappBotNotifyReceived       Boolean @default(true)
  whatsappBotNotifyReady          Boolean @default(true)
  // Respuesta automática con el saludo + enlace del menú a cada mensaje de texto que escribe un
  // cliente (sin enfriamiento: en hora pico el restaurante prefiere que conteste rápido, aunque
  // sea el mismo contacto escribiendo varias veces — ver handleIncomingMessage en whatsapp-bot.service.ts).
  whatsappBotWelcomeEnabled       Boolean @default(true)
  // Placeholders disponibles: {{restaurant}}, {{link}}. Si es null, se usa
  // DEFAULT_WELCOME_TEMPLATE (whatsapp-bot.service.ts).
  whatsappBotWelcomeMessage       String?
  // Número (solo dígitos) al que el chatbot reenvía cada comprobante de pago (modo
  // PAYMENT_VERIFICATION) o el pedido completo (modo FULL_ORDER) de un pedido
  // delivery/pickup para que el propio restaurante lo revise y responda
  // "Aprobado"/"Rechazado" — ver order-payment-verification.service.ts. null = ese
  // flujo está desactivado (el pedido sigue requiriendo aceptación manual, como hoy).
  whatsappBotPaymentVerifierPhone String?
  // 'PAYMENT_VERIFICATION' (de siempre) = solo abre verificación en métodos de pago que
  // exigen comprobante, esperando la FOTO del cliente. 'FULL_ORDER' = para cualquier
  // pedido sin importar el método de pago, manda el pedido completo al número de
  // whatsappBotPaymentVerifierPhone y espera que el negocio confirme "Aprobado" a mano
  // (sin foto) antes de pasar a cocina. Solo aplica si whatsappBotEnabled.
  whatsappOrderMode               String  @default("PAYMENT_VERIFICATION")
  // Solo clubes (SPORTS_CLUB): recordatorio automático de deudas por WhatsApp — a los
  // 3 días de la deuda y luego cada 7 mientras siga sin pagar. El cliente responde con
  // su comprobante y entra al flujo del verificador — ver club-debt-bot.service.ts.
  whatsappBotDebtRemindersEnabled Boolean @default(false)

  // --- Apariencia del menú público ---
  // Colores personalizados del menú público (fondo, botones, acentos, texto).
  // JSON flexible para poder agregar nuevas claves sin nuevas migraciones.
  theme Json?

  // --- Cargos opcionales del checkout (aplican sobre el subtotal) ---
  // Interruptor del botón en Inventario: cuando está apagado, los modificadores
  // NO descuentan insumos aunque tengan el vínculo configurado. Permite dejar
  // la configuración armada y activarla cuando el inventario esté cuadrado.
  modifierInventoryLinkEnabled Boolean @default(false)

  // Bloqueo por falta de stock (Inventario → Stock de productos). Solo aplica a los productos
  // que tienen el control de stock activado.
  //
  // ENCENDIDO: no se puede comandar más de lo que queda. Se cuenta lo que ya está pedido y sin
  // servir, no solo lo que hay en la nevera — si no, dos mesas pedirían a la vez las últimas
  // tres unidades y las dos pasarían.
  //
  // APAGADO (por defecto, comportamiento de siempre): se vende igual y el stock entra en
  // negativo (-1, -2...). Ese número negativo es útil: dice cuánto se vendió de más.
  blockOrdersWithoutStock Boolean @default(false)

  // Interruptor de la clave de pantalla (Ajustes → Pantalla de bloqueo). Apagado,
  // nadie del equipo vuelve a ver el teclado de PIN y tampoco se le exige crearlo;
  // los PIN ya configurados se conservan para cuando se vuelva a activar.
  // Arranca en `true` porque el bloqueo ya existía antes de este interruptor.
  lockScreenEnabled     Boolean  @default(true)
  serviceChargeEnabled  Boolean  @default(false) // 10% de servicio
  // Canales donde se cobra el 10%. Por defecto conserva el comportamiento histórico: todos.
  serviceChargeChannels String[] @default(["DINE_IN", "DELIVERY", "PICKUP", "BAR", "EXPRESS"])
  // Reportes con Gemini: se habilita por negocio desde Dashboard maestro, nunca en masa.
  aiReportsEnabled      Boolean  @default(false)
  // 16% de IVA. Solo lo activa el equipo QuickTap desde el Master Dashboard (no autoservicio
  // del restaurante), y solo si ya tiene `rif` registrado — ver master-restaurants.service.ts.
  ivaEnabled            Boolean  @default(false)
  // RIF fiscal del restaurante (lo escribe el restaurante en Ajustes). Distinto del `rif` que
  // vive dentro de paymentMethodsConfig, que es el RIF de una cuenta de cobro puntual.
  rif                   String?

  // Precio mensual acordado manualmente por el equipo QuickTap (ej. tarifa negociada al
  // habilitar sucursales fuera de la tabla de precios compartida) — ver Dashboard maestro →
  // Cobro. Cuando tiene valor, ES el precio que se le cobra al restaurante: manda sobre la
  // tarifa pública del plan (ver resolvePrice en plan-request.service.ts). El código
  // promocional se sigue aplicando encima, igual que sobre la tarifa pública.
  // El sufijo "Usd" quedó del nombre original: el monto se interpreta en la moneda vigente de
  // PlatformSettings.subscriptionCurrency, no siempre dólares — se dejó así para no acarrear
  // una migración de columna solo por el nombre.
  customMonthlyPriceUsd Decimal? @db.Decimal(10, 2)

  // Número de cobranza: a dónde el chatbot maestro manda el recordatorio de mensualidad y los
  // datos de pago (ver subscription-reminder.service.ts). Formato internacional sin "+". Es
  // aparte de `whatsappPhone` a propósito — ese es el número público de atención al comensal,
  // que muchas veces atiende un mesero; la cobranza va a quien realmente paga. Si está vacío se
  // cae a `whatsappPhone`, que era el destino único antes de que existiera este campo.
  billingPhone String?

  // --- Migración desde OlaClick (herramienta interna, panel master) ---
  // La API Key de OlaClick del restaurante viaja cifrada (AES-256-GCM, ver
  // master-olaclick-import.crypto.ts) y solo la usa el equipo QuickTap desde
  // /master/*, NUNCA expuesta al propio restaurante ni a rutas públicas.
  // Ver src/modules/master/master-olaclick-import.* y CLAUDE.md.
  olaclickApiKeyEncrypted String?
  olaclickLastSyncAt      DateTime?
  olaclickLastSyncSummary Json?

  // --- Control de pedidos ---
  // Si es false, el menú público queda solo para ver: sin carrito ni checkout
  // (ni en mesa ni por delivery/pickup).
  orderingEnabled           Boolean @default(true)
  // Si es true, los pedidos que el cliente envía desde la mesa (QR) quedan en
  // NEEDS_CONFIRMATION hasta que un mesero los acepte; recién ahí pasan a la
  // cocina. No aplica a pedidos cargados manualmente por el staff.
  requireOrderConfirmation  Boolean @default(false)
  // Si es false, la tablet de la cancha (vertical Canchas) deja de ofrecer
  // "Pagar": al acabarse el tiempo solo muestra el detalle de cada cuenta y su
  // monto, para que el jugador pague en persona. No afecta poder pedir.
  clubTabletPaymentsEnabled Boolean @default(true)
  // CRM: si es true, toda venta/checkout exige nombre y teléfono del cliente
  // (POS del Local, checkout de delivery). Mesa QR y reservas de cancha ya los
  // piden siempre. El interruptor vive en el CRM.
  requireCustomerData       Boolean @default(false)

  // --- Precio de delivery ---
  // Ubicación del local, usada como origen para calcular distancia al cliente.
  deliveryOriginLat   Float?
  deliveryOriginLng   Float?
  deliveryPricingMode DeliveryPricingMode @default(DISABLED)
  // Modo DISTANCE: tarifa fija + precio por Km recorrido.
  deliveryBaseFee     Decimal             @default(0) @db.Decimal(12, 2)
  deliveryPricePerKm  Decimal             @default(0) @db.Decimal(12, 2)

  // --- Despacho automático al cobrar (Ajustes → Delivery) ---
  // Al terminar de cobrar un pedido DELIVERY, abrir solo la ventana de
  // "Equipo de delivery" para que el cajero elija repartidor sin buscar el
  // pedido en la lista. No despacha nada por su cuenta.
  deliveryAutoOpenOnPaid     Boolean @default(false)
  // Un paso más: elige el repartidor automáticamente (rotación por quien
  // lleva más tiempo sin recibir un pedido) y arma su WhatsApp, sin
  // preguntar. Tiene prioridad sobre deliveryAutoOpenOnPaid.
  deliveryAutoAssignOnPaid   Boolean @default(false)
  // Independiente de los dos de arriba: elige el repartidor automáticamente
  // (misma rotación por quien lleva más tiempo sin recibir un pedido) apenas
  // se ACEPTA un pedido DELIVERY, sin esperar a que se cobre. Si el pedido
  // ya tiene repartidor asignado (por este mismo interruptor) el auto-asignado
  // al cobrar no lo vuelve a despachar (ver autoDispatchToCourier).
  deliveryAutoAssignOnAccept Boolean @default(false)

  // Métodos de pago que el restaurante ofrece a SUS clientes en el checkout
  // (distinto de PlatformSettings, que es cómo el restaurante le paga a
  // QuickTap). JSON libre: { CASH: { enabled }, MOBILE_PAYMENT: { enabled,
  // banco, telefono, cedula, titular }, ZELLE: {...}, BINANCE: {...},
  // PAYPAL: {...}, TRANSFER: {...}, CARD: { enabled } }.
  paymentMethodsConfig Json?

  // --- Modo Cartelera: imagen de pantalla completa en vez del menú ---
  fullscreenImageEnabled Boolean @default(false)
  fullscreenImageUrl     String?

  // --- Ajustes -> Pantalla: qué muestra el carrusel del rol SCREEN (ver ScreenPage.tsx) ---
  // "ALL" = todo el catálogo disponible; "CATEGORIES" = solo las categorías en
  // screenCategoryIds; "PRODUCTS" = solo los productos puntuales en screenProductIds.
  screenDisplayMode     String @default("ALL")
  // Arrays de ids como Json (mismo criterio que theme/paymentMethodsConfig en este modelo,
  // no hay precedente de String[] nativo acá) — solo se leen cuando screenDisplayMode los usa.
  screenCategoryIds     Json?
  screenProductIds      Json?
  // Segundos que cada pantalla queda fija antes de rotar a la siguiente. Opciones fijas en la UI: 3/6/10/20.
  screenPageIntervalSec Int    @default(8)
  // Productos por pantalla. Opciones fijas en la UI: 2/4/6.
  screenItemsPerPage    Int    @default(4)

  // Código de 6 dígitos (hasheado, igual que TableSession.pinHash) que el Mesero
  // debe ingresar para eliminar una comanda. Solo lo crea/cambia Dueño/Admin desde
  // Ajustes. Null = todavía no se ha configurado (el Mesero no puede eliminar).
  deleteOrderPinHash String?

  // --- Pantalla de bloqueo ---
  // Minutos de inactividad antes de re-solicitar el PIN, por rol (ej:
  // { "OWNER": 5, "CASHIER": 1, "WAITER": 10 }). Solo Dueño/Admin lo editan
  // desde Ajustes. Un rol sin entrada acá usa DEFAULT_LOCK_SCREEN_MINUTES.
  // La función está siempre activa (no hay forma de desactivarla) — este
  // mapa solo controla la frecuencia, nunca si se pide o no.
  lockScreenIntervals Json @default("{}")

  // --- Suscripción QuickTap ---
  // Arranca en TRIALING con periodEnd = registro + 15 días. Al aprobar un
  // PlanRequest (o activación manual desde el Dashboard maestro) pasa a
  // ACTIVE y periodEnd se extiende según el ciclo. El bloqueo por vencimiento
  // no se persiste: se calcula a partir de periodEnd (ver subscription.util.ts).
  subscriptionStatus RestaurantSubscriptionStatus @default(TRIALING)
  subscriptionPlan   SubscriptionPlan?
  billingCycle       BillingCycle?
  periodEnd          DateTime

  // Plan que acaba de activarse (primera vez o cambio de plan) y todavía no
  // se le mostró al restaurante la pantalla de bienvenida ("Bienvenido al
  // Club"). Se limpia (null) apenas el frontend confirma haberla mostrado.
  // No se toca en una renovación del MISMO plan (ver applyActivation()).
  pendingWelcomePlan SubscriptionPlan?

  // Marca el `periodEnd` para el que ya se mandó el recordatorio de renovación por WhatsApp
  // (ver master-whatsapp/subscription-reminder.service.ts) — evita reenviarlo en cada barrido
  // mientras siga siendo el mismo vencimiento; se vuelve a disparar solo cuando `periodEnd`
  // avanza (renovación) y vuelve a caer a 3 días o menos.
  subscriptionReminderForPeriodEnd DateTime?

  // Botón "Avisar sistema listo" del Dashboard maestro (ver master-restaurants.service.ts):
  // cuándo se le mandó por WhatsApp el aviso de instalación completa + credenciales del equipo +
  // monto a cancelar. Null = todavía no se le avisó. Solo informativo (se puede reenviar).
  installationNoticeSentAt DateTime?

  subscriptionPaymentVerifications SubscriptionPaymentVerification[]

  // --- Sucursales (Plan Sucursales / Delivery Sucursales, tope de 5) ---
  // Una sucursal es otra fila de Restaurant (reutiliza TODO el modelo tal
  // cual: catálogo, inventario, pedidos, equipo, mesas propias) enlazada a
  // su sede principal solo para el reporte consolidado y para heredar
  // plan/vigencia — no paga ni se bloquea de forma independiente (ver
  // isLockedAsync() en src/utils/subscription.ts y applyActivation()).
  parentRestaurantId String?
  parent             Restaurant?  @relation("RestaurantBranches", fields: [parentRestaurantId], references: [id])
  branches           Restaurant[] @relation("RestaurantBranches")

  // Grupo (sede principal + sucursales): "PER_BRANCH" = cada sede su propio stock (de
  // siempre); "SHARED" = una sola bolsa de stock para todas. Solo se cambia desde la
  // sede principal (ver restaurant.service.ts update()).
  inventoryMode     String  @default("PER_BRANCH")
  // Activa la ventana "Casa Matriz" (segundo inventario, aparte del normal, para
  // distribuir a la sede principal y a las sucursales). Solo aplica en la sede
  // principal — no todos los clientes de Sucursales tienen una.
  casaMatrizEnabled Boolean @default(false)

  // --- Adicionales del Plan Personalizado (CUSTOM) ---
  // Para PRO/PREMIUM el acceso a estas funciones ya viene incluido según el
  // plan (ver src/utils/subscription.ts, hasFeature()); estos 4 campos solo
  // importan cuando subscriptionPlan = CUSTOM, marcados al aprobar la
  // solicitud con esos adicionales elegidos.
  customAdministration  Boolean           @default(false)
  customInventoryBasic  Boolean           @default(false)
  customInventoryRecipe Boolean           @default(false)
  customAccountsPayable Boolean           @default(false)
  // Locales que ya tenían el plan Shop pagado cuando se separó Elite Shop:
  // conservan TODO (contabilidad, bancos, órdenes de pago…) hasta esta fecha
  // (= su periodEnd de entonces). Al renovar/activar cualquier plan se limpia
  // (ver applyActivation) y desde ahí manda solo hasFeature() por plan.
  legacyFullAccessUntil DateTime?
  // Baja de plan programada: el plan actual sigue hasta el vencimiento (sin devolución) y la
  // PRÓXIMA renovación se cobra y activa con este plan. Se limpia en cada activación.
  pendingDowngradePlan  SubscriptionPlan?
  // Bloqueo manual desde el Dashboard maestro, independiente del vencimiento
  // del plan. Si es true, la cuenta queda bloqueada sin importar periodEnd.
  suspended             Boolean           @default(false)

  // Cuenta de demostración (sembrada con `npm run seed:demo`): sus pedidos y
  // su facturación se excluyen del reporte financiero del Dashboard maestro.
  isDemo             Boolean   @default(false)
  // Última actividad (request autenticado) de un usuario en la cuenta demo —
  // solo se actualiza cuando isDemo=true. El barrido periódico (ver server.ts)
  // resetea el demo cuando esto queda viejo (pestaña cerrada/abandonada).
  demoLastActivityAt DateTime?
  // Se activa cuando alguien ingresa el código de administrador correcto
  // (Ajustes → Modo administrador). Mientras esté en true, el restaurante
  // demo queda exento del reset automático (ni el barrido de inactividad ni
  // el logout lo reinician) — así el equipo QuickTap puede dejar cambios
  // permanentes (ej. configurar sucursales) sin que se borren.
  demoAdminUnlocked  Boolean   @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  categories             Category[]
  kitchens               Kitchen[]
  products               Product[]
  tables                 Table[]
  orders                 Order[]
  zones                  Zone[]
  tableSessions          TableSession[]
  planRequests           PlanRequest[]
  qrNfcRequests          QrNfcRequest[]
  inventoryItems         InventoryItem[]
  inventoryCategories    InventoryCategory[]
  recipeIngredients      RecipeIngredient[]
  preparations           Preparation[]
  preparationIngredients PreparationIngredient[]
  deliveryCouriers       DeliveryCourier[]
  additionalCharges      AdditionalCharge[]
  /// Empresas administradas (vertical ADMIN_OFFICE).
  companies              Company[]
  customizations         Customization[]
  approvalRequests       ApprovalRequest[]

  /// Qué acciones de un administrador necesitan el visto bueno del dueño. Array de
  /// ApprovalAction; vacío o null = ninguna, que es como funcionaba antes de que esto
  /// existiera. Se deja configurable en vez de fijar una lista: cada negocio confía en su
  /// administrador para cosas distintas.
  approvalActions       Json?
  quotes                Quote[]
  deliveryZones         DeliveryZone[]
  movements             Movement[]
  paymentOrders         PaymentOrder[]
  bankAccounts          BankAccount[]
  bankTransactions      BankTransaction[]
  employees             Employee[]
  employeePayments      EmployeePayment[]
  cashSessions          CashSession[]
  suppliers             Supplier[]
  supplierRatings       SupplierRating[]
  costStructureConfig   CostStructureConfig?
  productCostStructures ProductCostStructure[]
  wasteRecords          WasteRecord[]
  customers             Customer[]
  promotions            Promotion[]
  promotionRedemptions  PromotionRedemption[]
  modifierCategories    ModifierCategory[]
  modifiers             Modifier[]
  productVariants       ProductVariant[]
  schedules             RestaurantSchedule[]
  reservations          Reservation[]
  waitlistEntries       WaitlistEntry[]
  syncConflicts         SyncConflict[]
  fiscalInvoicingConfig FiscalInvoicingConfig?

  // --- QuickTap Shop (businessType = SHOP): catálogo/ventas/caja propios, sin relación con
  // Product/Order (esos son del vertical restaurante) — ver web/src/pages/admin/shop/. ---
  shopProducts         ShopProduct[]
  shopSales            ShopSale[]
  shopOpenOrders       ShopOpenOrder[]
  shopConsumptionPlans ShopConsumptionPlan[]
  shopTickets          ShopTicket[]
  shopPurchases        ShopPurchase[]
  shopStockAdjustments ShopStockAdjustment[]
  shopCashSessions     ShopCashSession[]
  shopCategories       ShopCategory[]
  shopInstallmentPlans ShopInstallmentPlan[]
  shopPassPayments     ShopPassPayment[]
  shopSaleDeletionLogs ShopSaleDeletionLog[]
  shopSubcategories    ShopSubcategory[]
  shopServiceSupplies  ShopServiceSupply[]
  // Pedidos que entran por el catálogo público de la tienda virtual (ver ShopOrder).
  shopOrders           ShopOrder[]

  // --- QuickTap Club (businessType = SPORTS_CLUB): canchas y reservas por franja
  // horaria, sin relación con Table/Order — ver web/src/pages/admin/club/. ---
  clubCourts            ClubCourt[]
  clubSchedules         ClubSchedule[]
  clubBlocks            ClubCourtBlock[]
  clubBookings          ClubBooking[]
  clubTabOrders         ClubTabOrder[]                @relation("ClubTabOrderClub")
  clubDebtReminders     ClubDebtReminder[]
  clubDebtVerifications ClubDebtPaymentVerification[]

  // --- Vínculo club ↔ restaurante: el club terceriza la cocina/barra en un
  // restaurante de QuickTap, que recibe las comandas de las canchas. Los dos
  // lados son un Restaurant, de ahí los nombres explícitos de relación. ---
  clubLinkCodes          ClubLinkCode[]        @relation("ClubLinkCodeRestaurant")
  clubLinksAsClub        ClubRestaurantLink[]  @relation("ClubRestaurantLinkClub")
  clubLinksAsKitchen     ClubRestaurantLink[]  @relation("ClubRestaurantLinkRestaurant")
  clubTabOrdersToPrepare ClubTabOrder[]        @relation("ClubTabOrderKitchen")
  clubReportedPayments   ClubReportedPayment[] @relation("ClubReportedPaymentClub")
  clubPaymentsToApprove  ClubReportedPayment[] @relation("ClubReportedPaymentPayee")
  clubTournaments        ClubTournament[]

  // --- Academia de pádel (ver docs/ACADEMIA-PADEL.md) ---
  academySettings     ClubAcademySettings?
  clubPrograms        ClubProgram[]
  clubWaitlist        ClubWaitlistEntry[]
  clubCoaches         ClubCoach[]
  clubClassGroups     ClubClassGroup[]
  clubClassSessions   ClubClassSession[]
  clubStudents        ClubStudent[]
  clubEnrollments     ClubEnrollment[]
  clubClassPackages   ClubClassPackage[]
  clubClassCredits    ClubClassCreditEntry[]
  clubAcademyPayments ClubAcademyPayment[]
  clubAcademyCharges  ClubAcademyCharge[]
  clubCoachPayouts    ClubCoachPayout[]

  // --- Jugadores: cuenta, verificación, lista negra y puntos ---
  clubBookingSettings    ClubBookingSettings?
  clubPhoneVerifications ClubPhoneVerification[]
  clubPlayerAccounts     ClubPlayerAccount[]
  clubBlacklist          ClubBlacklistEntry[]
  clubLoyaltyEntries     ClubLoyaltyEntry[]
  clubPlayInvites        ClubPlayInvite[]
  deviceTokens           DeviceToken[]
  orderDeletionLogs      OrderDeletionLog[]
  waInstance             WaInstance?

  @@index([parentRestaurantId])
  @@map("restaurants")
}

// Horario de apertura/cierre por día de la semana (Ajustes → Horario). Si un
// restaurante no tiene filas aquí, se considera siempre abierto (por defecto,
// retrocompatible con restaurantes ya existentes). dayOfWeek sigue la misma
// convención que Date#getDay(): 0=Domingo, 1=Lunes, ..., 6=Sábado.
model RestaurantSchedule {
  id           String  @id @default(cuid())
  restaurantId String
  dayOfWeek    Int
  isClosed     Boolean @default(false)
  // Hora local del restaurante (America/Caracas), formato "HH:mm". Null si isClosed.
  openTime     String?
  closeTime    String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@map("restaurant_schedules")
}

// ----------------------------------------------------------------------------
//  TASA DE CAMBIO (global, NO por inquilino)
// ----------------------------------------------------------------------------

// Tasa oficial del Banco Central de Venezuela (BCV). Una sola fila vigente
// por moneda, refrescada periódicamente por el ExchangeRateService. Todos
// los restaurantes que facturan en esa moneda comparten la misma tasa.
model ExchangeRate {
  id       String   @id @default(cuid())
  currency Currency @unique

  rateBs Decimal @db.Decimal(18, 4)
  // Fuente del dato (por defecto "BCV"). Útil si en el futuro se agrega otra fuente.
  source String  @default("BCV")

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exchange_rates")
}

model User {
  id           String @id @default(cuid())
  restaurantId String

  email        String
  // Null = cuenta creada solo con "Continuar con Google" (ver googleId), sin contraseña propia.
  passwordHash String?
  name         String
  role         UserRole @default(OWNER)

  // Id de cuenta de Google (claim "sub" del ID token), si esta cuenta se creó o se
  // vinculó con "Continuar con Google". Null = nunca se usó Google en esta cuenta.
  googleId String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Restablecer contraseña por código enviado al correo ---
  resetCodeHash      String?
  resetCodeExpiresAt DateTime?
  resetCodeAttempts  Int       @default(0)

  // Tablet de cancha (rol CANCHA): a qué cancha está atornillada. El QR que se
  // escane en ella tiene que ser de una reserva DE ESA cancha — ver club-tablet.
  // Null en cualquier otro rol.
  clubCourtId String?

  // Acceso a Inventario para roles restringidos (Mesero/Cocina), otorgado
  // individualmente desde Ajustes → Equipo. Los roles de acceso total
  // (OWNER/ADMIN/CASHIER/STAFF) siempre pueden entrar, sin importar esto.
  canAccessInventory Boolean @default(false)

  // Cajero por defecto ahora tiene los mismos permisos que Mesero (más abrir/cerrar caja y ver
  // movimientos del día por método de pago) — este flag, otorgado individualmente desde Ajustes
  // → Equipo, le devuelve el acceso completo de antes (Administración, Productos, Mesas, etc.).
  // No aplica a otros roles.
  cashierFullAccess Boolean @default(false)

  // PIN de 4 dígitos (hasheado) de la Pantalla de bloqueo — personal, cada usuario
  // configura el suyo la primera vez que entra al panel (obligatorio, no se puede
  // omitir). Null = todavía no lo configuró; se le exige antes de poder usar el panel.
  lockPinHash String?

  // --- Personal que presta servicios (barberos, estilistas, manicuristas...) ---
  // Local Comercial: este usuario aparece en el selector "Atendido por" del POS y sus
  // servicios se le acreditan para el reporte por profesional.
  isServiceProvider    Boolean @default(false)
  // % que se lleva de lo que factura (ej. 50 = mitad para él, mitad para el local). Null = 0.
  commissionPercent    Float?
  // Sus PROPIOS datos de cobro (mismo formato que Restaurant.paymentMethodsConfig): en una
  // barbería el cliente le paga directo al barbero a su Pago Móvil/Zelle, aunque la venta se
  // registre igual en el local. Null = se cobra con los datos del local.
  paymentMethodsConfig Json?

  restaurant           Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  clubCourt            ClubCourt?           @relation("UserClubCourt", fields: [clubCourtId], references: [id], onDelete: SetNull)
  placedOrders         Order[]              @relation("OrderPlacedBy")
  acceptedOrders       Order[]              @relation("OrderAcceptedBy")
  assignedTables       Table[]              @relation("TableAssignedWaiter")
  movements            Movement[]
  paymentOrdersCreated PaymentOrder[]       @relation("PaymentOrderCreatedBy")
  paymentOrdersPaid    PaymentOrder[]       @relation("PaymentOrderPaidBy")
  cashSessionsOpened   CashSession[]        @relation("CashSessionOpenedBy")
  cashSessionsClosed   CashSession[]        @relation("CashSessionClosedBy")
  // Academia: ficha de profesor (si este usuario da clases), listas que pasó y
  // cobros que recibió.
  clubCoachProfile     ClubCoach?           @relation("ClubCoachUser")
  clubAttendanceMarked ClubAttendance[]     @relation("ClubAttendanceMarkedBy")
  clubAcademyPayments  ClubAcademyPayment[] @relation("ClubAcademyPaymentReceivedBy")
  deviceTokens         DeviceToken[]

  // El email es único DENTRO de cada restaurante (no globalmente); mismo criterio
  // para googleId (una cuenta de Google puede ser dueña de un restaurante y también
  // staff invitado en otro).
  @@unique([restaurantId, email])
  @@unique([restaurantId, googleId])
  @@index([restaurantId])
  @@map("users")
}

// ----------------------------------------------------------------------------
//  CATÁLOGO: Categories + Products
// ----------------------------------------------------------------------------

model Category {
  id           String @id @default(cuid())
  restaurantId String

  name     String
  // Prioridad de orden (menor = aparece primero en el menú).
  priority Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Origen externo (ej: importada desde OlaClick vía el módulo de migración
  // del panel master — ver src/modules/master/master-olaclick-import.*).
  // Null en categorías creadas normalmente a mano. externalSourceId es el id
  // original en el sistema de origen, usado para no duplicar en re-sync.
  externalSource   String?
  externalSourceId String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([restaurantId, externalSource, externalSourceId])
  @@index([restaurantId, priority])
  @@map("categories")
}

// Estación de cocina (ej: "Cocina Caliente", "Repostería", "Bar") a la que se
// asigna un producto, para que la comanda se divida por estación al momento
// de cocinar. Máximo 10 por restaurante (validado en el service).
model Kitchen {
  id           String @id @default(cuid())
  restaurantId String

  name     String
  priority Int    @default(0)

  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@index([restaurantId, priority])
  @@map("kitchens")
}

model Product {
  id           String  @id @default(cuid())
  restaurantId String
  categoryId   String
  // Estación de cocina donde se prepara (opcional). Null = sin asignar.
  kitchenId    String?

  name            String
  description     String?
  // Precio en la moneda base del restaurante (restaurant.baseCurrency: USD o EUR).
  price           Decimal @db.Decimal(12, 2)
  photoUrl        String?
  // Tiempo aproximado de preparación, en minutos (informativo, opcional).
  prepTimeMinutes Int?

  // Costo del producto para calcular el margen de utilidad (Administración → Margen de utilidad).
  // "RECIPE" = se toma en vivo la suma de RecipeIngredient.costBase (requiere receta armada,
  // solo plan Premium); "MANUAL" = se usa costBase, cargado a mano junto al precio.
  costSource String   @default("MANUAL")
  costBase   Decimal? @db.Decimal(12, 2)

  // Cascada de precio sugerido (Inventario → Recetas → "Precio sugerido"), solo tiene efecto
  // si costSource = RECIPE. recipeBufferPercent = resguardo por fallas al emplatar sobre el
  // costo de materia prima; recipeTargetFoodCostPercent = food cost objetivo con el que se
  // sugiere un precio (costoConResguardo * 100 / este %). Ver recipe.service.ts#getCascade.
  recipeBufferPercent         Decimal @default(10) @db.Decimal(5, 2)
  recipeTargetFoodCostPercent Decimal @default(40) @db.Decimal(5, 2)
  // Interruptores del PVP sugerido: si el restaurante cobra servicio/IVA, decide si ESTE
  // producto los suma al precio sugerido. Apagarlos no toca lo que se le cobra al cliente
  // (eso lo manda la config del restaurante), solo el precio que la cascada recomienda.
  recipeApplyService          Boolean @default(true)
  recipeApplyIva              Boolean @default(true)
  // Observaciones de la receta (Inventario → Recetas): técnica, emplatado, alérgenos, notas
  // para cocina. Texto libre, opcional; no afecta el costeo.
  recipeNotes                 String?

  // Disponibilidad para la venta.
  isAvailable Boolean @default(true)

  // Código interno opcional (back-office). Nunca se expone en el menú público.
  sku String?

  // Control de stock simple por producto (independiente del sistema de insumos/receta).
  // stockQuantity null = sin control de stock; en 0 el producto se muestra agotado en el menú público.
  stockControlEnabled Boolean @default(false)
  stockQuantity       Int?
  // A partir de cuántas unidades avisar "por agotarse" (Inventario → Alertas).
  // Null/0 = solo avisa cuando llega a 0. Equivale a InventoryItem.minQuantity.
  stockMinQuantity    Int?
  // Fecha de caducidad, "YYYY-MM-DD" en hora de Caracas — ver InventoryItem.expiryDate.
  expiryDate          String?

  // --- Envase (envase/caja/bolsa) ---
  // Cargo que se suma al total del pedido SOLO cuando el canal es DELIVERY o PICKUP
  // (nunca DINE_IN/BAR — en mesa se sirve sin empaque). "NONE" = no cobra envase;
  // "FIXED" = precio propio (packagingFeeBase); "INVENTORY" = precio y descuento de
  // stock tomados del insumo vinculado (packagingItem, ver InventoryItem.packagingType).
  packagingMode    String   @default("NONE")
  packagingFeeBase Decimal? @db.Decimal(12, 2)
  packagingItemId  String?

  // --- Banderas de marketing ---
  isStar         Boolean @default(false) // Producto Estrella
  isPromo        Boolean @default(false) // Promoción
  isHouseSpecial Boolean @default(false) // Recomendación de la Casa

  // --- Promoción por tiempo: precio especial que solo aplica dentro de una ventana ---
  // (hora del día, días de la semana y/o rango de fechas — las tres condiciones son
  // opcionales e independientes, y TODAS las que estén configuradas deben cumplirse a
  // la vez). Se evalúa en vivo (hora de Caracas) tanto en el menú público como al
  // cobrar (ver src/utils/promo-price.ts) — nunca se persiste si está "activa ahora".
  // Solo aplica a productos de precio simple (pricingMode = SIMPLE), no a variantes.
  promoPriceEnabled Boolean   @default(false)
  promoPrice        Decimal?  @db.Decimal(12, 2)
  // "HH:mm" 24h, hora de Caracas. Null en cualquiera de los dos = sin restricción de hora.
  // Si promoEndTime < promoStartTime se interpreta como un rango que cruza la medianoche.
  promoStartTime    String?
  promoEndTime      String?
  // 0=domingo..6=sábado (igual que Date#getDay()). Vacío = todos los días.
  promoDaysOfWeek   Int[]     @default([])
  // Rango de fechas (inclusive, medianoche a medianoche hora de Caracas). Null = sin límite.
  promoStartDate    DateTime?
  promoEndDate      DateTime?

  // Orden dentro de su categoría.
  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cómo se cobra: "SIMPLE" = un solo precio (el campo `price` de arriba);
  // "VARIANTS" = el cliente elige entre las filas de `variants`, cada una con
  // su propio precio (ej. "Ensalada César" / "Ensalada Mixta").
  pricingMode String @default("SIMPLE")

  // Origen externo (ver Category.externalSource más arriba). importedImageUrl
  // guarda la foto tal cual venía del sistema de origen como referencia — el
  // campo real usado por la app sigue siendo `photoUrl`, que queda null hasta
  // que alguien la confirme/reemplace (ver master-olaclick-import.service.ts).
  externalSource   String?
  externalSourceId String?
  importedImageUrl String?

  restaurant                Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category                  Category                    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  kitchen                   Kitchen?                    @relation(fields: [kitchenId], references: [id], onDelete: SetNull)
  // Insumo vinculado como envase (packagingMode = INVENTORY). SetNull: si se borra el
  // insumo, el producto no se rompe, solo deja de cobrar/descontar envase.
  packagingItem             InventoryItem?              @relation("ProductPackaging", fields: [packagingItemId], references: [id], onDelete: SetNull)
  orderItems                OrderItem[]
  recipeIngredients         RecipeIngredient[]
  /// Recetas de OTROS platos que incluyen a este como parte de un combo.
  enCombos                  RecipeIngredient[]          @relation("ComboComponente")
  costStructure             ProductCostStructure?
  wasteRecords              WasteRecord[]
  modifierCategories        ProductModifierCategory[]
  // Combo "pool escogible": si alguno de estos dos está definido, los comboComponents dejan de
  // ser cantidades fijas (2× pizza + 1× refresco) y pasan a ser la LISTA de platos disponibles:
  // el cliente escoge entre el mínimo y el máximo, repitiendo plato si quiere, al precio del
  // combo. Con ambos en null el combo se comporta como siempre (cantidades fijas por plato).
  comboMinSelections        Int?
  comboMaxSelections        Int?
  comboComponents           ComboComponent[]            @relation("ComboOwner")
  comboUsages               ComboComponent[]            @relation("ComboPart")
  variants                  ProductVariant[]
  modifierVariantVisibility ModifierVariantVisibility[]

  @@unique([restaurantId, externalSource, externalSourceId])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, packagingItemId])
  @@index([restaurantId, isAvailable])
  @@index([restaurantId, kitchenId])
  @@map("products")
}

// ----------------------------------------------------------------------------
//  MODIFICADORES: categorías reutilizables entre productos (ej. "Extra",
//  "Elige el término de la carne"), cada una con sus propias opciones.
// ----------------------------------------------------------------------------

// Un plato que compone un COMBO (Product → Product). El combo tiene precio propio; al
// ordenarlo, cada instancia de cada componente (2× wokbox = dos instancias) se arma eligiendo
// los modificadores del PROPIO producto componente — el combo no duplica esa configuración.
model ComboComponent {
  id                 String  @id @default(cuid())
  restaurantId       String
  productId          String
  componentProductId String
  quantity           Int     @default(1)
  priority           Int     @default(0)
  // Tamaño FIJO del plato dentro del combo cuando el componente se vende por variantes
  // ("2× Noodle Bar 16OZ"): lo decide quien arma el combo, no el cliente, así el precio del
  // combo no se mueve. Obligatorio si el componente es VARIANTS — sin tamaño no se pueden
  // resolver ni los grupos acotados por variante ni los precios por variante de sus
  // modificadores. null = componente de precio simple.
  variantId          String?

  product          Product         @relation("ComboOwner", fields: [productId], references: [id], onDelete: Cascade)
  componentProduct Product         @relation("ComboPart", fields: [componentProductId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Incluye la variante: "Noodle Bar 16OZ" y "Noodle Bar 26OZ" pueden convivir en el mismo combo.
  @@unique([productId, componentProductId, variantId])
  @@index([restaurantId])
  @@map("combo_components")
}

model ModifierCategory {
  id           String @id @default(cuid())
  restaurantId String

  name String

  // Obligatorio = el cliente debe elegir algo de esta categoría antes de agregar al carrito.
  isRequired    Boolean @default(false)
  // false = el cliente elige un solo modificador (radio); true = puede elegir varios (checkboxes).
  allowMultiple Boolean @default(false)
  // Límite de selecciones totales cuando allowMultiple=true (permite repetir la misma opción,
  // ej. "Ketchup x4"). null = sin límite. Un producto puntual puede sobreescribirlo, ver
  // ProductModifierCategory.maxSelectionsOverride.
  maxSelections Int?
  // Mínimo de selecciones totales cuando allowMultiple=true. null = usa el default (1 si
  // isRequired, 0 si no).
  minSelections Int?

  // Orden al mostrarse dentro de un producto.
  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant  Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  modifiers   Modifier[]
  products    ProductModifierCategory[]
  // Líneas de receta "A elección del cliente" que resuelven el topping según lo que se
  // eligió en esta categoría (ver RecipeIngredient.customerChoiceModifierCategoryId).
  recipeLines RecipeIngredient[]

  @@index([restaurantId])
  @@map("modifier_categories")
}

model Modifier {
  id           String @id @default(cuid())
  restaurantId String
  categoryId   String

  name         String
  // Precio adicional al elegir este modificador, en la moneda base del restaurante.
  priceBase    Decimal  @default(0) @db.Decimal(12, 2)
  // Costo (para margen de utilidad) y descuento, igual que en Producto — opcionales.
  costBase     Decimal? @db.Decimal(12, 2)
  discountBase Decimal? @db.Decimal(12, 2)
  // Visible/oculto en el menú público (el ícono de ojo de la referencia).
  isAvailable  Boolean  @default(true)
  // Tope de repetición de este modificador puntual (ej. "Ketchup máx. 2"), independiente del
  // límite de la categoría. null = sin tope propio (solo limita el máximo de la categoría).
  maxQuantity  Int?
  // Código interno opcional (back-office). Nunca se expone en el menú público.
  sku          String?

  // Vínculo con inventario: si este modificador consume un insumo (o una preparación,
  // ej. "salsa de la casa"), al vender se descuenta solo — exactamente uno de los dos,
  // nunca ambos (validado en modifier-category.dto.ts). `inventoryQuantity` va SIEMPRE
  // en la unidad base del insumo/preparación (kg/lt/unidad) — el formulario deja
  // cargarlo en gr/ml y lo convierte antes de guardar, igual que hace RecipeIngredient.
  inventoryItemId   String?
  preparationId     String?
  inventoryQuantity Decimal? @db.Decimal(12, 4)

  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant        Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category          ModifierCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // SetNull: si se borra el insumo/preparación, el modificador sigue vivo (solo deja de
  // descontar) — borrar un insumo no puede tumbar el menú.
  inventoryItem     InventoryItem?              @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  preparation       Preparation?                @relation(fields: [preparationId], references: [id], onDelete: SetNull)
  variantPrices     ModifierVariantPrice[]
  variantVisibility ModifierVariantVisibility[]
  // Líneas de receta "A elección del cliente" con porción propia para este topping.
  recipeLines       RecipeIngredient[]

  @@index([restaurantId, categoryId])
  @@index([inventoryItemId])
  @@index([preparationId])
  @@map("modifiers")
}

// Precio propio de un modificador para UNA variante puntual de un producto (ej. "Extra queso"
// cuesta distinto en "Pizza Grande" que en "Pizza Pequeña"). Sin fila acá = el modificador usa
// su Modifier.priceBase de siempre, sin importar la variante elegida — esto es solo el override.
model ModifierVariantPrice {
  id                String   @id @default(cuid())
  modifierId        String
  variantId         String
  priceBase         Decimal  @db.Decimal(12, 2)
  // Consumo de insumo propio de ESTA variante (en la unidad base del insumo/preparación
  // vinculado): "Extra queso" gasta 30 gr en la pizza pequeña y 80 gr en la familiar.
  // Null = usa el inventoryQuantity general del modificador.
  inventoryQuantity Decimal? @db.Decimal(12, 4)

  modifier Modifier       @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([modifierId, variantId])
  @@index([variantId])
  @@map("modifier_variant_prices")
}

// En qué variantes DE UN PRODUCTO aparece UN MODIFICADOR individual — el mismo concepto que
// ProductModifierCategory.variantIds (grupo completo por producto) pero un nivel más abajo:
// "Extra tocineta" solo en la hamburguesa Doble y Triple, sin acotar el resto del grupo
// "Extras", que sigue viéndose en las tres. No puede vivir directo en Modifier porque la
// categoría (y sus modificadores) se reutiliza entre productos y cada uno tiene sus propias
// variantes — por eso esta fila ata explícitamente modifierId + productId, igual que
// ModifierVariantPrice ata modifierId + variantId (que ya es inequívoco de un solo producto).
// Sin fila acá = el modificador aparece en todas las variantes donde ya aparece el grupo.
model ModifierVariantVisibility {
  id         String   @id @default(cuid())
  modifierId String
  productId  String
  variantIds String[] @default([])

  modifier Modifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([modifierId, productId])
  @@map("modifier_variant_visibility")
}

// Asocia una categoría de modificadores reutilizable a un producto puntual ("Asociar/Desasociar").
model ProductModifierCategory {
  id                    String   @id @default(cuid())
  productId             String
  modifierCategoryId    String
  priority              Int      @default(0)
  // Sobreescribe ModifierCategory.maxSelections solo para este producto. null = usa el de la categoría.
  maxSelectionsOverride Int?
  // Unidades gratis de este grupo EN ESTE PLATO: las primeras N no se cobran aunque tengan
  // precio, y de la N+1 en adelante se cobra normal (ej: "5 toppings incluidos, el 6º se paga").
  // Las gratis se asignan a las unidades más baratas — regla fija para que el panel, el menú
  // público y el backend calculen exactamente el mismo total. null/0 = todas se cobran.
  freeQuantity          Int?
  // Tamaños (ProductVariant) en los que aparece este grupo. VACÍO = en todos, que es como se
  // comportaba antes de existir esta columna y por eso es el valor por defecto: los grupos ya
  // asociados siguen saliendo en todas las variantes sin tocar nada.
  // Ej: "Término de la carne" solo en las hamburguesas dobles y triples, no en la sencilla.
  variantIds            String[] @default([])

  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierCategory ModifierCategory @relation(fields: [modifierCategoryId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierCategoryId])
  @@map("product_modifier_categories")
}

// ----------------------------------------------------------------------------
//  VARIANTES: cuando un producto se cobra como "Variantes" en vez de precio
//  simple (ej. "Ensaladas" con "César"/"Mixta"/"Pico de Gallo", cada una con
//  su propio precio). El cliente elige exactamente una al pedir.
// ----------------------------------------------------------------------------

model ProductVariant {
  id           String @id @default(cuid())
  restaurantId String
  productId    String

  name             String
  priceBase        Decimal  @db.Decimal(12, 2)
  // Cargo adicional de empaque para esta variante (delivery/pickup), opcional.
  packagingFeeBase Decimal? @db.Decimal(12, 2)
  costBase         Decimal? @db.Decimal(12, 2)
  discountBase     Decimal? @db.Decimal(12, 2)
  isAvailable      Boolean  @default(true)

  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Id de la variante en el sistema de origen (ver Product.externalSource). Sirve
  // para re-sincronizar sin duplicar: una variante creada a mano lo deja en null,
  // y por eso la importación nunca la borra.
  externalSourceId String?

  restaurant      Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product         Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  comboComponents ComboComponent[]
  modifierPrices  ModifierVariantPrice[]
  // Líneas de receta que solo aplican a este tamaño (ver RecipeIngredient.productVariantId).
  recipeLines     RecipeIngredient[]

  @@unique([productId, externalSourceId])
  @@index([restaurantId, productId])
  @@map("product_variants")
}

// ----------------------------------------------------------------------------
//  ZONAS + MESAS
// ----------------------------------------------------------------------------

// Zona del salón (ej: "Terraza", "Salón principal"). Agrupa mesas para el
// plano de Órdenes de Mesa.
model Zone {
  id           String @id @default(cuid())
  restaurantId String

  name     String
  // Prioridad de orden (menor = aparece primero).
  priority Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables          Table[]
  waitlistEntries WaitlistEntry[]

  @@index([restaurantId, priority])
  @@map("zones")
}

model Table {
  id           String  @id @default(cuid())
  restaurantId String
  zoneId       String?

  // Número/identificador visible de la mesa (ej: "5", "Terraza-2").
  number  String
  // Token opaco embebido en el QR. Se usa en la URL pública del QR
  // para resolver la mesa sin exponer IDs internos.
  qrToken String @unique

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Solicitud pendiente del comensal (llamar al mesonero / pedir la cuenta),
  // disparada desde el menú público y atendida desde el plano de mesas.
  serviceRequest   ServiceRequestType?
  serviceRequestAt DateTime?

  // Mesero al que le pertenece esta mesa: asignado a mano desde Equipo, o
  // automático (el primer mesero que acepta un pedido de una mesa sin
  // asignar se la queda). Mientras esté asignada, los pedidos de esta mesa
  // solo le aparecen a él en el Dashboard — el resto de los roles sigue
  // viendo todos los pedidos sin importar esto.
  assignedWaiterId String?

  // --- Planimetría del salón (Órdenes de Mesa → "Plano") ---
  // Posición de la mesa dentro del plano de SU zona, en porcentaje del lienzo (0-100), no en
  // píxeles: así el mismo plano se ve igual en el celular del mesero y en el monitor de caja.
  // null = todavía sin ubicar; esas mesas se listan aparte para arrastrarlas al plano.
  planX     Decimal? @db.Decimal(5, 2)
  planY     Decimal? @db.Decimal(5, 2)
  // Forma y tamaño con que se dibuja: 'ROUND' | 'SQUARE' | 'RECTANGLE' (el doble de ancha,
  // pensada para 6 personas), y un factor 1 = normal, 1.5 = grande.
  planShape String   @default("ROUND")
  planSize  Decimal  @default(1) @db.Decimal(3, 2)
  // Cuántas sillas tiene la mesa. Se dibujan como puntitos alrededor en el plano para que el
  // salón se lea de un vistazo. Es solo visual: el contador de la zona cuenta mesas ocupadas
  // sobre mesas totales, no comensales.
  seats     Int      @default(4)

  // --- Unir mesas (grupo para una mesa grande) ---
  // Si está seteado, esta mesa está pegada a la principal indicada y no tiene vida propia
  // mientras dure la unión: su cuenta, su QR y sus pedidos van todos a la principal, para que
  // el grupo pague UNA sola cuenta. La principal es la única del grupo que lleva TableSession,
  // así que nada del flujo de pedidos/cobros/impresión tuvo que cambiar (ver src/utils/table-merge.ts).
  mergedIntoTableId String?
  mergedAt          DateTime?
  // Dónde estaba en el plano antes de unirse, para devolverla a su sitio al separarla.
  preMergePlanX     Decimal?  @db.Decimal(5, 2)
  preMergePlanY     Decimal?  @db.Decimal(5, 2)

  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  zone           Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  mergedInto     Table?         @relation("TableMerge", fields: [mergedIntoTableId], references: [id], onDelete: SetNull)
  mergedTables   Table[]        @relation("TableMerge")
  assignedWaiter User?          @relation("TableAssignedWaiter", fields: [assignedWaiterId], references: [id], onDelete: SetNull)
  orders         Order[]
  sessions       TableSession[]
  reservations   Reservation[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@index([zoneId])
  @@index([assignedWaiterId])
  @@index([restaurantId, mergedIntoTableId])
  @@map("tables")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  // El grupo llegó y se sentó: la reserva abrió su cuenta (ver Reservation.tableSessionId).
  SEATED
  // La hora pasó y nunca aparecieron.
  NO_SHOW
}

// De dónde salió la reserva: del botón "Mesa" del menú público, o cargada por el propio
// restaurante desde el panel (esas nacen ya confirmadas, nadie tiene que aceptarlas).
enum ReservationSource {
  PUBLIC
  STAFF
}

// Reserva de mesa hecha por el cliente desde el botón "Mesa" del menú
// público. Queda PENDING hasta que Cajero/Administrador la acepte o la
// cancele desde la pestaña "Reservas" del panel.
model Reservation {
  id               String            @id @default(cuid())
  restaurantId     String
  // Fecha de la reserva (medianoche del día elegido, hora America/Caracas).
  date             DateTime
  // Hora elegida, formato "HH:mm".
  time             String
  partySize        Int
  customerName     String
  customerIdNumber String
  customerPhone    String
  status           ReservationStatus @default(PENDING)
  source           ReservationSource @default(PUBLIC)
  // Nota del salón: "cumpleaños", "silla de bebé", "junto a la ventana".
  note             String?
  createdAt        DateTime          @default(now())

  // Cuándo se sentaron y en qué cuenta terminaron: así la barra lateral de Sala puede mostrar
  // "sentados" con su mesa, y desde la reserva se llega al consumo real del grupo.
  seatedAt       DateTime?
  tableSessionId String?

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableSession TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  tables       Table[]

  @@index([restaurantId, date])
  @@map("reservations")
}

enum SyncConflictKind {
  /// La cuenta a la que pertenecía el pedido se cerró en la nube mientras no había conexión.
  SESSION_CLOSED
  /// La mesa se borró o desactivó durante el corte.
  TABLE_MISSING
  /// Un producto del pedido se borró durante el corte.
  PRODUCT_MISSING
  /// Cualquier otro fallo al insertar: se guarda el detalle para revisarlo a mano.
  OTHER
}

/// Un pedido tomado sin internet que NO se pudo subir tal cual, porque algo cambió en la nube
/// mientras tanto (se cerró la cuenta, se borró la mesa o un producto).
///
/// En vez de sobrescribir en silencio o abortar toda la subida, se guarda acá con su contenido
/// completo y se le muestra a una persona: gana lo que ya estaba en la nube, y el pedido
/// descartado queda visible para decidir qué hacer con él.
model SyncConflict {
  id               String           @id @default(cuid())
  restaurantId     String
  kind             SyncConflictKind
  /// Referencia de la comanda impresa durante el corte ("R-3"), para encontrar el papel.
  offlineTicketRef String?
  /// Explicación en español, lista para mostrar.
  reason           String
  /// El pedido completo tal como lo mandó el relé, por si hay que recrearlo a mano.
  payload          Json

  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, resolvedAt])
  @@map("sync_conflicts")
}

enum WaitlistStatus {
  WAITING // esperando mesa
  NOTIFIED // ya se le avisó que su mesa está lista
  SEATED // se sentó
  CANCELLED // se fue o canceló
  NO_SHOW // no apareció cuando le tocó
}

// Lista de espera del salón: quién está esperando mesa ahora mismo, cuánto lleva y en qué
// cuenta terminó sentado. A diferencia de una Reservation (que se pide para un día y una hora),
// una entrada de espera es gente que YA está en la puerta. Alimenta el "Espera promedio" de Sala.
model WaitlistEntry {
  id               String  @id @default(cuid())
  restaurantId     String
  customerName     String
  customerPhone    String?
  customerIdNumber String?
  partySize        Int
  // Zona que pidieron ("quiero en la terraza"). null = les da igual.
  zoneId           String?
  note             String?
  // Los minutos que se le prometieron al cliente, para contrastarlos con la espera real.
  quotedMinutes    Int?

  status WaitlistStatus @default(WAITING)

  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
  seatedAt   DateTime?
  closedAt   DateTime?

  // En qué cuenta terminó sentado (si llegó a sentarse).
  tableSessionId String?

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  zone         Zone?         @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  tableSession TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status, createdAt])
  @@map("waitlist_entries")
}

// ----------------------------------------------------------------------------
//  CUENTA DE MESA (TableSession)
// ----------------------------------------------------------------------------

// Representa la "cuenta abierta" de una mesa: desde el primer pedido hasta que
// el restaurante la cierra desde el dashboard, todos los pedidos DINE_IN de
// esa mesa se acumulan en la misma sesión (Pedido #1, #2, #3...).
model TableSession {
  id           String @id @default(cuid())
  restaurantId String
  tableId      String

  // Capturados una sola vez, al abrir la cuenta (primer pedido de la mesa).
  // El teléfono es obligatorio a nivel de aplicación (order.service.ts) desde
  // que se agregó el botón "Enviar vía WhatsApp" en Pedidos; queda nullable
  // en la BD para no romper cuentas abiertas antes de este cambio.
  customerName     String
  customerIdNumber String
  customerPhone    String?

  // Clave opcional de 4 dígitos para que nadie más pueda pedir en esta mesa
  // sin autorización. Se decide justo después del primer pedido; vive solo
  // mientras la cuenta esté abierta (se resetea al cerrar/rodar la mesa).
  pinHash    String?
  pinSkipped Boolean @default(false)

  // Nombre de la cuenta cuando una mesa tiene varias abiertas a la vez (ej. "Cuenta 1").
  // Null = mesa de una sola cuenta (comportamiento de siempre).
  label String?

  status TableSessionStatus @default(OPEN)

  openedAt DateTime  @default(now())
  closedAt DateTime?

  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table           Table           @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders          Order[]
  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]

  @@index([restaurantId, tableId, status])
  @@map("table_sessions")
}

// ----------------------------------------------------------------------------
//  COMANDAS: Orders + OrderItems
// ----------------------------------------------------------------------------

model Order {
  id           String @id @default(cuid())
  restaurantId String

  // Número correlativo legible por inquilino (ej: #1023). Se asigna en el service.
  orderNumber Int

  channel OrderChannel
  status  OrderStatus  @default(PENDING)

  // Mesa asociada (solo canal DINE_IN).
  tableId        String?
  // Cuenta de mesa a la que pertenece este pedido (solo canal DINE_IN).
  tableSessionId String?

  // --- Snapshot de totales (se congelan al crear la orden) ---
  // Moneda en la que el restaurante facturó este pedido (USD o EUR).
  currency          Currency
  subtotalBase      Decimal  @db.Decimal(12, 2)
  // Cargos opcionales congelados al momento del pedido (0 si estaban apagados).
  serviceChargeBase Decimal  @default(0) @db.Decimal(12, 2)
  ivaBase           Decimal  @default(0) @db.Decimal(12, 2)
  totalBase         Decimal  @db.Decimal(12, 2)
  // Tasa BCV aplicada y total convertido a Bs en el momento de la compra.
  exchangeRate      Decimal  @db.Decimal(18, 4)
  totalBs           Decimal  @db.Decimal(18, 2)
  // Propina, en la moneda base del restaurante. Aparte del total (no es un
  // cargo del pedido): la agrega el cliente en mesa o el staff manualmente.
  tipBase           Decimal  @default(0) @db.Decimal(12, 2)
  // Costo de envío calculado en el checkout de delivery (por distancia o por
  // zona). Sí forma parte de totalBase/totalBs, a diferencia de la propina.
  deliveryFeeBase   Decimal  @default(0) @db.Decimal(12, 2)
  // El envío lo escribió el staff a mano al crear el pedido (panel), en vez de salir del
  // cálculo por zona/distancia. Sirve para no pisárselo después: al mover la dirección del
  // cliente el envío se recotiza solo si NO fue manual (ver updateCustomer).
  deliveryFeeManual Boolean  @default(false)
  // Cargo por envase (envase/caja/bolsa) de los productos del pedido. Solo se
  // calcula para canal DELIVERY/PICKUP (nunca DINE_IN/BAR) — ver Product.packagingMode.
  envaseFeeBase     Decimal  @default(0) @db.Decimal(12, 2)

  // --- Datos del cliente ---
  customerName     String?
  // Cédula/documento de identidad, usado para los datos de facturación
  // (principalmente canal DINE_IN).
  customerIdNumber String?
  customerPhone    String?
  customerAddress  String?
  // Coordenadas GPS del cliente (botón "Usar mi ubicación actual" en el
  // checkout de delivery), usadas para calcular el envío por distancia/zona.
  customerLat      Float?
  customerLng      Float?
  paymentMethod    PaymentMethod?
  customerNote     String?

  // Si el pedido lo cargó un mesero/staff desde "Órdenes de Mesa" (en vez de
  // ser el cliente desde su teléfono), queda el usuario que lo tomó.
  /// Referencia de la comanda impresa cuando el pedido nació sin internet ("R-3"): el número
  /// definitivo lo asigna la nube al sincronizar, y este queda para poder rastrear en papel
  /// qué comanda del corte corresponde a qué pedido. null = nació con conexión, como siempre.
  offlineTicketRef String?

  // --- Factura emitida por la impresora fiscal física (máquina fiscal del local) ---
  // No confundir con el modelo FiscalInvoice, que es la facturación DIGITAL vía
  // Unidigital/SENIAT: son dos vías distintas y un restaurante usa una u otra.
  // Acá solo se guarda el comprobante de lo que la máquina ya imprimió, para poder
  // cruzar el papel con la venta. Los tres se llenan juntos o quedan los tres en null.
  /// Número correlativo que la impresora fiscal le asignó ("00001040").
  fiscalPrinterInvoice  String?
  /// Serial de la máquina fiscal que la emitió — el mismo que sale al pie del ticket.
  fiscalPrinterSerial   String?
  /// Cuándo se imprimió. Sirve además de bandera: con valor, la factura ya salió y
  /// no hay que volver a emitirla (cada emisión consume numeración fiscal).
  fiscalPrintedAt       DateTime?
  /// Consumo de socio: se congela al crear el pedido a partir de Customer.isPartner,
  /// para que marcar/desmarcar a un socio después no reescriba la historia contable.
  /// Con esto en true el pedido se excluye de todo lo que sea "venta".
  isPartnerConsumption  Boolean   @default(false)
  /// Consumo interno registrado para un miembro del equipo. No cuenta como venta ni saldo por cobrar.
  isEmployeeConsumption Boolean   @default(false)
  employeeConsumerName  String?

  /// Qué documento espera el cliente: nota de entrega (lo normal) o factura fiscal.
  /// Se marca al tomar el pedido — "¿Desea factura fiscal?" en Crear pedido — y se
  /// puede cambiar al cobrar, porque mucha gente la pide recién cuando va a pagar.
  /// Es la INTENCIÓN, no el hecho: lo que salió por la máquina es `fiscalPrintedAt`.
  wantsFiscalInvoice Boolean @default(false)

  placedByUserId String?

  // Mesero/staff que apretó "Aceptar" en un pedido pedido por el cliente
  // (mesa/QR). Junto con placedByUserId, define qué pedidos ve el rol Mesero
  // en el Dashboard (los suyos + los que él aceptó).
  acceptedByUserId String?

  // Repartidor al que se despachó la comanda (botón "Delivery" del panel de
  // Pedidos), para poder ver el movimiento de cada repartidor en Administración.
  deliveryCourierId    String?
  deliveryDispatchedAt DateTime?

  // Botón del reloj en Pedidos: cuenta abierta del cliente, pendiente de
  // cobrar. Aparece en la pestaña "Pendiente por pagar" y en Administración
  // → Cuentas por pagar. Planes Pro/Premium (o CUSTOM con el adicional).
  awaitingPayment Boolean @default(false)

  // Se sella al cerrar caja: la comanda ya quedó saldada en ese turno y sale de la
  // pantalla de Pedidos para no arrastrar el turno anterior. No borra nada — el
  // pedido sigue completo en Administración. Las que aún deben algo NO se sellan,
  // así la deuda queda a la vista hasta que se cobre.
  clearedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant          Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table               Table?                    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSession        TableSession?             @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  placedByUser        User?                     @relation("OrderPlacedBy", fields: [placedByUserId], references: [id], onDelete: SetNull)
  acceptedByUser      User?                     @relation("OrderAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  deliveryCourier     DeliveryCourier?          @relation(fields: [deliveryCourierId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            OrderPayment[]
  // Plural: la factura (FA) y su eventual nota de crédito/débito (NC/ND).
  fiscalInvoices      FiscalInvoice[]
  paymentVerification OrderPaymentVerification?

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([tableSessionId])
  @@map("orders")
}

// Cobro registrado desde los botones "Pagar" / "Pago Fraccionado" del panel
// de Pedidos. Un pedido puede tener varios (pago fraccionado en distintos
// métodos); lo pagado se compara contra totalBase para saber el saldo.
model OrderPayment {
  id                           String         @id @default(cuid())
  orderId                      String
  amountBase                   Decimal        @db.Decimal(12, 2)
  method                       PaymentMethod
  // Descuento aplicado a este pago puntual (no al pedido completo, porque
  // pagos fraccionados distintos pueden llevar descuentos distintos).
  discountPercent              Decimal?       @db.Decimal(5, 2)
  discountBase                 Decimal?       @db.Decimal(12, 2)
  // Ajuste puntual al cargo de servicio de ESTE cobro (perdona parte/todo el servicio de este
  // pago) — mismo criterio que discountPercent/discountBase, nunca toca Order.serviceChargeBase.
  serviceChargeDiscountPercent Decimal?       @db.Decimal(5, 2)
  serviceChargeDiscountBase    Decimal?       @db.Decimal(12, 2)
  // Propina cobrada EN ESTE pago puntual (plata real, entra a la cuenta bancaria del método
  // igual que amountBase). Aparte de Order.tipBase — que es la propina declarada/esperada del
  // pedido completo — porque puede fraccionarse en varios cobros o crecer si el cliente decide
  // dejar más al pagar. Ver cash-session.service.ts#computeSummary: se reporta como un segmento
  // aparte de las ventas, nunca sumado a totalNet.
  tipBase                      Decimal?       @db.Decimal(12, 2)
  // Número de referencia/comprobante (Pago Móvil, Zelle) o de ticket (Punto de venta).
  referenceNumber              String?
  // Foto del comprobante (Pago Móvil/Zelle/Binance/PayPal/Transferencia) — obligatoria para
  // esos métodos al cobrar desde el panel (ver METHODS_REQUIRING_PROOF en order.dto.ts).
  proofImageUrl                String?
  // --- Vuelto (cambio) ---
  // Cuánto entregó el cliente en efectivo cuando pagó de más (ej. dio $20 para un saldo de $18).
  // Null = pagó exacto (o método no-efectivo). `amountBase` sigue siendo lo que se le ACREDITA al
  // pedido; la diferencia es el vuelto. La caja registra el efectivo completo que entró (esto) y
  // el vuelto como salida por el método con que se devolvió — así cada método cuadra con lo que
  // físicamente entró y salió por ahí (ver cash-session.service.ts#computeSummary).
  amountReceivedBase           Decimal?       @db.Decimal(12, 2)
  changeBase                   Decimal?       @db.Decimal(12, 2)
  // Con qué método se devolvió el vuelto: mismo efectivo, o Pago Móvil en Bs (caso típico
  // venezolano: paga en dólares y se le devuelve el cambio en bolívares por pago móvil).
  changeMethod                 PaymentMethod?
  changeReferenceNumber        String?
  createdAt                    DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_payments")
}

enum OrderPaymentVerificationStatus {
  AWAITING_PROOF // esperando que el cliente mande la foto del comprobante
  PENDING_FORWARD // ya llegó la foto (o, en modo FULL_ORDER, el pedido en sí), pero hay otra verificación en curso para este restaurante — en cola
  AWAITING_VERIFIER // foto (o pedido completo) reenviado al verificador, esperando "Aprobado"/"Rechazado"
  APPROVED
  // Terminal, solo en modo FULL_ORDER (sin foto que reenviar): a diferencia de un
  // rechazo en modo PAYMENT_VERIFICATION, que vuelve a AWAITING_PROOF para que el
  // cliente reenvíe el comprobante, acá no hay nada que reenviar.
  REJECTED
  TIMED_OUT
}

// Estado persistido (a diferencia de lastWelcomeReplyAt, que es solo un Map en memoria) de la
// verificación de pago por WhatsApp de un pedido delivery/pickup: el chatbot manda los datos de
// pago al crear el pedido, espera la foto del comprobante del cliente, se la reenvía al número
// verificador del restaurante (Ajustes -> WhatsApp,
// Restaurant.whatsappBotPaymentVerifierPhone) y, cuando ese número contesta "Aprobado", el
// pedido pasa solo de PENDING a KITCHEN (ver order.service.ts ->
// autoAcceptAfterPaymentApproved). Solo existe una fila por Order (@unique), y solo se crea
// para métodos de pago que requieren comprobante (ver PROOF_REQUIRED_PAYMENT_METHODS en
// src/utils/whatsapp.ts).
model OrderPaymentVerification {
  id            String @id @default(cuid())
  orderId       String @unique
  restaurantId  String
  // Teléfono del cliente normalizado a solo dígitos con código de país (mismo criterio que
  // formatVenezuelanWhatsappPhone), para poder compararlo dígito a dígito contra el JID de
  // WhatsApp de un mensaje entrante.
  customerPhone String

  status OrderPaymentVerificationStatus @default(AWAITING_PROOF)

  proofImageUrl         String?
  proofReceivedAt       DateTime?
  forwardedToVerifierAt DateTime?
  verifierRepliedAt     DateTime?
  resolvedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([restaurantId, customerPhone, status])
  @@map("order_payment_verifications")
}

// Configuración de facturación fiscal (SENIAT) vía Corporación Unidigital
// (docs.unidigital.global). Solo la crea/edita el equipo QuickTap desde el
// Dashboard maestro (ver master-restaurants.service.ts), igual que ivaEnabled —
// nunca autoservicio del restaurante. Cuando enabled=true, cada Order saldado
// por completo (ver order.service.ts -> addPayment) genera automáticamente
// una Factura a través de esta config (ver fiscal-invoicing.service.ts).
model FiscalInvoicingConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  enabled     Boolean @default(false)
  // "QA" (sandbox) o "PRODUCTION" — decide la URL base del cliente HTTP.
  environment String  @default("QA")

  username          String
  // Cifrado (AES-256-GCM, ver fiscal-invoicing.crypto.ts) — nunca texto plano.
  passwordEncrypted String

  // GUID de la Serie 0, cacheado tras el primer login exitoso contra /user/login.
  serieStrongId            String?
  // Correlativo interno por tipo de documento (ej: {"FA": 1042, "NC": 12}) — la
  // numeración de "Number" es responsabilidad de QuickTap, no de Unidigital.
  nextDocumentNumberByType Json    @default("{}")

  // JWT cacheado entre requests (dura 8h) para no loguearse en cada factura.
  accessToken    String?
  tokenExpiresAt DateTime?

  // IGTF (Impuesto a las Grandes Transacciones Financieras): aplica sobre pagos
  // en divisa/cripto. La alícuota vigente y a quién aplica la define el contador
  // del restaurante — por eso es configurable y arranca DESACTIVADO, para no
  // inventar un impuesto que no corresponda.
  igtfEnabled Boolean @default(false)
  igtfRate    Decimal @default(0) @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("fiscal_invoicing_configs")
}

// Historial de documentos fiscales emitidos (o intentados) por Order, vía
// Unidigital. status pasa PENDING (enviado, esperando N° de control, que
// tarda 1-5 min) -> ISSUED (con controlNumber) -> FAILED / VOIDED.
model FiscalInvoice {
  id           String @id @default(cuid())
  // NO es único por pedido: un mismo pedido puede tener su factura (FA) y
  // después una nota de crédito (NC) o de débito (ND) que la corrige. La
  // unicidad real es por (pedido, tipo de documento) — ver @@unique abajo.
  orderId      String
  restaurantId String

  documentType   String // "FA" | "NC" | "ND"
  documentNumber Int

  // GUID que devuelve Unidigital al crear el documento — clave para
  // reconsultar/anular más adelante.
  unidigitalStrongId String?
  controlNumber      Int?

  status       String // "PENDING" | "ISSUED" | "FAILED" | "VOIDED"
  errorMessage String?

  // Contingencia (Providencia 102, art. sobre continuidad operativa): un fallo
  // de red o del API de la imprenta no puede perder la factura. Se reintenta
  // con backoff hasta MAX_ISSUE_ATTEMPTS antes de quedar en revisión manual.
  attempts    Int       @default(0)
  nextRetryAt DateTime?

  // Anulación: nunca se borra la fila, se marca. La corrección fiscal real va
  // por NC/ND, que apunta aquí con replacesInvoiceId.
  voidedAt          DateTime?
  voidReason        String?
  replacesInvoiceId String?
  replaces          FiscalInvoice?  @relation("FiscalInvoiceCorrection", fields: [replacesInvoiceId], references: [id], onDelete: Restrict)
  correctedBy       FiscalInvoice[] @relation("FiscalInvoiceCorrection")

  rawRequestJson  Json?
  rawResponseJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict, NO Cascade: borrar un pedido no puede arrastrarse el documento
  // fiscal. Un documento emitido es inalterable e imborrable — si el pedido se
  // quiere "deshacer" hay que emitir una NC, no eliminar el registro.
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, documentType])
  @@index([restaurantId, status])
  // Cola de contingencia: barrido de pendientes por reintentar.
  @@index([status, nextRetryAt])
  @@map("fiscal_invoices")
}

// Pista de auditoría fiscal (Providencia 102: registro automático e inalterable
// de quién hizo qué sobre un documento fiscal, y cuándo). Solo se inserta —
// nunca se actualiza ni se borra desde el código de la aplicación.
model FiscalAuditLog {
  id           String  @id @default(cuid())
  restaurantId String
  // Puede ser null cuando el evento es previo a existir la factura (ej.
  // ISSUE_ATTEMPT que falló antes de poder crear la fila).
  invoiceId    String?
  orderId      String?

  // "ISSUE_ATTEMPT" | "ISSUED" | "ISSUE_FAILED" | "CONTROL_NUMBER_ASSIGNED"
  // | "VOID_REQUESTED" | "VOIDED" | "CREDIT_NOTE_ISSUED" | "MODIFY_BLOCKED"
  // | "DELETE_BLOCKED" | "CONFIG_CHANGED"
  event String

  // Quién: usuario del restaurante, admin de plataforma, o el sistema (jobs).
  actorType String // "USER" | "PLATFORM_ADMIN" | "SYSTEM"
  actorId   String?
  actorName String?

  // Detalle libre del evento (montos, código de error, payload relevante).
  detail Json?

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([invoiceId])
  @@map("fiscal_audit_logs")
}

// Movimiento manual de caja (botón "Añadir movimiento" en Administración →
// Resumen): ingresos/egresos que no vienen de un pedido, y propinas sueltas.
// Solo lo ven/crean roles de acceso total (OWNER/ADMIN/CASHIER/STAFF).
model Movement {
  id              String       @id @default(cuid())
  restaurantId    String
  type            MovementType
  amountBase      Decimal      @db.Decimal(12, 2)
  description     String
  createdByUserId String?
  createdAt       DateTime     @default(now())

  // --- Botón "Añadir ingreso" (solo aplica cuando type = INCOME) ---
  incomeCategory IncomeCategory?
  // Con qué se recibió (INCOME) o con qué se pagó (EXPENSE) — en gastos sirve para cuadrar
  // la caja: no es lo mismo pagar la gasolina en efectivo que por transferencia.
  paymentMethod  PaymentMethod?

  // --- Módulo de Gastos (todos opcionales; no afectan ingresos/propinas) ---
  category             ExpenseCategory?
  supplierId           String?
  // Insumo reabastecido por este gasto (ej: compra de agua) y cantidad recibida:
  // al crear el movimiento, se suma automáticamente a InventoryItem.quantity.
  inventoryItemId      String?
  inventoryQuantity    Decimal?             @db.Decimal(12, 2)
  // Gasto tomado a crédito con el proveedor: cuenta pendiente por pagar
  // (al revés de Order.awaitingPayment, que es lo que el cliente le debe
  // al restaurante). El balance del período lo resta igual, ya esté pagado
  // o no — esto solo lleva el seguimiento de si ya se le pagó al proveedor.
  isCredit             Boolean              @default(false)
  creditPaidAt         DateTime?
  // Orden de pago que lo saldó (o que lo tiene incluido, si todavía está por autorizar).
  // Null = deuda suelta, sin orden. Ver PaymentOrder.
  paymentOrderId       String?
  // Fecha real del gasto cuando no es hoy (factura de hace unos días que se carga después).
  // Null = vale createdAt. El balance del período usa esta fecha si está, para que el gasto
  // caiga en el día que ocurrió y no en el que alguien lo escribió.
  expenseDate          DateTime?
  // Nº de factura/recibo/referencia de la transferencia, para conciliar con el soporte físico.
  referenceNumber      String?
  // Foto del recibo/factura (gasolinera, hotel, restaurante). Clave en gastos de viaje: el
  // soporte se pierde y sin él no hay cómo justificar el egreso.
  receiptImageUrl      String?
  // Foto del presupuesto/cotización que se aprobó antes de pagar (aparte de la factura).
  quoteImageUrl        String?
  // Foto del comprobante de pago (transferencia/Pago Móvil), aparte de la factura en sí —
  // un proveedor puede mandar ambos por separado.
  paymentProofImageUrl String?
  // Nota libre adicional a `description` (condiciones, por qué del gasto, detalle largo).
  notes                String?
  // Factura fiscal vs. nota de entrega — para poder distinguir de un vistazo al filtrar
  // por categoría cuáles gastos tienen soporte fiscal y cuáles no. Null = sin especificar.
  documentType         ExpenseDocumentType?
  // Detalle fiscal de la compra para el Libro de compras (SENIAT): base imponible e IVA
  // incluidos en `amountBase` (total pagado = base + IVA). Obligatorios cuando el
  // restaurante tiene IVA activado y el soporte es factura fiscal; opcionales si no.
  taxableBase          Decimal?             @db.Decimal(12, 2)
  ivaBase              Decimal?             @db.Decimal(12, 2)
  // Fecha de vencimiento de la factura del proveedor: alimenta la alerta de "facturas por
  // vencer/vencidas" en Cuentas por pagar. Null = sin vencimiento definido.
  invoiceDueDate       DateTime?
  // Gasto que se repite periódicamente (alquiler, nómina, servicios). Solo una etiqueta para
  // identificarlo/filtrarlo — no crea el siguiente movimiento automáticamente.
  isRecurring          Boolean              @default(false)
  // Quién hizo el gasto, cuando no fue quien lo registra (ej. el chofer que cargó gasolina).
  spentByName          String?
  // Evento (ShopProduct.isEvent) al que se le imputa este gasto: local, sonido, permisos,
  // publicidad. El costo de un evento no se escribe a mano — es la suma de los gastos que se
  // le asignan acá, así que se actualiza solo a medida que aparecen. SetNull: borrar el evento
  // no puede borrar el gasto, que igual salió de la caja.
  shopEventProductId   String?

  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdByUser User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  // SetNull y no Cascade: anular una orden de pago no puede borrar el gasto — la deuda
  // sigue existiendo, solo deja de estar dentro de esa orden.
  paymentOrder  PaymentOrder?  @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  shopEvent     ShopProduct?   @relation("ShopEventExpenses", fields: [shopEventProductId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, isCredit, creditPaidAt])
  @@index([paymentOrderId])
  @@index([shopEventProductId])
  @@map("movements")
}

/// Personal en nómina. Es una lista aparte de `User` a propósito: en nómina entra gente que
/// nunca toca el sistema (mantenimiento, limpieza, un profesor por horas), y al revés, un
/// usuario del panel puede no estar en nómina. Mezclarlos obligaría a crear logins falsos.
model Employee {
  id           String @id @default(cuid())
  restaurantId String

  name       String
  /// Cargo, texto libre: cada negocio nombra distinto los suyos.
  position   String?
  phone      String?
  idNumber   String?
  /// Sueldo acordado, como referencia al pagar. No dispara nada solo: los pagos se
  /// registran a mano (ver EmployeePayment), porque casi nunca coinciden exactos.
  salaryBase Decimal?  @db.Decimal(12, 2)
  /// Fecha en la que el trabajador entró — solo informativo (antigüedad), no dispara nada.
  hireDate   DateTime?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  payments   EmployeePayment[]
  /// Si este empleado además da clases en la academia.
  clubCoach  ClubCoach[]

  @@index([restaurantId, active])
  @@map("employees")
}

/// Un pago de nómina ya hecho. Cada uno genera además un `Movement` de tipo EXPENSE con
/// categoría PAYROLL, para que la nómina pese en el balance y en el arqueo de caja como
/// cualquier otro egreso — si no, el negocio se vería más rentable de lo que es.
model EmployeePayment {
  id           String @id @default(cuid())
  restaurantId String
  employeeId   String

  amountBase    Decimal        @db.Decimal(12, 2)
  /// Qué período cubre, texto libre ("Agosto 2026", "1ra quincena"). Libre porque cada
  /// negocio paga con su propio ritmo y encasillarlo obligaría a inventar reglas.
  periodLabel   String?
  paymentMethod PaymentMethod?
  note          String?
  /// Tasa BCV vigente al momento del pago y su equivalente en Bs — congelados igual que en
  /// Order, así el historial no cambia si la tasa sube después. null en pagos viejos (antes
  /// de este campo) o si no se pudo obtener la tasa.
  exchangeRate  Decimal?       @db.Decimal(18, 4)
  totalBs       Decimal?       @db.Decimal(14, 2)

  /// El gasto que generó. Sin relación FK: borrar el movimiento no debe borrar el
  /// historial de que a esa persona se le pagó.
  movementId String?

  paidAt          DateTime @default(now())
  createdByUserId String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([restaurantId, paidAt])
  @@index([employeeId])
  @@map("employee_payments")
}

/// Estado de una orden de pago a proveedor.
enum PaymentOrderStatus {
  PENDING /// Emitida, esperando que se autorice/ejecute el pago.
  PAID /// Pagada: sus gastos quedaron saldados (creditPaidAt).
  CANCELLED /// Anulada: los gastos vuelven a quedar como deuda suelta.
}

/// Orden de pago a un proveedor: agrupa una o varias cuentas por pagar (gastos a crédito)
/// en un solo documento con correlativo, para autorizar y registrar el pago de una vez.
///
/// Existe aparte de `Movement.creditPaidAt` porque marcar "pagado" gasto por gasto no deja
/// rastro de CÓMO se pagó ni de que varias facturas se saldaron en una sola transferencia,
/// que es justo lo que hay que poder mostrarle a un contador.
model PaymentOrder {
  id           String @id @default(cuid())
  restaurantId String

  /// Correlativo por negocio, igual criterio que Order.orderNumber / CashSession.closeNumber.
  orderNumber Int
  supplierId  String?

  status     PaymentOrderStatus @default(PENDING)
  /// Congelado al emitirla: la suma de los gastos incluidos en ese momento. No se recalcula
  /// después, para que el documento diga siempre lo que se autorizó.
  amountBase Decimal            @db.Decimal(12, 2)

  /// Con qué se pagó y su referencia — se llenan al marcarla pagada.
  paymentMethod   PaymentMethod?
  referenceNumber String?
  note            String?

  /// --- Detalle fiscal del pago (se llena al marcarla pagada; todos opcionales) ---
  /// Lo REALMENTE pagado, en moneda base. Existe aparte de `amountBase` (lo autorizado al
  /// emitirla) porque entre emisión y pago la tasa Bs/$ cambia — el pago en Bs ya no equivale
  /// al monto congelado de la orden.
  paidAmountBase    Decimal? @db.Decimal(12, 2)
  /// Si el pago se hizo en bolívares, el monto tal cual se pagó (antes de convertirlo a base
  /// con la tasa BCV del momento) — para conciliar contra el banco sin rehacer la conversión.
  paidAmountBs      Decimal? @db.Decimal(14, 2)
  /// Retenciones aplicadas por el negocio como agente de retención, en moneda base.
  islrRetentionBase Decimal? @db.Decimal(12, 2)
  ivaRetentionBase  Decimal? @db.Decimal(12, 2)
  /// Nota de crédito del proveedor que descuenta del total a pagar.
  creditNoteBase    Decimal? @db.Decimal(12, 2)
  /// Desglose informativo de la factura: IVA y total con IVA.
  ivaAmountBase     Decimal? @db.Decimal(12, 2)
  totalWithIvaBase  Decimal? @db.Decimal(12, 2)

  createdByUserId String?
  createdAt       DateTime  @default(now())
  paidByUserId    String?
  paidAt          DateTime?
  cancelledAt     DateTime?

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier      Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdByUser User?      @relation("PaymentOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  paidByUser    User?      @relation("PaymentOrderPaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  /// Soportes de la orden y de su pago: facturas, notas de crédito, planillas de retención y
  /// comprobantes de transferencia. Array de `{ url, name, type: 'image' | 'pdf', stage }`,
  /// donde `stage` distingue lo cargado al emitirla ('ORDER') de lo cargado al pagarla ('PAYMENT').
  /// JSON y no una tabla aparte: son adjuntos sueltos de un solo documento, nunca se consultan
  /// por separado (mismo criterio que `paymentMethodsConfig`).
  attachments   Json?

  /// Los gastos que esta orden salda.
  movements Movement[]

  @@index([restaurantId, status])
  @@index([restaurantId, orderNumber])
  @@map("payment_orders")
}

/// Moneda de una cuenta bancaria: la moneda base del negocio ($/€) o bolívares.
enum BankAccountCurrency {
  BASE
  BS
}

enum BankTransactionType {
  CREDIT // entra dinero (cobro de venta, ingreso manual, saldo inicial, ajuste +)
  DEBIT // sale dinero (gasto de contado, orden de pago, ajuste −)
  TRANSFER_IN // recibido de otra cuenta propia
  TRANSFER_OUT // enviado a otra cuenta propia
}

/// Cuenta bancaria (o caja chica) del negocio. Cada método de pago puede vincularse a UNA
/// cuenta: al registrar un cobro con ese método el saldo sube, y al registrar un gasto de
/// contado u orden de pago con ese método el saldo baja — ver bank-ledger.service.ts.
model BankAccount {
  id           String @id @default(cuid())
  restaurantId String

  name           String
  currency       BankAccountCurrency
  /// Caja chica: efectivo físico del día a día. Se comporta igual que una cuenta (se le
  /// vincula Efectivo, recibe transferencias), solo se distingue visualmente.
  isPettyCash    Boolean             @default(false)
  /// Bóveda: donde se guarda el efectivo que sale de la caja al cerrar el turno. Igual que
  /// caja chica es una cuenta normal; la marca sirve para ofrecerla como destino del
  /// traspaso al cerrar caja y para que no se confunda con el efectivo del día.
  isVault        Boolean             @default(false)
  /// Métodos de pago vinculados. El service valida que un método esté en UNA sola cuenta
  /// por negocio — si no, un cobro no sabría a qué banco sumar.
  paymentMethods PaymentMethod[]
  /// Saldo actual EN LA MONEDA DE LA CUENTA, denormalizado: se actualiza en la misma
  /// transacción que crea cada BankTransaction, nunca por fuera.
  balance        Decimal             @default(0) @db.Decimal(16, 2)

  createdAt DateTime @default(now())

  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([restaurantId])
  @@map("bank_accounts")
}

/// Libro mayor de una cuenta bancaria: cada crédito/débito/transferencia queda como fila,
/// para que el saldo siempre sea auditable movimiento por movimiento.
model BankTransaction {
  id           String @id @default(cuid())
  restaurantId String
  accountId    String

  type       BankTransactionType
  /// Monto en la moneda de la cuenta, siempre positivo (el signo lo da `type`).
  amount     Decimal             @db.Decimal(16, 2)
  /// Equivalente en moneda base del negocio, para totalizar cuentas Bs y $ juntas.
  amountBase Decimal             @db.Decimal(12, 2)

  description          String
  paymentMethod        PaymentMethod?
  /// Gasto/ingreso manual que originó este asiento — al borrar ese movimiento, el asiento
  /// se revierte (ver movement.service.remove).
  movementId           String?
  /// Id del cobro/orden de pago origen, solo trazabilidad (esos no se borran).
  sourceRef            String?
  /// Transferencias entre cuentas propias: la cuenta del otro lado.
  counterpartAccountId String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  account    BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([restaurantId, accountId, createdAt])
  @@index([movementId])
  @@map("bank_transactions")
}

// Proveedor al que se le compran insumos/servicios (módulo de Gastos).
model Supplier {
  id           String @id @default(cuid())
  restaurantId String

  name  String
  phone String?
  // RIF o cédula del proveedor.
  taxId String?

  createdAt DateTime @default(now())

  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  movements     Movement[]
  paymentOrders PaymentOrder[]
  ratings       SupplierRating[]

  @@index([restaurantId])
  @@map("suppliers")
}

/// Calificación de un proveedor (módulo Compras → Calificación de proveedores). Cada evaluación
/// es una fila (quién, cuándo, 4 criterios de 1 a 5 y comentario); el promedio se calcula al leer.
model SupplierRating {
  id           String @id @default(cuid())
  restaurantId String
  supplierId   String

  /// Criterios de 1 a 5.
  quality     Int
  price       Int
  punctuality Int
  service     Int
  comment     String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([restaurantId, supplierId])
  @@map("supplier_ratings")
}

/// Estructura de costo del restaurante (Administración → Estructura de costo): los elementos
/// fijos y variables que se le cargan a CADA producto vendido, expresados como % del precio de
/// venta (base imponible, sin servicio/IVA). Los fijos (arriendo, nómina, servicios…) se
/// prorratean así porque el costo por plato depende del volumen; la calculadora sugiere el %
/// real cruzando gastos recurrentes ÷ ventas del período. Una fila por restaurante, creada con
/// los elementos fundamentales la primera vez que se abre la pestaña.
model CostStructureConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  /// [{ id, label, kind: 'FIXED' | 'VARIABLE', percent, enabled }] — ver cost-structure.dto.ts.
  items Json

  /// Utilidad neta objetivo por producto (%). Con ella la calculadora sugiere el precio.
  targetNetMarginPercent Decimal @default(20) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("cost_structure_configs")
}

/// Estructura de costo guardada de UN producto: el material utilizado (líneas editables, sean
/// de la receta o cargadas a mano) más el snapshot del cálculo al momento de guardar. Es un
/// snapshot a propósito: si mañana cambian los % del restaurante o el precio, la ficha guardada
/// sigue diciendo con qué números se decidió — la calculadora avisa si quedó desactualizada.
model ProductCostStructure {
  id           String @id @default(cuid())
  restaurantId String
  productId    String @unique

  /// [{ name, quantity, unit, unitCost, totalCost, inventoryItemId? }]
  materials         Json
  materialsCostBase Decimal @db.Decimal(12, 2)

  /// % aplicados al guardar (suma de los items habilitados de cada tipo).
  variablePercent Decimal @db.Decimal(6, 2)
  fixedPercent    Decimal @db.Decimal(6, 2)

  /// Precio de venta usado y resultado del cálculo (moneda base).
  salePriceBase    Decimal @db.Decimal(12, 2)
  variableCostBase Decimal @db.Decimal(12, 2)
  fixedCostBase    Decimal @db.Decimal(12, 2)
  totalCostBase    Decimal @db.Decimal(12, 2)
  netProfitBase    Decimal @db.Decimal(12, 2)
  netMarginPercent Decimal @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("product_cost_structures")
}

/// Motivo por el que se perdió mercancía. Sirve para saber DÓNDE atacar la merma: no es lo
/// mismo que se venza el inventario (compras mal dimensionadas) que que se queme un plato
/// (proceso de cocina) o que el cliente devuelva (calidad/servicio).
enum WasteReason {
  EXPIRED /// Vencido / caducado
  DAMAGED /// Dañado, roto o mal almacenado
  PREPARATION /// Error de preparación (se quemó, salió mal)
  CUSTOMER_RETURN /// Devolución del cliente
  SPILLAGE /// Derrame o accidente
  THEFT /// Faltante / robo
  /// Pérdida estructural por el % de rendimiento del insumo (pelado, limpieza) — se genera
  /// sola al reabastecer, distinta de un error puntual de preparación.
  YIELD_LOSS
  OTHER /// Otro
}

/// Un registro de merma: mercancía que se perdió y NO se vendió. Puede ser un insumo del
/// inventario (se dañó la carne) o un producto terminado (se quemó una hamburguesa, el
/// cliente devolvió el plato). Es un asiento inmutable — se borra si se cargó por error,
/// nunca se "corrige" en sitio, para que el indicador de merma sea auditable.
///
/// `costBase` se congela al registrar (costo vivo del insumo o del producto en ese momento):
/// si mañana sube el precio del proveedor, la merma de ayer sigue valiendo lo que valía.
model WasteRecord {
  id           String @id @default(cuid())
  restaurantId String

  /// Exactamente uno de los dos (validado en el DTO): insumo o producto del menú.
  inventoryItemId String?
  productId       String?
  /// Snapshot del nombre, igual criterio que OrderItem.productName: si luego borran el
  /// insumo/producto, el histórico de merma sigue diciendo qué se perdió.
  itemName        String
  /// Unidad en la que se registró (la del insumo, o "und" para productos terminados).
  unit            String

  quantity Decimal @db.Decimal(12, 3)
  /// Costo total de lo perdido (cantidad × costo unitario vigente al registrar).
  costBase Decimal @db.Decimal(12, 2)

  reason WasteReason
  note   String?

  /// Si descontó existencia al registrarse. Falso cuando el insumo/producto no lleva stock.
  stockAdjusted Boolean @default(false)

  createdByUserId String?
  createdByName   String?
  /// Fecha real de la merma (puede ser de ayer). Mediodía Caracas, igual que Movement.expenseDate.
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([restaurantId, occurredAt])
  @@index([restaurantId, productId])
  @@index([restaurantId, inventoryItemId])
  @@map("waste_records")
}

// Directorio de clientes del restaurante: se crea/actualiza automáticamente
// (upsert por teléfono) cada vez que se abre una cuenta de mesa o se hace un
// pedido de delivery/pickup/manual con teléfono, para poder buscarlo después
// en vez de tipear los datos de nuevo.
model Customer {
  id           String @id @default(cuid())
  restaurantId String

  name      String
  phone     String
  idNumber  String?
  address   String?
  // --- Ficha CRM (opcionales; alimentan los segmentos y las promos personalizadas) ---
  email     String?
  /// Fecha de cumpleaños (solo importa mes y día; el año puede ser el real o 1900).
  birthday  DateTime?
  notes     String?
  /// Socio del local: consume a cuenta y ese consumo NO es una venta — no entra en
  /// ventas, ticket promedio, utilidad ni cierre de caja, pero sí descuenta inventario
  /// (la comida salió igual). Solo un dueño/administrador puede marcarlo, porque marcar
  /// a alguien como socio es, en la práctica, autorizarle consumo gratis.
  isPartner Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant           Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Historial de cancha del jugador (vertical SPORTS_CLUB).
  clubBookings         ClubBooking[]
  /// Ficha de academia, si además es alumno. La identidad es esta misma: el
  /// alumno no es una persona distinta del jugador que alquila cancha.
  clubStudent          ClubStudent?
  /// Cuenta de jugador, lista negra y puntos de fidelización.
  clubPlayerAccount    ClubPlayerAccount?
  clubBlacklist        ClubBlacklistEntry[]
  clubLoyalty          ClubLoyaltyEntry[]
  // CRM: campañas en las que está incluido y códigos que canjeó.
  promotionTargets     PromotionTarget[]
  promotionRedemptions PromotionRedemption[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, name])
  @@map("customers")
}

// ============================================================================
// Solicitudes de contacto con un asesor (Plan Elite)
// ============================================================================

enum AdvisorLeadStatus {
  PENDING // Recién llegó, nadie la ha tomado
  CONTACTED // Un asesor ya llamó
  CLOSED // Terminó en venta
  DISCARDED // No prosperó
}

// Prospecto que pidió que lo contacte un asesor en vez de contratar solo.
//
// El Plan Elite no se contrata desde la página: son sucursales ilimitadas, migración de
// catálogo y gerente de cuenta, cosas que se acuerdan hablando. El formulario deja el
// contacto acá y además dispara un WhatsApp al número verificador.
//
// La fila se guarda SIEMPRE, aunque el WhatsApp no salga: el número del máster puede estar
// desconectado o fuera de su ventana horaria, y un prospecto perdido no se recupera.
// notifiedAt distingue "ya lo avisamos" de "está acá pero nadie recibió el aviso".
model AdvisorLead {
  id           String           @id @default(cuid())
  /// Nombre de la persona que llenó el formulario.
  contactName  String
  /// Teléfono de contacto, tal cual lo escribió — es a donde va a llamar el asesor.
  phone        String
  address      String
  businessName String
  /// Qué plan miraba cuando pidió el contacto. Hoy siempre ELITE; queda por si mañana
  /// otro plan pasa a venderse hablado.
  plan         SubscriptionPlan @default(ELITE)

  status     AdvisorLeadStatus @default(PENDING)
  /// Notas del asesor tras la llamada.
  notes      String?
  /// Cuándo salió el aviso por WhatsApp. Null = la solicitud está acá pero el aviso no salió.
  notifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("advisor_leads")
}

// ============================================================================
// CRM: promociones personalizadas con código canjeable
// ============================================================================

enum PromotionDiscountType {
  PERCENT
  AMOUNT
}

/// Una campaña de descuento dirigida a una lista de clientes del CRM. El código
/// lo escribe el cajero al cobrar: ahí se aplica el descuento Y queda el canje
/// registrado (PromotionRedemption) — sin código no hay trazabilidad de la promo.
model Promotion {
  id           String @id @default(cuid())
  restaurantId String

  name    String
  /// Mensaje de WhatsApp con placeholders {{nombre}}, {{codigo}}, {{descuento}} y {{vigencia}}.
  message String?
  /// Código canjeable. Único por negocio (se guarda en MAYÚSCULAS).
  code    String

  discountType  PromotionDiscountType
  /// % (0-100) si PERCENT; monto en moneda base si AMOUNT.
  discountValue Decimal               @db.Decimal(12, 2)

  /// Vigencia opcional. Fuera de rango el código no valida.
  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(true)

  /// Con qué segmento del CRM se armó la lista (ALL/FREQUENT/NEW/INACTIVE/BIRTHDAY/MANUAL) — informativo.
  segment           String?
  /// Máximo de canjes por cliente (0 = sin límite).
  maxPerCustomer    Int     @default(1)
  /// Si es true, el código solo vale para los clientes de la lista; si es false,
  /// cualquiera que lo tenga puede canjearlo.
  restrictToTargets Boolean @default(true)

  createdAt DateTime @default(now())

  restaurant  Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  targets     PromotionTarget[]
  redemptions PromotionRedemption[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
  @@map("promotions")
}

/// Un cliente incluido en la lista de una campaña. `sentAt` marca cuándo se le
/// envió el mensaje por WhatsApp (el envío es 1 a 1, con un clic por cliente).
model PromotionTarget {
  id          String    @id @default(cuid())
  promotionId String
  customerId  String
  sentAt      DateTime?

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([promotionId, customerId])
  @@map("promotion_targets")
}

/// Un canje real del código en caja, con el descuento que efectivamente se aplicó.
model PromotionRedemption {
  id           String  @id @default(cuid())
  restaurantId String
  promotionId  String
  customerId   String?
  /// Id del pedido/venta/reserva donde se canjeó — trazabilidad, texto libre.
  sourceRef    String?
  /// Descuento aplicado, congelado en moneda base.
  amountBase   Decimal @db.Decimal(12, 2)

  redeemedByUserId String?
  createdAt        DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  promotion  Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([promotionId])
  @@index([restaurantId, createdAt])
  @@map("promotion_redemptions")
}

// Turno de caja (botón "Abrir Caja" / "Cerrar Caja" en Administración → Resumen).
// Solo puede haber una sesión OPEN por restaurante a la vez. Al cerrar se
// congela un snapshot del movimiento del turno en `closingSummary`, para que
// el recibo descargable no cambie si luego se registran movimientos tardíos.
model CashSession {
  id           String            @id @default(cuid())
  restaurantId String
  status       CashSessionStatus @default(OPEN)

  openedByUserId  String?
  openedAt        DateTime @default(now())
  // Saldo declarado al abrir, por método de pago: Record<PaymentMethod, string>.
  openingBalances Json

  closedByUserId String?
  closedAt       DateTime?
  // Correlativo por restaurante, asignado recién al cerrar (igual que Order.orderNumber).
  closeNumber    Int?
  // Snapshot calculado al cerrar: ventas por método + movimientos + totales.
  closingSummary Json?

  // --- Arqueo (conteo físico al cerrar) ---
  // Lo que el cajero CONTÓ de verdad, por método de pago: Record<PaymentMethod, string>.
  // Es opcional: el cierre de siempre (solo resumen del turno, sin contar) sigue siendo
  // válido y deja esto en null. Cuando viene cargado, el snapshot congela también el
  // sobrante/faltante contra lo esperado, que es lo que convierte el cierre en un arqueo.
  countedBalances Json?

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  openedByUser User?      @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)
  closedByUser User?      @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status])
  @@index([restaurantId, closeNumber])
  @@map("cash_sessions")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  // Referencia al producto (puede quedar en null si el producto se borra),
  // pero conservamos un snapshot del nombre y precio para historial.
  productId String?

  productName String
  // Nombre de la variante elegida (si el producto usa "Precio por variantes"), congelado igual que productName.
  variantName String?
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int     @default(1)
  lineTotal   Decimal @db.Decimal(12, 2)

  // Cuánto de esta línea ya se cobró (fraccionar pago por ítems). Nunca supera `quantity`;
  // no es la fuente de verdad de "pedido saldado" (eso sigue siendo por monto en Order/OrderPayment).
  paidQuantity Int @default(0)

  // Nota de cocina (ej: "Sin cebolla").
  note String?

  // Snapshot de la cocina asignada al producto al momento del pedido (null =
  // sin asignar). Se congela igual que productName: si luego el producto
  // cambia de cocina, este ítem no se mueve retroactivamente de comanda.
  kitchenName      String?
  // Cuándo la cocina empezó a preparar esta parte de la comanda ("En proceso"):
  // marca visual para que el cocinero sepa qué ya está en fuego sin haberlo servido.
  // Es solo informativa (no cambia el estado del pedido); se congela al primer toque.
  kitchenStartedAt DateTime?
  // Cuándo esa estación de cocina marcó su parte de la comanda como lista.
  // El pedido completo pasa a SERVED solo cuando todos sus ítems tienen esto.
  kitchenReadyAt   DateTime?
  // "Entregado" — el mesero lo marca cuando de verdad lo lleva a la mesa/cliente, aparte de
  // kitchenReadyAt (que es "cocina ya lo hizo", no "ya lo tiene el comensal"). Sirve para saber
  // qué falta por sacar Y como condición para pedir motivo al reducir/quitar la línea: bajar
  // algo que nunca salió es una simple corrección, bajar algo ya entregado es una devolución
  // (ver returnItem en order.service.ts, que además la registra en Merma con
  // WasteReason.CUSTOMER_RETURN — misma tabla que "estadística aparte" de devoluciones).
  deliveredAt      DateTime?

  // Cuándo entró esta línea a la comanda. En un pedido nuevo es igual al createdAt del pedido,
  // pero un producto añadido después llega mucho más tarde — y es lo que cocina necesita para
  // contar el tiempo de SU tanda, no el del pedido entero.
  createdAt    DateTime @default(now())
  // Número de tanda dentro del pedido: 1 = lo que se pidió al abrir la comanda, 2+ = cada
  // ronda añadida después. Cocina muestra una tarjeta por tanda para que no se confunda lo
  // nuevo con lo viejo; en Pedidos el pedido sigue siendo uno solo. Lo asigna addItem
  // agrupando por cercanía en el tiempo (ver VENTANA_TANDA_MS), porque el panel añade los
  // productos de una misma ronda uno por uno.
  kitchenBatch Int      @default(1)

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@map("order_items")
}

// Modificador elegido en un ítem del pedido — snapshot de nombre/precio, igual que productName.
model OrderItemModifier {
  id          String  @id @default(cuid())
  orderItemId String
  // Referencia al Modifier del catálogo. Se guarda SOLO para poder resolver el
  // insumo vinculado al descontar stock; el resto del renglón sigue siendo
  // snapshot (name/priceBase no cambian si luego editan el modificador). Es
  // nullable a propósito: los pedidos anteriores a este campo no lo tienen, y
  // un modificador borrado no debe romper el histórico.
  modifierId  String?
  name        String
  priceBase   Decimal @db.Decimal(12, 2)
  // Cuántas veces se eligió esta misma opción (ej. "Ketchup x4"). Snapshot, igual que name/priceBase.
  quantity    Int     @default(1)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

// ----------------------------------------------------------------------------
//  SOLICITUD DE PLAN (lead desde la landing, previo al registro de cuenta)
// ----------------------------------------------------------------------------

// Un prospecto elige un plan + método de pago en la landing y sube su
// comprobante. No está ligado a un Restaurant: en este punto del embudo
// todavía no existe la cuenta. Se revisa manualmente por ahora.
model PlanRequest {
  id String @id @default(cuid())

  // SIGNUP: enviado desde la landing, antes de existir la cuenta (restaurantId
  // null hasta que el admin de plataforma lo vincula al aprobar). RENEWAL:
  // enviado autenticado desde el panel del restaurante, restaurantId siempre presente.
  kind         PlanRequestKind   @default(SIGNUP)
  status       PlanRequestStatus @default(PENDING)
  restaurantId String?

  plan         SubscriptionPlan
  billingCycle BillingCycle

  // Solo si plan = CUSTOM: los valores que el prospecto ajustó en el slider.
  customTables          Int?
  customUsers           Int?
  customOrders          Int?
  // Solo si plan = CUSTOM: adicionales elegidos (se copian a Restaurant al aprobar).
  customAdministration  Boolean @default(false)
  customInventoryBasic  Boolean @default(false)
  customInventoryRecipe Boolean @default(false)
  customAccountsPayable Boolean @default(false)

  // Código promocional aplicado (si hubo). El descuento ya está reflejado en priceUsd.
  promoCode       String?
  discountPercent Int?

  // Precio mensual calculado en el servidor a partir del plan/ciclo (o de la fórmula del plan
  // personalizado) y el código promocional. Nunca se confía en un precio enviado por el cliente.
  // El sufijo "Usd" es histórico: la moneda real es PlatformSettings.subscriptionCurrency.
  priceUsd Decimal @db.Decimal(10, 2)

  paymentMethod    SubscriptionPaymentMethod
  // Número de referencia de la transferencia/pago móvil/Binance (antes se
  // subía una foto/PDF del comprobante; ahora el restaurante solo escribe
  // este número y el equipo de QuickTap lo valida contra su banco). Para
  // paymentMethod = RAMBLAY, se llena con el id que devuelve Ramblay al crear
  // el pago (igual que ramblayPaymentId) en vez de un número tecleado a mano.
  paymentReference String
  // Comprobante opcional del pago único (aparte del número de referencia): si el restaurante lo
  // adjunta, se reenvía de una vez al número verificador por WhatsApp (ver
  // plan-request.controller.ts#notifyVerifierOfProof) para que el equipo lo revise sin tener que
  // entrar al Dashboard maestro. Null = no adjuntó nada, sigue el flujo de siempre.
  proofImageUrl    String?

  // Id de la transacción/sesión de pago en Ramblay (solo paymentMethod = RAMBLAY).
  // Correlaciona el webhook de "pago aprobado/rechazado" con esta solicitud.
  ramblayPaymentId String? @unique

  contactName    String
  contactEmail   String
  contactPhone   String?
  restaurantName String?

  createdAt DateTime @default(now())

  restaurant Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  // Abonos del "pago fraccionado" (solo pago manual): cada uno con su propio
  // monto/método/comprobante, hasta cubrir priceUsd — ver plan-request.service.ts.
  // Vacío para una solicitud de pago único de siempre.
  payments   PlanRequestPayment[]

  @@index([restaurantId])
  @@index([kind, status])
  @@map("plan_requests")
}

// Un abono individual de un "pago fraccionado" hacia una PlanRequest (pago
// manual de mensualidad/inscripción). El restaurante puede registrar varios
// hasta cubrir PlanRequest.priceUsd; el equipo QuickTap los revisa todos
// (con su comprobante) antes de "Activar cuenta" desde el Dashboard maestro.
model PlanRequestPayment {
  id               String                    @id @default(cuid())
  planRequestId    String
  amountUsd        Decimal                   @db.Decimal(10, 2)
  paymentMethod    SubscriptionPaymentMethod
  paymentReference String
  proofImageUrl    String
  createdAt        DateTime                  @default(now())

  planRequest PlanRequest @relation(fields: [planRequestId], references: [id], onDelete: Cascade)

  @@index([planRequestId])
  @@map("plan_request_payments")
}

// Solicitud de cotización de QR NFC (hardware físico). Siempre viene de un
// restaurante ya autenticado (no hay flujo público como en PlanRequest), y no
// lleva comprobante: el equipo de QuickTap la revisa y contacta al restaurante.
model QrNfcRequest {
  id String @id @default(cuid())

  restaurantId String

  quantity      Int
  unitPriceUsd  Decimal            @db.Decimal(10, 2)
  totalPriceUsd Decimal            @db.Decimal(10, 2)
  status        QrNfcRequestStatus @default(PENDING)

  contactName  String
  contactEmail String
  contactPhone String?

  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([status])
  @@map("qr_nfc_requests")
}

// Cotización/presupuesto: un total para aprobar (catering, pedido grande, venta al mayor) sin
// cobrar ni afectar cocina/inventario todavía. Sirve tanto para restaurantes como para Locales
// Comerciales — `items` es JSON libre en vez de relaciones a Product/ShopProduct porque cada
// negocio tiene un catálogo con forma distinta; lo único que importa acá es nombre/cantidad/precio
// ya congelados, igual que OrderItem congela lo suyo al momento de la venta real.
model Quote {
  id           String @id @default(cuid())
  restaurantId String

  customerName  String?
  customerPhone String?
  note          String?

  // [{ name, qty, unitPrice }] — snapshot de lo cotizado, no referencias vivas al catálogo.
  items     Json
  totalBase Decimal  @db.Decimal(12, 2)
  currency  Currency

  // Se llena cuando el cliente aprueba y el presupuesto se convierte en una venta real —
  // Order.id para restaurantes, ShopSale.id para Locales Comerciales (un solo campo de texto
  // libre porque son dos tablas distintas; no hay integridad referencial cruzada a propósito).
  convertedToId String?
  createdAt     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("quotes")
}

// Cobro puntual que el equipo QuickTap le suma a un restaurante por fuera de
// la mensualidad (Dashboard maestro → Cobro): setup, diseño, QR NFC, soporte
// extra, etc. Se suma al total de la próxima mensualidad, pero SIEMPRE se
// muestra desglosado y etiquetado como cargo adicional — el restaurante tiene
// que poder ver por qué está pagando más que su tarifa mensual habitual.
// Acciones que el dueño puede poner bajo aprobación (ver ApprovalRequest y Restaurant.approvalActions).
enum ApprovalAction {
  PRODUCT_PRICE // Cambiar el precio de venta de un producto.
  PRODUCT_DELETE // Eliminar un producto del catálogo.
  PRICE_RAISE // Aumento general de precios del local.
  STOCK_ADJUST // Recuento físico: fijar el stock a mano.
  SALE_RETURN // Anular/devolver una venta ya cobrada.
}

enum ApprovalStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

/// Cambio que un administrador quiso hacer y que quedó esperando el visto bueno del dueño.
///
/// Existe porque el dueño de un local no está en el mostrador: delega en un administrador, pero
/// hay cosas que no quiere que pasen sin enterarse — bajarle el precio a un producto, anular una
/// venta cobrada, "corregir" el stock. Ninguna de esas deja rastro evidente si se hace y ya.
///
/// La acción NO se ejecuta al pedirla: se guarda con todo lo necesario para ejecutarla después
/// (`payload`), y recién corre cuando el dueño aprueba. Se guarda también `summary`, la frase en
/// español que describe el pedido, congelada al momento de pedirlo: si se arma al mostrarla, un
/// producto renombrado o borrado haría que el historial dijera otra cosa de la que se aprobó.
model ApprovalRequest {
  id           String @id @default(cuid())
  restaurantId String

  action  ApprovalAction
  /// Lo que hace falta para ejecutar la acción (ids, montos). Es JSON porque cada acción lleva
  /// datos distintos y no vale la pena una columna por cada una.
  payload Json
  /// "Bajar Manguera 1/2 de $6,00 a $4,50" — congelado al pedirlo, ver arriba.
  summary String

  status              ApprovalStatus @default(PENDIENTE)
  requestedByUserId   String
  /// Congelado igual que el resumen: si al empleado lo dan de baja, el historial debe seguir
  /// diciendo quién pidió el cambio.
  requestedByUserName String

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?

  appliedAt  DateTime?
  /// Por qué falló al aplicarse (ej. el producto ya no existe). Se guarda en vez de perderse:
  /// una solicitud aprobada que no se ejecutó tiene que poder verse, o el dueño cree que el
  /// cambio se hizo.
  applyError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@map("approval_requests")
}

// En qué va una personalización pedida por un local (ver Customization).
enum CustomizationStatus {
  SOLICITADA // Pedida por el local, todavía sin empezar.
  EN_DESARROLLO
  ENTREGADA // Ya está en producción; es cuando se genera el cargo.
  DESCARTADA // No se va a hacer (no se cobra).
}

/// Trabajo a medida que se le hace a UN local: una pantalla, un cálculo, un reporte que solo
/// ese negocio necesita (ej. el control de lotes por peso de Monte Ranch).
///
/// Existe por dos motivos, y el segundo es el que no cubría nada:
///  1. Cobrar: al marcarla ENTREGADA se crea el AdditionalCharge por su monto, que entra en la
///     próxima mensualidad y que el local ve desglosado (ver ChargeBreakdown).
///  2. Recordar: con varios locales encima es fácil perder de vista qué se le construyó a cada
///     uno y quién lo pidió. El cargo por sí solo no lo dice — se cobra una vez y desaparece
///     del pendiente, mientras que la personalización sigue viva en el producto para siempre.
model Customization {
  id           String @id @default(cuid())
  restaurantId String

  /// Lo que se le muestra al local al cobrarlo, así que se escribe en su idioma, no en el
  /// nuestro: "Control de lotes por peso", no "FIFO en shop.service".
  title  String
  /// Detalle interno: qué se hizo, qué pidió exactamente, cualquier cosa que sirva para
  /// retomarlo dentro de un año. No se le muestra al local.
  detail String?

  status    CustomizationStatus @default(SOLICITADA)
  /// Lo que se le cobra por el desarrollo, una sola vez. Puede ser 0: hay personalizaciones que
  /// se regalan para cerrar una venta, y conviene dejarlas registradas igual.
  amountUsd Decimal             @db.Decimal(10, 2)

  requestedAt DateTime  @default(now())
  deliveredAt DateTime?

  /// El cargo que se generó al entregarla. Queda enlazado para no cobrar dos veces si se
  /// marca ENTREGADA de nuevo, y para poder rastrear el cobro desde la personalización.
  additionalChargeId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  additionalCharge AdditionalCharge? @relation(fields: [additionalChargeId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status])
  @@map("customizations")
}

model AdditionalCharge {
  id           String @id @default(cuid())
  restaurantId String

  amountUsd   Decimal @db.Decimal(10, 2)
  // El "x motivo" que se le muestra al restaurante al cobrarle.
  description String

  // Se marca al aprobar la solicitud de plan que lo incluyó (ver
  // applyActivation), para que no se vuelva a cobrar en la mensualidad
  // siguiente.
  chargedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customization Customization?

  @@index([restaurantId, chargedAt])
  @@map("additional_charges")
}

// Códigos de descuento para la pasarela de pago (10%–100%).
model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  // Vencimiento opcional, calculado al crear el código a partir de
  // durationValue + durationUnit (ej. 7 DAY). Null = sin vencimiento.
  expiresAt     DateTime?
  durationValue Int?
  durationUnit  PromoCodeDurationUnit?

  @@map("promo_codes")
}

// Configuración global (no por restaurante) de la plataforma: datos de pago
// mostrados en la pasarela manual. Fila única, JSON flexible.
/// Cada llamada al servicio de IA, con lo que costó en tokens.
///
/// Es dato de la PLATAFORMA, no de un inquilino: la carga de catálogo la corre el equipo de
/// QuickTap sobre el restaurante que sea, y quien paga la factura de Gemini es QuickTap. Por
/// eso `restaurantId` es opcional y sin relación — sirve para saber a qué cliente se le estaba
/// cargando, y tiene que sobrevivir a que ese restaurante se borre; una fila de gasto ya
/// ocurrido no se puede desaparecer porque el cliente se dio de baja.
model AiUsage {
  id String @id @default(cuid())

  /// Qué se le pidió: "leer-insumos", "clasificar-insumos", "fichas-tecnicas"...
  operacion    String
  modelo       String
  restaurantId String?
  /// Nombre del restaurante congelado al momento de la llamada, por lo mismo de arriba.
  restaurante  String?

  /// Tokens de entrada (lo que se le mandó) y de salida (lo que escribió). `razonamiento` es
  /// lo que el modelo piensa antes de contestar: se cobra igual y no aparece en ninguno de los
  /// dos, así que se guarda aparte — era el 34% del gasto antes de poder apagarlo.
  entrada      Int @default(0)
  salida       Int @default(0)
  razonamiento Int @default(0)
  total        Int @default(0)

  /// Cuánto tardó la llamada, en milisegundos.
  ms Int @default(0)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([operacion, createdAt])
  @@index([restaurantId, createdAt])
  @@map("ai_usage")
}

model PlatformSettings {
  id                   String   @id @default("singleton")
  paymentMethods       Json?
  // Interruptores globales de la pasarela de pago (landing + billing autenticado).
  // Si se apagan ambos, PaymentForm no deja pagar hasta que se reactive uno.
  ramblayEnabled       Boolean  @default(true)
  manualPaymentEnabled Boolean  @default(true)
  // Interruptor global de los botones "Mejorar con IA" / "Fondo blanco con IA"
  // (ai-photo-service, facturado con una sola API key de Gemini pagada por
  // QuickTap, no por restaurante) — apagarlo bloquea ambos botones en todos
  // los restaurantes y locales a la vez.
  aiPhotoEnabled       Boolean  @default(true)
  // Precios/descripción editables por plan desde el Dashboard maestro. Parcial
  // (solo los planes que el master haya tocado); se fusiona con los valores
  // por defecto en platform-settings.service.ts al leer.
  planContent          Json?
  // Moneda en la que QuickTap cobra la mensualidad de sus restaurantes/locales — no confundir
  // con Restaurant.baseCurrency, que es la moneda del MENÚ de cada tenant. Cambiarla no
  // recalcula los precios ya cargados en `planContent`/`customMonthlyPriceUsd`: solo cambia el
  // símbolo con el que se muestran y se cobran de ahí en adelante (ver Dashboard maestro → Planes).
  subscriptionCurrency Currency @default(USD)

  // --- Chatbot de WhatsApp de la plataforma (ver src/modules/master-whatsapp/) ---
  // Mismo mecanismo de vinculación por QR que el bot de cada restaurante
  // (whatsapp-bot.service.ts), pero una única sesión para todo QuickTap: manda el
  // saludo de bienvenida al registrarse un restaurante y los recordatorios de
  // renovación de plan.
  masterWhatsappEnabled         Boolean @default(false)
  masterWhatsappConnectedNumber String?
  // Número (solo dígitos) que recibe el comprobante de cada renovación y responde
  // "Aprobado"/"Rechazado" — igual criterio que Restaurant.whatsappBotPaymentVerifierPhone.
  // null = el recordatorio de pago se sigue mandando, pero no hay a quién reenviarle el
  // comprobante (el equipo QuickTap debe revisarlo a mano en Comprobantes).
  subscriptionVerifierPhone     String?
  // Plantillas editables de los mensajes que manda el bot del master (recordatorio de pago,
  // acuse de comprobante recibido, pago aprobado/rechazado, bienvenida) — parcial, se fusiona
  // con los valores por defecto en platform-settings.service.ts (DEFAULT_MESSAGE_TEMPLATES).
  messageTemplates              Json?

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

enum SubscriptionPaymentVerificationStatus {
  AWAITING_PROOF // esperando que el dueño mande la foto del comprobante de renovación
  PENDING_FORWARD // ya llegó la foto, pero hay otra verificación en curso — en cola
  AWAITING_VERIFIER // foto reenviada al verificador, esperando "Aprobado"/"Rechazado"
  APPROVED
  REJECTED
  TIMED_OUT
}

// Verificación de pago de RENOVACIÓN de plan por el chatbot maestro de WhatsApp (distinto de
// OrderPaymentVerification, que es por pedido de un cliente). Mismas reglas centrales: solo
// puede haber UNA fila en AWAITING_VERIFIER a la vez (acá para toda la plataforma, no por
// restaurante, porque hay un solo número verificador) — así "Aprobado" nunca es ambiguo.
model SubscriptionPaymentVerification {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Teléfono del dueño normalizado a solo dígitos (Restaurant.whatsappPhone), para matchear
  // la foto entrante igual que OrderPaymentVerification.customerPhone.
  ownerPhone String

  status SubscriptionPaymentVerificationStatus @default(AWAITING_PROOF)

  plan         SubscriptionPlan
  billingCycle BillingCycle
  // Monto informado en el recordatorio (referencia — la renovación real usa nextPeriodEnd()
  // sobre plan/billingCycle, nunca este monto, igual criterio que PlanRequest).
  amountUsd    Decimal?         @db.Decimal(10, 2)

  proofImageUrl         String?
  proofReceivedAt       DateTime?
  forwardedToVerifierAt DateTime?
  verifierRepliedAt     DateTime?
  resolvedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerPhone, status])
  @@map("subscription_payment_verifications")
}

// Cuenta del equipo de QuickTap (no de un restaurante) con acceso al
// Dashboard maestro: ve todos los restaurantes, revisa comprobantes, etc.
// ADMIN y MANAGER (Gestor) tienen el mismo acceso total al Dashboard maestro;
// el rol es solo para identificar quién es quién en la lista de cuentas.
enum PlatformAdminRole {
  ADMIN
  MANAGER
}

model PlatformAdmin {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  role         PlatformAdminRole @default(ADMIN)
  createdAt    DateTime          @default(now())

  @@map("platform_admins")
}

enum PlatformQuoteStatus {
  /// Creada, todavía sin enviar al cliente.
  PENDING
  /// Enviada por WhatsApp (por el bot de la plataforma o a mano vía wa.me).
  SENT
  /// El cliente aceptó — pasa a la pestaña de aprobadas del Master.
  APPROVED
}

/// Cotización/presupuesto del equipo QuickTap para un FUTURO cliente (Master →
/// Cotizaciones): plan sugerido + cargos únicos personalizables (instalación,
/// placas, etc.), enviada por WhatsApp. No confundir con Quote, que son las
/// cotizaciones que un tenant le hace a SUS clientes.
model PlatformQuote {
  id                String              @id @default(cuid())
  quoteNumber       Int                 @unique @default(autoincrement())
  clientName        String
  clientPhone       String
  businessName      String?
  /// Plan sugerido (etiqueta libre: "Pro", "Sucursales", "Canchas"…).
  planName          String
  /// Precio del plan por ciclo, editable — no se ata al precio vigente del plan.
  planPriceUsd      Decimal             @db.Decimal(12, 2)
  /// "Mensual" | "Trimestral" | "Semestral" (etiqueta libre).
  planCycle         String              @default("Mensual")
  /// Cargos únicos personalizables: [{ label: "Instalación", amountUsd: 60 }, …].
  items             Json                @default("[]")
  /// Cargos recurrentes MENSUALES adicionales al plan (ej. Homologación de facturas):
  /// [{ label: "Homologación (100 facturas)", amountUsd: 60 }, …]. Se facturan cada mes
  /// aparte del ciclo del plan, no entran en el pago inicial de instalación.
  recurringItems    Json                @default("[]")
  /// planPriceUsd + suma de items — congelado al guardar, para listar sin recalcular.
  totalUsd          Decimal             @db.Decimal(12, 2)
  /// Suma de recurringItems — congelado al guardar, igual criterio que totalUsd.
  recurringTotalUsd Decimal             @default(0) @db.Decimal(12, 2)
  note              String?
  status            PlatformQuoteStatus @default(PENDING)
  sentAt            DateTime?
  approvedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, createdAt])
  @@map("platform_quotes")
}

/// Borrador/aviso de actualización del equipo QuickTap, editable desde el dashboard master antes
/// de mandarlo por el chatbot de la plataforma (ver src/modules/master-whatsapp/). El flujo es
/// crear -> revisar/editar el texto -> "Enviar", que dispara masterWhatsappBotService.broadcast()
/// solo a los restaurantes/locales activos que coincidan con targetBusinessType.
model PlatformAnnouncement {
  id                 String             @id @default(cuid())
  message            String
  // null = manda a restaurantes y locales por igual.
  targetBusinessType BusinessType?
  status             AnnouncementStatus @default(DRAFT)
  sentAt             DateTime?
  // Cuántos números se encolaron al mandar — congelado en el momento del envío, no se recalcula.
  sentCount          Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, createdAt])
  @@map("platform_announcements")
}

enum AnnouncementStatus {
  DRAFT
  SENT
}

// ----------------------------------------------------------------------------
//  INVENTARIO (solo plan Premium)
//  Lista simple de insumos con cantidad en existencia y stock mínimo, para
//  avisar cuándo hay que reabastecer. No descuenta automáticamente por venta:
//  el equipo ajusta la cantidad manualmente.
// ----------------------------------------------------------------------------
model InventoryCategory {
  id           String @id @default(cuid())
  restaurantId String

  name     String
  priority Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      InventoryItem[]

  @@index([restaurantId, priority])
  @@map("inventory_categories")
}

model InventoryItem {
  id           String  @id @default(cuid())
  restaurantId String
  categoryId   String?

  name             String
  photoUrl         String?
  // Unidad restringida desde el formulario: "kg" | "lt" | "unidad".
  unit             String
  quantity         Decimal  @default(0) @db.Decimal(12, 2)
  minQuantity      Decimal  @default(0) @db.Decimal(12, 2)
  // Costo por 1 unidad (kg/lt/unidad), en la moneda base del restaurante.
  // Se recalcula al cargar un precio + cantidad desde el formulario de
  // insumos, y alimenta el cálculo automático del costo de receta.
  pricePerUnitBase Decimal? @db.Decimal(14, 4)

  // Qué porcentaje de este insumo queda realmente aprovechable tras merma o
  // limpieza (ej. 90 = de 1 kg comprado solo 900 gr sirven). Colchón por
  // fluctuación de precio del proveedor. Ambos ajustan pricePerUnitBase antes
  // de costear una receta o preparación (ver src/modules/inventory/costing.ts)
  // — 100/0 = comportamiento idéntico al de antes de agregar estos campos.
  yieldPercent      Decimal @default(100) @db.Decimal(5, 2)
  correctionPercent Decimal @default(0) @db.Decimal(5, 2)

  // Fecha de caducidad del lote en stock, "YYYY-MM-DD" en hora de Caracas.
  // String y no DateTime a propósito: guardado como fecha UTC, un insumo que
  // vence "el 3" se leería como el 2 en Venezuela (UTC-4). Mismo criterio que
  // ShopProduct.expiryDate. Null = no caduca o no se lleva el control.
  expiryDate String?

  // --- Envase (envase/caja/bolsa) ---
  // No nulo = este insumo está disponible para vincularse como envase de un producto
  // (Product.packagingItemId), sin importar en qué InventoryCategory esté archivado.
  packagingType String?
  // Precio que se le cobra al cliente por 1 unidad de este envase (distinto de
  // pricePerUnitBase, que es costo). Solo tiene efecto cuando packagingType no es null.
  salePriceBase Decimal? @db.Decimal(12, 2)

  // "LOCAL" (de siempre) = insumo normal de esta sede; "CASA_MATRIZ" = vive en la
  // ventana aparte de Casa Matriz (solo existe en la sede principal, ver
  // Restaurant.casaMatrizEnabled). Incluido en la resolución de "compartido/por sede"
  // de src/modules/inventory/inventory-scope.ts.
  locationScope String @default("LOCAL")

  // Marca este insumo como disponible en la pestaña Inventario → Recetas → Toppings, para
  // poder elegirlo directo al crear un modificador (en vez de buscarlo entre todos los
  // insumos) — el vínculo real con el modificador sigue siendo Modifier.inventoryItemId,
  // esto solo lo hace aparecer en ese picker curado. No cambia en nada su comportamiento
  // como insumo normal (sigue contando para recetas, merma, alertas, etc.).
  isTopping Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant        Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category          InventoryCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipeLines       RecipeIngredient[]
  wasteRecords      WasteRecord[]
  preparationLines  PreparationIngredient[]
  modifiers         Modifier[]
  movements         Movement[]
  packagingProducts Product[]               @relation("ProductPackaging")

  @@index([restaurantId])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, packagingType])
  @@index([restaurantId, locationScope])
  @@map("inventory_items")
}

// Registro histórico de una transferencia de insumos entre sedes de un mismo grupo
// (sede principal + sucursales), o entre Casa Matriz y una sede. Snapshot de nombres
// (igual criterio que Order congela productName): el historial no debe cambiar si el
// insumo o la sede se renombran/borran después.
model InventoryTransfer {
  id      String @id @default(cuid())
  // Id de la sede principal del grupo (self o parentRestaurantId) — ancla el
  // historial a un grupo entero sin importar desde qué sede se consulte.
  groupId String

  fromRestaurantId String
  fromScope        String // "LOCAL" | "CASA_MATRIZ"
  fromLocationName String
  toRestaurantId   String
  toScope          String
  toLocationName   String

  itemName String
  unit     String
  quantity Decimal @db.Decimal(12, 2)

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([groupId, createdAt])
  @@map("inventory_transfers")
}

// Línea de receta: cuánto de un insumo (InventoryItem) o de una preparación
// (Preparation, ver más abajo) usa un producto del menú por cada unidad
// vendida, y su costo. Exactamente uno de inventoryItemId/preparationId debe
// estar presente (validado en recipe.dto.ts, no a nivel de DB). Vender el
// producto (al marcarlo SERVED) descuenta insumo(s) base automáticamente —
// si la línea apunta a una preparación, se resuelve recursivamente hasta sus
// insumos (ver resolveConsumedInventoryItems en costing.ts).
model RecipeIngredient {
  id                               String  @id @default(cuid())
  restaurantId                     String
  productId                        String
  inventoryItemId                  String?
  preparationId                    String?
  // "A elección del cliente": en vez de un insumo/preparación fijo, esta línea representa un
  // topping que el cliente elige al pedir, a través de un modificador de esta categoría (ej.
  // "Toppings"). Al servir, se descuentan estos mismos `quantity` gramos del insumo vinculado
  // al modificador que el cliente efectivamente eligió en esa categoría — no la cantidad propia
  // que tenga configurada ese modificador (ver deductRecipeStock en order.service.ts, que
  // además excluye esos modificadores de deductModifierStock para no descontar dos veces).
  // Exactamente uno de inventoryItemId/preparationId/customerChoiceModifierCategoryId puede
  // estar presente (validado en recipe.dto.ts).
  customerChoiceModifierCategoryId String?
  // Afinamiento de la anterior: si no es null, esta línea aplica SOLO cuando el cliente elige ESE
  // topping concreto (ej. "Queso → 100 gr"), y le gana a la línea genérica de la misma categoría
  // ("cualquiera → 60 gr"), que queda como valor por defecto para los toppings sin porción propia.
  // Siempre va acompañado de customerChoiceModifierCategoryId (la categoría de ese modificador).
  customerChoiceModifierId         String?

  // Si no es null, esta línea solo aplica cuando se vendió ESA variante/tamaño del producto
  // (ej. "Grande") — null = aplica a todos los tamaños (o el producto no usa variantes de
  // precio). Permite que cada tamaño tenga sus propias porciones (ver RecetasTab).
  /// Combos: esta línea es OTRO PLATO completo con su propia receta. "Combo familiar = 2
  /// hamburguesas + 1 papas grandes" se arma apuntando a esos platos en vez de recopiar sus
  /// quince ingredientes, y así el combo se corrige solo cuando cambia la receta del plato.
  ///
  /// El costo y el descuento de stock bajan hasta los insumos finales igual que con las
  /// preparaciones (ver costing.ts). Los ciclos —A incluye B y B incluye A— se rechazan al
  /// guardar, y además el resolutor los corta: una receta mal armada no puede colgar el POS.
  componentProductId String?

  productVariantId String?

  // Cantidad usada por una unidad del producto, en la unidad base del insumo
  // o preparación vinculada (ej: si el insumo está en "kg", aquí van kg).
  quantity Decimal @db.Decimal(12, 3)
  // Costo de esa cantidad, en la moneda base del restaurante. Snapshot
  // recalculado por recomputeDependentCosts cuando cambia algo aguas arriba.
  costBase Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant             Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product                Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem          InventoryItem?    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  preparation            Preparation?      @relation(fields: [preparationId], references: [id], onDelete: Restrict)
  customerChoiceCategory ModifierCategory? @relation(fields: [customerChoiceModifierCategoryId], references: [id], onDelete: SetNull)
  customerChoiceModifier Modifier?         @relation(fields: [customerChoiceModifierId], references: [id], onDelete: Cascade)
  productVariant         ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  componentProduct       Product?          @relation("ComboComponente", fields: [componentProductId], references: [id], onDelete: Cascade)

  @@index([restaurantId, productId])
  @@index([inventoryItemId])
  @@index([preparationId])
  @@index([customerChoiceModifierCategoryId])
  @@index([customerChoiceModifierId])
  @@index([productVariantId])
  @@map("recipe_ingredients")
}

// Preparación (sub-receta): una base intermedia reutilizable entre platos
// (fondo, salsa madre, masa) armada a partir de insumos y/o de otras
// preparaciones. No tiene stock propio — es puramente un nodo de costeo; lo
// que se descuenta al vender siempre son los InventoryItem que resuelve en
// la base de esta cadena (ver PreparationIngredient y costing.ts).
model Preparation {
  id            String  @id @default(cuid())
  restaurantId  String
  name          String
  // "kg" | "lt" — una preparación siempre se mide en peso/volumen, nunca "unidad".
  unit          String
  // Cuánto rinde esta preparación, en la unidad declarada arriba (kg/lt) — igual criterio
  // que RecipeIngredient.quantity: gr/ml son solo la conveniencia de entrada en la UI,
  // convertidos antes de guardar. Los insumos que entran pueden sumar más que esto (merma
  // al cocinar), el costo total se reparte entre lo que realmente rinde.
  yieldQuantity Decimal @db.Decimal(12, 3)
  // Disponible en el picker curado de Inventario → Toppings, al crear un modificador desde ahí
  // (mismo patrón que InventoryItem.isTopping) — un topping armado de varios insumos (ej. "Pico
  // de gallo" = tomate + cebolla + cilantro) en vez de uno solo.
  isTopping     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant      Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredients     PreparationIngredient[] @relation("PreparationOwner")
  usedInPreps     PreparationIngredient[] @relation("PreparationRef")
  usedInRecipes   RecipeIngredient[]
  usedInModifiers Modifier[]

  @@index([restaurantId])
  @@map("preparations")
}

// Línea de ingrediente de una Preparation: apunta a un insumo o a OTRA
// preparación (sub-receta anidada), nunca ambos — mismo criterio de
// RecipeIngredient. onDelete: Restrict en componentPreparation evita borrar
// una preparación que otra sigue usando (el service también valida antes,
// con mensaje claro).
model PreparationIngredient {
  id                     String  @id @default(cuid())
  restaurantId           String
  preparationId          String
  inventoryItemId        String?
  componentPreparationId String?

  // En la unidad propia del ingrediente referenciado (kg/lt/unidad si es insumo, kg/lt si
  // es otra preparación) — gr/ml son solo la conveniencia de entrada en la UI.
  quantity Decimal @db.Decimal(12, 3)
  // Snapshot, mismo criterio que RecipeIngredient.costBase.
  costBase Decimal @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant           Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  preparation          Preparation    @relation("PreparationOwner", fields: [preparationId], references: [id], onDelete: Cascade)
  inventoryItem        InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  componentPreparation Preparation?   @relation("PreparationRef", fields: [componentPreparationId], references: [id], onDelete: Restrict)

  @@index([restaurantId, preparationId])
  @@index([inventoryItemId])
  @@index([componentPreparationId])
  @@map("preparation_ingredients")
}

// ----------------------------------------------------------------------------
//  EQUIPO DE DELIVERY Y ZONAS DE ENVÍO
// ----------------------------------------------------------------------------

// Repartidor externo (no es un usuario del panel): solo nombre + WhatsApp,
// para poder mandarle el resumen del pedido cuando el staff lo despacha.
model DeliveryCourier {
  id           String @id @default(cuid())
  restaurantId String

  name          String
  whatsappPhone String
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([restaurantId])
  @@map("delivery_couriers")
}

// Zona de envío con precio fijo: el admin la dibuja como polígono en el mapa
// de Ajustes. `polygon` es un array de puntos [{lat,lng}, ...] en GeoJSON-ish.
model DeliveryZone {
  id           String @id @default(cuid())
  restaurantId String

  name    String
  price   Decimal @db.Decimal(12, 2)
  polygon Json

  /// La registró el sistema sola, al cotizar una dirección que no cubría ninguna zona.
  /// Su precio es una estimación a partir de las zonas vecinas, no un precio que el
  /// restaurante haya decidido — por eso NUNCA le gana a una zona dibujada a mano cuando se
  /// solapan, y no entra en el cálculo que estima precios para otras direcciones (si no, las
  /// estimaciones se alimentarían de estimaciones).
  isAuto Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("delivery_zones")
}

// ----------------------------------------------------------------------------
// QuickTap Shop (businessType = SHOP): catálogo, ventas y caja de un local comercial —
// completamente aparte de Product/Order/CashSession (esos son del vertical restaurante).
// Ver web/src/pages/admin/shop/shopSession.ts para la contraparte de frontend.
// ----------------------------------------------------------------------------

model ShopProduct {
  id           String @id @default(cuid())
  restaurantId String

  name        String
  category    String
  subcategory String
  sku         String
  location    String
  price       Float
  cost        Float
  minStock    Float
  // Foto del producto — obligatoria al crear uno nuevo desde el panel (ver ShopInventoryPage.tsx).
  photoUrl    String?

  // Aparece en el catálogo público de la tienda virtual (/tienda/:slug). Arranca apagado a
  // propósito: el inventario de un local también tiene INSUMOS (cera, shampoo, material de
  // impresión) que se consumen internamente y no se le venden a nadie por internet. Publicar
  // todo por defecto los expondría —con su precio— el día que el local encienda su tienda.
  isPublished Boolean @default(false)

  // Precio mayorista: se aplica en Venta cuando la cantidad del carrito llega a wholesaleMinQty.
  wholesalePrice  Float?
  wholesaleMinQty Float?
  // Precio promocional: si está seteado, gana siempre sobre price y wholesalePrice.
  promoPrice      Float?
  // Fecha de vencimiento (ISO yyyy-mm-dd), texto libre igual que en el frontend.
  expiryDate      String?
  // Marca del producto (ej. "Coca-Cola", "Polar") — separado de la categoría para poder
  // filtrar/agrupar el inventario por marca sin mezclarlo con la clasificación por tipo.
  brand           String  @default("")

  /// Unidad en la que se vende: 'UND' (por unidad), 'KG' (por kilo) o 'MT' (por metro).
  /// Con KG o MT el precio pasa a ser POR esa unidad y en la venta se escribe la cantidad con
  /// decimales (2,35 kg) en vez de contar piezas. Pensado para ferreterías, pero el campo es
  /// genérico: cualquier rubro que venda a granel puede usarlo.
  saleUnit String @default("UND")

  // --- Eventos (categoría "Tickets" de locales comerciales) ---
  // Un evento es un producto como cualquier otro —se vende y se cobra igual— pero además tiene
  // fecha, hora y un cupo limitado de puestos. Se marca con una bandera propia y no por el
  // nombre de la categoría: el local puede renombrarla y el comportamiento no debe depender
  // de eso.
  isEvent                Boolean @default(false)
  // Día del evento, ISO yyyy-mm-dd (mismo criterio que expiryDate: es una fecha de calendario).
  eventDate              String?
  // Hora de inicio "HH:mm", 24h. Texto y no DateTime por lo mismo que eventDate: es la hora
  // local del local, sin huso horario que la corra.
  eventTime              String?
  // Puestos totales a la venta. Los ocupados se cuentan sobre las ventas, no se guardan acá,
  // para que una devolución libere el puesto sola.
  eventSeats             Int?
  // Texto largo del evento, para la pantalla "Más información" de la taquilla.
  eventDescription       String?
  // Hasta 5 imágenes del carrusel de esa pantalla (rutas de /uploads, como photoUrl). La
  // portada del boleto sigue siendo photoUrl: son cosas distintas y se cargan aparte.
  eventImages            Json?
  // Cláusulas que el comprador tiene que aceptar antes de ver el precio y pagar.
  eventTerms             String?
  // --- Financiamiento del evento ---
  // Se define al crear el evento y se copia al plan de cuotas de cada venta. Vive acá y no en
  // ShopInstallmentPlan porque eso es el plan YA pactado de una venta concreta: esto es la
  // plantilla que el local ofrece.
  eventFinancingEnabled  Boolean @default(false)
  // Inicial como PORCENTAJE del precio, no como monto: así sirve igual para una entrada de
  // $250 que de $80, sin que el local recalcule nada al cambiar el precio.
  eventDownPercent       Float?
  eventInstallments      Int?
  // SEMANAL | QUINCENAL | MENSUAL — mismas frecuencias que shop-installments.service.
  eventFrequency         String?
  // Hasta cuándo se acepta financiar (YYYY-MM-DD, inclusive) y fecha tope para terminar de
  // pagar: pasada la fecha solo se vende de contado, y antes de ella las cuotas que se
  // ofrecen son las que CABEN — de nada sirve un plan cuya última cuota vence después del
  // evento. Null = sin límite.
  eventFinancingDeadline String?

  // --- Impresión de gran formato (rubro Agencia de Publicidad) ---
  // 'UNIT' (por defecto) = se vende por unidad, como cualquier producto.
  // 'AREA_ROLL' = se vende por metro cuadrado saliendo de un rollo: el cliente pide una pieza
  // de ancho × alto y se le cobra el ANCHO COMPLETO del rollo del que se corta, porque el
  // sobrante a lo ancho no se reaprovecha (ver web/.../shop/printPricing.ts). Con este modo,
  // `price` y `cost` pasan a ser por m² en vez de por unidad.
  pricingMode String @default("UNIT")
  // Anchos de rollo disponibles en metros, ej. [1.06, 1.37, 1.6, 1.84] para banner. Solo
  // aplica con pricingMode = 'AREA_ROLL'.
  rollWidths  Json?
  // Largo del rollo en metros (típicamente 50) — se usa para derivar el costo por m² a partir
  // de lo que costó el rollo entero, que es como el dueño compra el material.
  rollLengthM Float?

  // --- Plan de consumo (venta de metros por adelantado a tarifa rebajada) ---
  // Solo tiene sentido en productos por Kg/Mt (saleUnit != 'UND'). `consumptionPlanRate` es el
  // precio POR UNIDAD del plan (menor que `price`); `consumptionPlanSizes` son los tamaños de
  // paquete que se ofrecen para vender, ej. [50, 100, 500].
  consumptionPlanEnabled Boolean @default(false)
  consumptionPlanRate    Float?
  consumptionPlanSizes   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant       Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  variants         ShopProductVariant[]
  // Insumos que consume este producto cuando es un servicio (ver ShopServiceSupply).
  serviceSupplies  ShopServiceSupply[]   @relation("ShopServiceSupplyService")
  consumptionPlans ShopConsumptionPlan[]
  // Gastos imputados a este evento (local, sonido, permisos): su suma es el costo del evento.
  eventExpenses    Movement[]            @relation("ShopEventExpenses")
  tickets          ShopTicket[]

  @@index([restaurantId])
  @@map("shop_products")
}

// Una fila por combinación de variante (ej: Talla M / Color Azul) con su propio stock.
model ShopProductVariant {
  id        String @id @default(cuid())
  productId String

  v1           String
  v2           String
  stock        Float
  // Se vende por peso (Kg): en el carrito la cantidad es decimal, no unidades enteras.
  soldByWeight Boolean @default(false)

  /// Precio de venta propio de esta variante. Null = usa el del producto.
  ///
  /// Existe porque hay catálogos donde la variante no es una talla o un color sino otro
  /// producto en precio: en la lista de Monteranch, una manguera de 1/2" vale $21,50 a 60 PSI
  /// y $36,50 a 150 PSI. Antes había que partirlas en productos separados y el catálogo se
  /// llenaba de filas que en realidad son la misma manguera.
  price       Float?
  /// Costo propio de esta variante, promedio ponderado de SUS lotes (ver recordPurchase).
  /// Null = usa el del producto. Va aparte del precio porque si las variantes se venden a
  /// distinto precio también se compran a distinto costo, y un promedio único entre las tres
  /// daría márgenes falsos en las tres.
  cost        Float?
  /// Descripción propia de esta variante, para cuando entre una y otra cambia algo más que el
  /// nombre. Null = se muestra la del producto.
  description String?

  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("shop_product_variants")
}

// Venta del POS de Shop — cada línea se snapshotea completa en ShopSaleItem (independiente de
// ediciones posteriores al producto), mismo criterio que Order/OrderItem del vertical restaurante.
// Pedido abierto del Local: un carrito que se deja parado para seguir cargándole productos
// más tarde (el cliente que sigue comprando, la cuenta que se arma durante el día).
//
// NO es una venta: no descuenta stock, no entra en caja ni en estadísticas. Cuando se cobra
// pasa por el mismo camino que cualquier venta (recordSale) y este registro se borra.
//
// Las líneas se guardan como JSON y no en una tabla aparte a propósito: es el carrito tal cual
// lo dejó el POS —con sus variantes, pesos, precios por unidad y descuentos— y lo único que se
// necesita es poder devolverlo idéntico. Una tabla obligaría a mantener dos formas del mismo
// carrito en sincronía para un dato que no se consulta ni se reporta.
model ShopOpenOrder {
  id           String @id @default(cuid())
  restaurantId String

  /// Con qué nombre se reconoce: el del cliente, "Mesa 3", "el señor de la camioneta".
  label         String
  customerName  String?
  customerPhone String?
  /// Las líneas del carrito, tal como las maneja el POS.
  items         Json

  createdByUserId   String?
  createdByUserName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, updatedAt])
  @@map("shop_open_orders")
}

// Plan de consumo: el cliente paga por adelantado un bloque de metros a una tarifa rebajada
// (ej. 50mt a $10/mt en vez de $15) y los va retirando con el tiempo hasta agotarlo. Es lo
// inverso de Cuentas por Cobrar: acá el saldo está a favor del cliente, no del local.
//
// Va atado a UN producto (el precio por metro es del producto, no genérico) y a un
// nombre/teléfono suelto, igual que ShopSale — el rubro Local Comercial no tiene un Customer
// con FK real, se reconoce por teléfono en todas partes.
model ShopConsumptionPlan {
  id           String @id @default(cuid())
  restaurantId String
  productId    String

  customerName  String
  customerPhone String

  // Lo que compró y lo que le queda, en la unidad del producto (normalmente metros). totalUnits
  // no cambia nunca — es el histórico de lo vendido; remainingUnits baja con cada consumo.
  totalUnits     Float
  remainingUnits Float
  // Tarifa congelada al activar el plan — si el producto sube de precio después, este plan
  // seguido cobrando (mejor dicho, descontando) a la tarifa con la que se vendió.
  ratePerUnit    Float
  totalPaid      Float

  // Venta que pagó la activación del plan, para poder rastrear el cobro original.
  activatedSaleId String?

  createdAt DateTime  @default(now())
  // Se marca sola cuando remainingUnits llega a 0 (ver consumePlan) — un plan cerrado a mano
  // (cliente que ya no va a volver) también la usa, para sacarlo de la lista de activos.
  closedAt  DateTime?

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product    ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([restaurantId, customerPhone])
  @@index([restaurantId, productId, closedAt])
  @@map("shop_consumption_plans")
}

model ShopSale {
  id           String @id @default(cuid())
  restaurantId String

  total          Float
  time           DateTime @default(now())
  customerName   String?
  customerPhone  String?
  returned       Boolean  @default(false)
  paymentMethod  String?
  // Quién cobró esta venta (cajero/vendedor) — igual que ShopSaleItem.staffUserId, sin relación
  // FK y con el nombre congelado: si el usuario se borra o se le cambia el nombre, la venta
  // histórica sigue mostrando quién la hizo tal como era en ese momento.
  soldByUserId   String?
  soldByUserName String?
  // { reference?, hasProof? } — comprobante de Pago Móvil.
  paymentMeta    Json?
  // 'FULL' | 'INSTALLMENT' | null — venta fiada (se paga todo después, o se abonó algo ahora).
  creditTerms    String?
  amountPaidNow  Float?

  // --- Cuentas por cobrar (solo aplica cuando creditTerms no es null) ---
  // Fecha en que el cliente se comprometió a pagar el saldo — igual que expiryDate en
  // ShopProduct, texto libre ISO yyyy-mm-dd para no acoplarse a huso horario.
  dueDate   String?
  // Se marca cuando la suma de amountPaidNow + todos los ShopSalePayment iguala el total.
  // Null = todavía tiene saldo pendiente.
  settledAt DateTime?

  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items           ShopSaleItem[]
  payments        ShopSalePayment[]
  installmentPlan ShopInstallmentPlan?
  passPayments    ShopPassPayment[]

  @@index([restaurantId])
  @@index([restaurantId, creditTerms, settledAt])
  @@map("shop_sales")
}

// Abono posterior contra una venta fiada (ShopSale.creditTerms != null) — cada uno reduce el
// saldo pendiente sin tener que reabrir o duplicar la venta original. El saldo se calcula
// siempre en el servicio (total - amountPaidNow - suma de estos pagos), nunca se cachea.
model ShopSalePayment {
  id         String   @id @default(cuid())
  shopSaleId String
  amount     Float
  method     String?
  createdAt  DateTime @default(now())

  /// Cuota a la que se imputa este abono. Null = abono libre contra el saldo general (así se
  /// comportaban todos antes de que existieran las cuotas, y se sigue permitiendo).
  installmentId String?

  shopSale    ShopSale         @relation(fields: [shopSaleId], references: [id], onDelete: Cascade)
  installment ShopInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@index([shopSaleId])
  @@index([installmentId])
  @@map("shop_sale_payments")
}

model ShopSaleItem {
  id     String @id @default(cuid())
  saleId String

  // Cuándo se agregó ESTA línea. Existe porque una venta fiada es una cuenta que crece: cuando
  // el cliente vuelve a comprar al mismo negocio, la compra se suma a la cuenta abierta en vez
  // de abrir otra (ver recordSale). Sin esto, ShopSale.time solo diría cuándo se abrió la
  // cuenta y el cliente no podría reconocer qué se llevó cada día.
  addedAt DateTime @default(now())

  // Informativo, sin relación FK — el resto de los campos ya snapshotea todo lo necesario
  // para mostrar/devolver la venta aunque el producto original cambie o se borre.
  productId         String?
  v1                String
  v2                String
  name              String
  category          String?
  qty               Float
  price             Float
  cost              Float
  soldByWeight      Boolean @default(false)
  // Detalle congelado de la línea, para que el recibo y el historial sigan explicando de dónde
  // salió la cantidad. Hoy lo usa la impresión de gran formato: "1,20 × 0,80 m · rollo 1,37" —
  // sin esto, la venta solo diría "1,096" y nadie podría reconstruir qué se imprimió.
  detail            String?
  // Cuánto descontar del stock cuando NO coincide con `qty`. En impresión de gran formato `qty`
  // son los m² que se COBRAN (1,096) pero del rollo se consumen metros LINEALES (0,80): sin este
  // campo se descontaría el número equivocado. Null = descontar `qty`, como el resto del catálogo.
  stockQty          Float?
  // Profesional que prestó ESTE servicio (barbero/estilista). Por línea y no por venta: un
  // mismo ticket puede llevar el corte de un barbero y un producto vendido sin nadie detrás.
  // Sin relación FK: si el usuario se borra, la venta histórica no se toca (igual que productId).
  staffUserId       String?
  // Congelados al momento de la venta, como el resto de los importes: si después se le cambia
  // el % al barbero, lo ya liquidado no se mueve.
  commissionPercent Float?
  commissionBase    Float?

  sale ShopSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([staffUserId])
  @@map("shop_sale_items")
}

// Receta de insumos de un servicio del Local Comercial: qué consume cada "Corte" de los
// productos del propio inventario (shampoo, cera, tinte...). Al vender el servicio, el stock
// de cada insumo baja solo — el barbero no tiene que registrar nada aparte.
//
// El insumo es otro ShopProduct+variante del mismo local, así que se compra y se cuenta con
// las mismas herramientas que el resto del inventario (Registrar compra / Recuento físico).
model ShopServiceSupply {
  id           String @id @default(cuid())
  restaurantId String

  // Servicio que consume el insumo (ej. "Corte de Cabello").
  serviceProductId String
  // Insumo consumido, identificado igual que en las ventas: producto + variante por contenido.
  supplyProductId  String
  supplyV1         String
  supplyV2         String @default("")
  // Cuánto se consume por servicio, en la MISMA unidad en que se lleva el stock del insumo.
  // Un pote de cera que rinde 40 cortes se carga como 0.025 (= 1/40).
  quantity         Float

  createdAt DateTime @default(now())

  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  serviceProduct ShopProduct @relation("ShopServiceSupplyService", fields: [serviceProductId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([serviceProductId])
  @@map("shop_service_supplies")
}

// Compra a proveedor que repone stock (suma unidades, a diferencia de un ajuste de inventario).
model ShopPurchase {
  id           String @id @default(cuid())
  restaurantId String

  supplier    String
  productId   String?
  productName String
  v1          String
  v2          String
  qty         Float
  cost        Float
  time        DateTime @default(now())

  /// Cuánto queda de ESTE lote. Baja al vender, en orden de llegada (el más viejo primero), y
  /// es lo que permite ver en inventario "lote 1: 50 kg a $3, lote 2: 54 kg a $4,50" en vez de
  /// un solo promedio. `qty` se conserva como lo que entró originalmente.
  remainingQty Float  @default(0)
  /// Cuánto pesó ESTA carga, en Kg. Va aparte de `qty` porque son dos cosas distintas: un rollo
  /// de manguera se vende como un rollo (qty = 1) pero se compra por peso, y cada rollo del
  /// mismo tipo pesa distinto — 40, 43, 68 Kg. Es lo que permite ver en inventario el peso real
  /// de cada carga. Null en productos donde el peso no aplica o no se anotó.
  weightKg     Float?
  /// Etiqueta corta para reconocerlo (ej. "Lote 1"). Se numera por producto al registrarlo.
  lotNumber    Int    @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("shop_purchases")
}

// Corrección manual de stock (recuento físico/auditoría): fija el stock a la cantidad contada
// en vez de sumarle unidades, a diferencia de ShopPurchase.
model ShopStockAdjustment {
  id           String @id @default(cuid())
  restaurantId String

  productId   String?
  productName String
  v1          String
  v2          String
  before      Float
  after       Float
  diff        Float
  reason      String
  time        DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("shop_stock_adjustments")
}

// Apertura/cierre de caja del POS de Shop — closedAt null = caja abierta actualmente (a lo sumo
// una por restaurante). Al cerrar se congela el arqueo, igual que CashSession.closingSummary.
model ShopCashSession {
  id           String @id @default(cuid())
  restaurantId String

  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  opening    Float
  salesCount Int?
  totalSales Float?
  expected   Float?
  counted    Float?
  diff       Float?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("shop_cash_sessions")
}

// Categorías/subcategorías del catálogo — el dueño las va creando desde Inventario, no están
// atadas a un rubro en particular (cualquier Local Comercial organiza el suyo desde cero).
model ShopCategory {
  id           String @id @default(cuid())
  restaurantId String
  name         String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name])
  @@map("shop_categories")
}

// ----------------------------------------------------------------------------
//  EVENTOS Y PAGO POR CUOTAS (locales comerciales)
// ----------------------------------------------------------------------------

/// Plan de cuotas de una venta a crédito (ShopSale.creditTerms = 'INSTALLMENT').
/// Es un método de pago más de la caja, no algo exclusivo de los eventos: el local puede vender
/// a cuotas una entrada o una nevera con el mismo mecanismo.
/// `lateFeeAmount` y `alertDaysBefore` se congelan al crear el plan a propósito: si el local
/// cambia después su política de mora, los planes ya pactados conservan lo que se le prometió al
/// cliente. Mismo criterio que los montos congelados de Order (ver arriba).
/// /
model ShopInstallmentPlan {
  id           String @id @default(cuid())
  restaurantId String
  shopSaleId   String @unique

  /// Monto fijo que se cobra por CADA cuota vencida (no porcentaje, no crece por día).
  lateFeeAmount   Float @default(0)
  /// Días antes del vencimiento en que la cuota empieza a avisarse como próxima a vencer.
  alertDaysBefore Int   @default(3)

  /// Cada cuánto vence una cuota: SEMANAL | QUINCENAL | MENSUAL | TRIMESTRAL | SEMESTRAL.
  frequency        String @default("MENSUAL")
  /// Recargo por financiar, en % sobre el saldo. Se aplica UNA vez al crear el plan y su monto
  /// resultante queda congelado abajo: es lo que se le prometió al cliente, y recalcularlo
  /// después con otro porcentaje le cambiaría la deuda por detrás.
  surchargePercent Float  @default(0)
  /// El recargo ya calculado, en dinero. Suma al saldo de la venta.
  surchargeAmount  Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  shopSale     ShopSale          @relation(fields: [shopSaleId], references: [id], onDelete: Cascade)
  installments ShopInstallment[]

  @@index([restaurantId])
  @@map("shop_installment_plans")
}

/// Una cuota del plan. Monto y fecha son editables por el local después de creada — es lo normal
/// cuando un cliente pide reacomodar el pago, y evita tener que anular la venta y rehacerla.
/// `dueDate` es texto ISO yyyy-mm-dd y no DateTime, igual que ShopSale.dueDate: una fecha de
/// vencimiento es un día del calendario del local, y guardarla con hora la corría de día al
/// cruzar husos.
/// `lateFeeCharged` se sella cuando se aplica la mora, en vez de recalcularla al vuelo, para que
/// lo que se le cobró al cliente no cambie si el local edita su política más adelante.
/// /
model ShopInstallment {
  id     String @id @default(cuid())
  planId String

  /// 1, 2, 3… en orden de vencimiento.
  number  Int
  amount  Float
  dueDate String

  /// Suma de los abonos imputados a esta cuota. El saldo se calcula, nunca se cachea.
  paidAmount     Float     @default(0)
  paidAt         DateTime?
  /// Mora ya aplicada a esta cuota. 0 = todavía no venció o se pagó a tiempo.
  lateFeeCharged Float     @default(0)
  // Cuándo se mandó el recordatorio de vencimiento al Wallet (3 días antes). Sella que YA se
  // avisó: el barrido corre varias veces al día y sin esto repetiría el push.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan     ShopInstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  payments ShopSalePayment[]

  @@unique([planId, number])
  @@index([planId])
  @@index([dueDate])
  @@map("shop_installments")
}

/// Abono que el CLIENTE reporta desde QuickTap Pass, a la espera de que el local lo verifique.
///
/// No toca el saldo al crearse: mientras está en PENDING no existe para las cuentas del negocio.
/// Solo al aprobarlo se crea el ShopSalePayment real. Es la misma idea que la verificación de
/// comprobantes de suscripción: quien dice haber pagado no puede darse por pagado solo.
///
/// Guarda `installmentId` porque el cliente elige contra qué cuota abona; null = contra el saldo
/// general de la compra.
model ShopPassPayment {
  id            String  @id @default(cuid())
  restaurantId  String
  shopSaleId    String
  customerId    String
  installmentId String?

  amount        Float
  method        String
  proofImageUrl String?

  /// PENDING | APPROVED | REJECTED
  status          String    @default("PENDING")
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  /// Pago real que se creó al aprobarlo, para poder rastrear de dónde salió.
  salePaymentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  shopSale   ShopSale   @relation(fields: [shopSaleId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([shopSaleId])
  @@map("shop_pass_payments")
}

model ShopSubcategory {
  id           String @id @default(cuid())
  restaurantId String
  category     String
  name         String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, category, name])
  @@map("shop_subcategories")
}

// ----------------------------------------------------------------------------
// Tienda virtual del Local Comercial: pedidos que entran por el catálogo público
// (/tienda/:slug), antes de convertirse en una venta del POS.
//
// Es un modelo aparte de ShopSale a propósito: una venta es algo que YA ocurrió
// (cobrada, stock descontado, dentro de los reportes), mientras que un pedido
// online está pendiente hasta que el dueño lo acepta. Al confirmarlo se crea la
// ShopSale correspondiente y se guarda su id en `shopSaleId` — de ahí en
// adelante el pedido es solo el historial de cómo entró.
// ----------------------------------------------------------------------------
// Entrada emitida para un evento (ShopProduct.isEvent).
//
// Se emite cuando el pago ya está verificado: una venta del POS, o un pedido de la tienda que
// el local confirmó. Ambos caminos pasan por recordSale, así que la emisión vive ahí y no hay
// dos lugares que puedan desincronizarse.
//
// Los datos del evento se CONGELAN al emitir (nombre, fecha, hora, precio): si después se
// corrige el evento, el boleto que el asistente ya tiene en el teléfono sigue diciendo lo que
// decía cuando lo compró.
// Cuenta de acceso a QuickTap Wallet. Es POR TELÉFONO (canónico, últimos 10 dígitos), no por
// Customer: la ficha de cliente vive por restaurante y una misma persona tiene varias, pero su
// identidad en el Wallet es una sola. La clave se crea la primera vez, después de verificar el
// teléfono con un código por SMS — la cédula sola dejó de bastar: es un dato semipúblico.
model WalletAccount {
  id    String @id @default(cuid())
  phone String @unique

  passwordHash String?

  // Código SMS vigente, guardado como hash (igual que una clave: si se filtra la base no se
  // filtran códigos vivos). attempts frena la fuerza bruta de 4 dígitos; sentAt el re-envío.
  smsCodeHash      String?
  smsCodeExpiresAt DateTime?
  smsAttempts      Int       @default(0)
  smsSentAt        DateTime?

  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("wallet_accounts")
}

// Teléfonos (Android) registrados para recibir push del Wallet — separado de DeviceToken, que
// es del STAFF de un negocio (cuelga de restaurantId+userId). Acá el dueño del aparato es un
// cliente final, identificado por su teléfono canónico, igual que WalletAccount.
// Instancia de WhatsApp vinculada vía Evolution API (self-hosted, ver src/utils/evolution.ts).
// Una por negocio — CADA LOCAL VINCULA SU PROPIO NÚMERO, que es la diferencia de fondo con el
// intento de 2026-08 (un solo número de plataforma mandando cobranzas, y baneado por eso).
// restaurantId null = la instancia de la PLATAFORMA (cobranzas del master).
model WaInstance {
  id           String  @id @default(cuid())
  restaurantId String? @unique

  // Nombre de la instancia en Evolution (opaco, generado acá). Es la llave con la que se le
  // habla a Evolution; no se expone al cliente.
  instanceName String @unique

  // CONNECTED | CONNECTING | DISCONNECTED — espejo del connectionState de Evolution,
  // refrescado por webhook. Se guarda para no preguntarle a Evolution en cada envío.
  status String  @default("DISCONNECTED")
  // Número que quedó vinculado (informativo, para mostrar en Ajustes).
  phone  String?

  // Freno de mano. `paused` manual (el equipo lo apaga); `autoPaused` lo pone el detector de
  // entregas: si varios envíos seguidos quedan sin ACK, el número probablemente está
  // restringido y seguir enviando solo empeora el caso — que fue EXACTAMENTE el modo de
  // fallo de agosto: sendMessage resolvía y nada llegaba.
  paused      Boolean   @default(false)
  autoPaused  Boolean   @default(false)
  pendingAcks Int       @default(0)
  lastAckAt   DateTime?
  lastSentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("wa_instances")
}

model WalletDeviceToken {
  id        String   @id @default(cuid())
  phone     String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("wallet_device_tokens")
}

model ShopTicket {
  id           String @id @default(cuid())
  restaurantId String
  productId    String

  // De dónde salió: venta del POS y, si vino de la tienda, también el pedido.
  shopSaleId  String?
  shopOrderId String?

  // Token opaco embebido en el QR — mismo patrón que Table.qrToken y ClubBooking.accessToken:
  // no codifica datos del ticket, solo lo identifica.
  accessToken String @unique

  // Congelados al emitir.
  eventName   String
  eventDate   String?
  eventTime   String?
  price       Float
  holderName  String?
  holderPhone String?

  // Correlativo dentro del evento, lo que en el boleto se lee como "Puesto 12".
  seatNumber Int

  // Lo marca el Verificador al escanear en la puerta. Null = todavía no entró.
  checkedInAt       DateTime?
  checkedInByUserId String?

  createdAt DateTime @default(now())

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product    ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, seatNumber])
  @@index([restaurantId, productId])
  @@index([shopSaleId])
  @@map("shop_tickets")
}

model ShopOrder {
  id           String @id @default(cuid())
  restaurantId String

  // Correlativo por local, para que el dueño y el cliente hablen del "pedido #12".
  orderNumber Int

  // 'PICKUP' = pasa buscando por la tienda | 'DELIVERY' = se le lleva a la dirección.
  mode   String
  // 'PENDING' (recién llegado, sin atender) | 'CONFIRMED' (aceptado, ya generó la venta)
  // | 'CANCELLED'. No hay estados intermedios: el local confirma cuando va a despacharlo.
  status String @default("PENDING")

  customerName     String
  customerPhone    String
  // Cédula del comprador. Obligatoria solo cuando la compra va a existir en el Wallet
  // (entradas de un evento o compra financiada): es, junto al teléfono, la clave con la que
  // el comprador entra al portal a ver su entrada y sus cuotas. Ver shop-storefront.service.
  customerIdNumber String?
  // Solo en DELIVERY. Incluye el enlace de mapa cuando el cliente compartió su ubicación,
  // mismo criterio que Order.customerAddress del vertical restaurante.
  customerAddress  String?
  note             String?

  // Método de pago que eligió el cliente (MOBILE_PAYMENT, ZELLE, CASH…), congelado.
  paymentMethod   String?
  // Captura de la transferencia/Pago Móvil que adjuntó el comprador al hacer el pedido, para
  // que el local verifique antes de confirmar. Ruta bajo /uploads/shop-payment-proofs.
  paymentProofUrl String?

  // Importes congelados al momento del pedido: si mañana suben los precios o cambia la
  // tasa, lo que el cliente aceptó pagar no se mueve (mismo criterio que Order).
  subtotal     Float
  deliveryFee  Float  @default(0)
  total        Float
  exchangeRate Float?
  totalBs      Float?

  // Venta generada al confirmar. Sin relación FK: si la venta se borra o se devuelve, el
  // pedido histórico no se toca (mismo criterio que ShopSaleItem.productId).
  shopSaleId         String?
  // El comprador eligió financiar esta compra (solo aplica a entradas de eventos con
  // financiamiento habilitado). Al confirmar el pedido, la venta se arma a crédito con el
  // plan de cuotas del evento en vez de cobrarse completa. Ver shop-orders.service.confirm.
  financed           Boolean @default(false)
  // En cuántas cuotas quiere pagar. Es una PREFERENCIA, no una orden: al confirmar se recorta
  // al máximo que el evento permite (eventInstallments) — el tope lo decide el local, el
  // reparto dentro del tope lo decide el comprador.
  installmentsChosen Int?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  cancelledAt DateTime?

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      ShopOrderItem[]

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@map("shop_orders")
}

// Línea del pedido online. Snapshotea lo mismo que ShopSaleItem para poder crear la venta
// al confirmar sin volver a mirar el catálogo (que pudo cambiar mientras tanto).
model ShopOrderItem {
  id      String @id @default(cuid())
  orderId String

  // Informativo, sin relación FK — igual que ShopSaleItem.productId.
  productId    String?
  v1           String
  v2           String
  name         String
  category     String?
  qty          Float
  price        Float
  cost         Float
  soldByWeight Boolean @default(false)

  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shop_order_items")
}

// ============================================================================
//  QUICKTAP CLUB (businessType = SPORTS_CLUB) — Canchas de pádel y clubes
//  deportivos. Reservas por franja horaria, con precio de hora pico/valle.
//  Sin relación con Table/Order/Reservation: aquello es del vertical restaurante
//  y no sabe de duraciones ni de solapamientos.
// ============================================================================

enum ClubSport {
  PADEL
  TENIS
  FUTBOL
  BASQUET
  OTRO
}

// Qué ocupa la cancha. Reservas, mantenimiento, clases y torneos comparten UNA
// sola tabla a propósito: así una única restricción de exclusión los protege a
// todos entre sí (un bloqueo por lluvia no puede pisar una reserva ya hecha), y
// el calendario se arma con una sola consulta.
enum ClubBlockKind {
  BOOKING // Reserva de un jugador
  MAINTENANCE // Bloqueo técnico (cristales, lluvia, cambio de red)
  CLASS // Clase de academia
  TOURNAMENT // Partido de torneo
}

enum ClubBlockStatus {
  ACTIVE
  CANCELLED
}

enum ClubBookingStatus {
  PENDING_PAYMENT // Reservada, aún sin cobrar
  CONFIRMED // Pagada (total o parcialmente, según la política del club)
  COMPLETED // Jugada: hubo check-in y ya pasó la hora
  CANCELLED
  NO_SHOW // No se presentó: pasó la hora sin check-in
}

/// Cómo está cerrada la cancha. Cambia el precio y la experiencia (se juega con
/// lluvia o no), así que el jugador lo ve en el enlace público.
enum ClubCourtType {
  LIBRE // al aire libre, sin techo
  TECHADA // techo sobre la pista, laterales abiertos
  INDOOR // cerrada por completo
}

model ClubCourt {
  id           String        @id @default(cuid())
  restaurantId String
  name         String // "Cancha 1", "Central"
  sport        ClubSport     @default(PADEL)
  courtType    ClubCourtType @default(LIBRE)
  photoUrl     String?
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())

  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  schedules     ClubSchedule[]
  blocks        ClubCourtBlock[]
  /// Tablets fijas montadas en esta cancha (rol CANCHA).
  tablets       User[]             @relation("UserClubCourt")
  // Academia: franjas recurrentes asignadas y sesiones dadas en esta cancha.
  classSlots    ClubClassSlot[]
  classSessions ClubClassSession[]

  @@index([restaurantId, active])
  @@map("club_courts")
}

// Franja de apertura con su precio. La "hora pico" no es un campo aparte: es
// simplemente otra franja del mismo día con otro precio (18:00-22:00 más cara
// que 08:00-14:00). `courtId` null = la franja aplica a todas las canchas.
model ClubSchedule {
  id           String  @id @default(cuid())
  restaurantId String
  courtId      String?

  weekday   Int // 0 = domingo … 6 = sábado
  startTime String // "HH:mm" hora local del club
  endTime   String // "HH:mm" — exclusivo

  // Duración de la franja reservable. Un club suele vender 60 y 90 min; se
  // cargan como dos horarios distintos sobre el mismo tramo si hace falta.
  slotMinutes Int @default(90)

  priceBase Decimal @db.Decimal(12, 2)
  isPeak    Boolean @default(false)
  active    Boolean @default(true)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  court      ClubCourt? @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([restaurantId, weekday])
  @@index([courtId])
  @@map("club_schedules")
}

// Tabla central del calendario. El intervalo es SEMIABIERTO [startsAt, endsAt):
// una reserva 18:00-19:00 y otra 19:00-20:00 NO se solapan.
//
// El doble booking se previene con una restricción EXCLUDE de PostgreSQL sobre
// (courtId, tstzrange) filtrada a status <> 'CANCELLED' — ver la migración. Una
// validación en el servicio no basta: dos jugadores que reservan en el mismo
// segundo pasan ambos la comprobación y ambos insertan.
model ClubCourtBlock {
  id           String @id @default(cuid())
  restaurantId String
  courtId      String

  kind   ClubBlockKind
  status ClubBlockStatus @default(ACTIVE)

  startsAt DateTime
  endsAt   DateTime

  note      String? // Motivo del mantenimiento, nombre del torneo, etc.
  createdAt DateTime @default(now())

  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  court        ClubCourt         @relation(fields: [courtId], references: [id], onDelete: Cascade)
  booking      ClubBooking?
  /// La clase de academia que ocupa este bloque, cuando kind = CLASS.
  classSession ClubClassSession?

  @@index([restaurantId, startsAt])
  @@index([courtId, startsAt])
  @@map("club_court_blocks")
}

model ClubBooking {
  id           String @id @default(cuid())
  restaurantId String
  blockId      String @unique

  // El jugador que reserva. `customerId` ata la reserva al CRM (historial de
  // consumo); nombre, teléfono y cédula se copian igual para que la reserva se
  // sostenga sola aunque el cliente se borre.
  customerId     String?
  playerName     String
  playerPhone    String
  // Obligatoria cuando reserva el jugador desde la web; opcional cuando la carga
  // recepción, porque por teléfono no siempre la dan y no debe trabar el mostrador.
  playerIdNumber String?

  // Congelados al reservar, como en Order: si mañana sube la tasa o el precio de
  // la hora pico, una reserva ya hecha no cambia de precio.
  totalBase    Decimal @db.Decimal(12, 2)
  exchangeRate Decimal @db.Decimal(12, 4)
  totalBs      Decimal @db.Decimal(14, 2)

  // Cuántos jugadores van a dividir el pago (Fase 3). Se guarda desde el inicio
  // porque define el reparto de céntimos y no debe cambiar tras cobrar.
  playerCount Int @default(4)

  // Extras que el jugador pidió tener listos al llegar (agua, pelotas, alquiler
  // de pala). Snapshot JSON a propósito: todavía NO está vinculado al catálogo
  // real de la tienda (ShopProduct), así que no tiene precio ni descuenta stock
  // — es una nota para recepción. Al vincularlo pasará a cobrarse de verdad.
  requestedExtras Json?

  // Nombres de los jugadores cuando la reserva es de 6+ y el jugador confirmó que
  // van a jugar un Americano/Mexicano al reservar. Snapshot de string[] — solo
  // prellena ClubTournamentScreen en la tablet de la cancha, no crea el torneo
  // solo: el personal lo arranca desde ahí con los nombres ya cargados.
  tournamentPlayerNames Json?

  status ClubBookingStatus @default(PENDING_PAYMENT)

  // Cta. abierta / "Deuda" (botón de Caja) — recepción marca que sabe que esto se debe y le hace
  // seguimiento, igual que Order.awaitingPayment. No implica nada sobre cuánto se ha cobrado:
  // eso vive en `payments`, esto es solo la bandera de seguimiento.
  awaitingPayment Boolean @default(false)

  // Token opaco del QR de acceso — mismo patrón que Table.qrToken: no codifica
  // datos de la reserva, solo identifica. El servidor resuelve y valida.
  accessToken String @unique

  /// Cuenta de jugador que hizo la reserva, si reservó estando identificado.
  /// Opcional a propósito: reservar sin cuenta tiene que seguir funcionando.
  playerAccountId String?
  /// Cuándo se validó el código de WhatsApp de este teléfono.
  verifiedPhoneAt DateTime?

  checkedInAt  DateTime? // Lo marca el escáner de recepción
  cancelledAt  DateTime?
  /// Por qué se canceló y quién lo hizo (STAFF | PLAYER). El motivo es lo que
  /// permite distinguir una cancelación legítima de una ausencia encubierta.
  cancelReason String?
  cancelledBy  String?
  createdAt    DateTime  @default(now())

  restaurant       Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  block            ClubCourtBlock        @relation(fields: [blockId], references: [id], onDelete: Cascade)
  customer         Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  playerAccount    ClubPlayerAccount?    @relation(fields: [playerAccountId], references: [id], onDelete: SetNull)
  payments         ClubBookingPayment[]
  reportedPayments ClubReportedPayment[]
  loyaltyEntries   ClubLoyaltyEntry[]
  invites          ClubPlayInvite[]
  // Lo que el jugador fue pidiendo desde la tablet de la cancha. Se cobra junto
  // con la cancha en la misma Caja — ver `withBookingMoney` en club.service.ts.
  tabOrders        ClubTabOrder[]

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([customerId])
  @@map("club_bookings")
}

/// Última vez que el bot de WhatsApp le recordó una deuda a un cliente del club — una
/// fila por deuda (reserva/venta fiada/mensualidad), para el dedup del barrido: primer
/// recordatorio a los 3 días, repetición cada 7 — ver club-debt-bot.service.ts.
model ClubDebtReminder {
  id             String   @id @default(cuid())
  restaurantId   String
  /// 'bookings' | 'store' | 'academy' — mismas fuentes que club-stats debts().
  source         String
  /// Id de la fila de deuda en su fuente: ClubBooking / ShopSale / ClubAcademyCharge.
  refId          String
  lastReminderAt DateTime

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, source, refId])
  @@map("club_debt_reminders")
}

enum ClubDebtVerificationStatus {
  /// En cola: ya hay otro comprobante esperando respuesta del verificador.
  PENDING_FORWARD
  /// Reenviado al verificador, esperando "Aprobado"/"Rechazado".
  AWAITING_VERIFIER
  APPROVED
  REJECTED
}

/// Comprobante de pago de una DEUDA de club recibido por WhatsApp — espejo de
/// OrderPaymentVerification pero contra la deuda (reserva/fiado/mensualidad) en vez de
/// un pedido. Al aprobarse se registra el pago real en su fuente (ClubBookingPayment /
/// ShopSalePayment / ClubAcademyPayment), que es lo que suma en Administración.
model ClubDebtPaymentVerification {
  id            String                     @id @default(cuid())
  restaurantId  String
  source        String
  refId         String
  /// Solo filas de academia: el pago se registra contra el alumno, no contra la cuota.
  studentId     String?
  customerName  String
  /// Solo dígitos, formato internacional (58414...) — como llega del JID de WhatsApp.
  customerPhone String
  /// Saldo pendiente al momento de recibir el comprobante (se recalcula al aprobar).
  amountBase    Decimal                    @db.Decimal(12, 2)
  proofImageUrl String
  status        ClubDebtVerificationStatus @default(AWAITING_VERIFIER)
  /// Método con el que el verificador confirmó el pago (default Pago Móvil).
  method        PaymentMethod?
  createdAt     DateTime                   @default(now())
  resolvedAt    DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@map("club_debt_payment_verifications")
}

// Cobro de la Caja de canchas — mismo patrón que OrderPayment: varios pagos por
// reserva (pago completo, o fraccionado entre los jugadores), cada uno con su
// propio método/referencia/comprobante. Sin descuento ni ajuste de servicio (a
// diferencia de OrderPayment): una reserva es una sola línea, no hay ítems ni
// cargo de servicio que ajustar puntualmente.
model ClubBookingPayment {
  id              String        @id @default(cuid())
  bookingId       String
  amountBase      Decimal       @db.Decimal(12, 2)
  /// Descuento de promoción (CRM) perdonado en este cobro: cuenta como saldado
  /// igual que el dinero, pero no es dinero — el arqueo y el banco no lo suman.
  discountBase    Decimal       @default(0) @db.Decimal(12, 2)
  method          PaymentMethod
  referenceNumber String?
  proofImageUrl   String?
  createdAt       DateTime      @default(now())

  booking ClubBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("club_booking_payments")
}

// ============================================================================
//  Vínculo club ↔ restaurante y consumo en cancha
// ============================================================================
//  Un club deportivo casi nunca cocina: terceriza la barra/cocina en un
//  restaurante vecino que ya usa QuickTap. El restaurante genera un código en
//  sus Ajustes, el club lo canjea en los suyos, y a partir de ahí las comandas
//  que los jugadores piden desde la tablet de la cancha le llegan al
//  restaurante con el nombre de la cancha haciendo de "mesa".
//
//  El dinero NO cambia de tenant: el consumo se suma a la reserva y se cobra en
//  la Caja del club, junto con la cancha. Al restaurante le llega la comanda
//  para preparar y llevar, no una venta.
// ============================================================================

/// Código de un solo uso que el restaurante genera para que un club se vincule.
/// Vive 1 hora (ver CLUB_LINK_CODE_TTL_MINUTES en club-link.service.ts).
model ClubLinkCode {
  id           String    @id @default(cuid())
  restaurantId String
  code         String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  usedByClubId String?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation("ClubLinkCodeRestaurant", fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, expiresAt])
  @@map("club_link_codes")
}

/// Vínculo activo. Un club tiene un solo restaurante que le prepara los pedidos
/// (de ahí el @unique en clubId); un restaurante sí puede atender varios clubes.
/// Tiendas que le venden a las canchas de un club. Un club puede vincular hasta
/// MAX_LINKED_STORES (4) — el tope se valida en el servicio, no acá, porque es
/// una regla de negocio y no una propiedad de la tabla.
model ClubRestaurantLink {
  id           String   @id @default(cuid())
  clubId       String
  restaurantId String
  /// Orden de los iconos en la tablet de la cancha.
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  club       Restaurant @relation("ClubRestaurantLinkClub", fields: [clubId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation("ClubRestaurantLinkRestaurant", fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([clubId, restaurantId])
  @@index([clubId])
  @@index([restaurantId])
  @@map("club_restaurant_links")
}

enum ClubTabOrderStatus {
  PENDING // recién pedido desde la tablet
  PREPARING // el restaurante lo aceptó
  DELIVERED // ya se llevó a la cancha
  CANCELLED
}

enum ClubTabItemSource {
  CLUB_STORE // ShopProduct del propio club (descuenta stock)
  RESTAURANT // Product del restaurante vinculado (genera comanda, no toca stock del club)
}

/// Un pedido hecho desde la tablet de la cancha. Vive en el tenant del CLUB
/// (`restaurantId`), porque ahí es donde se cobra. `kitchenRestaurantId` es el
/// restaurante vinculado que debe prepararlo: lo resuelve el servidor desde
/// ClubRestaurantLink, nunca llega del cliente.
model ClubTabOrder {
  id           String             @id @default(cuid())
  restaurantId String
  bookingId    String
  /// Snapshot del nombre de la cancha ("Cancha 2") — es la "mesa" que ve el
  /// restaurante para saber a dónde llevar los productos. Congelado a propósito:
  /// si luego renombran la cancha, la comanda vieja no debe cambiar.
  courtName    String
  status       ClubTabOrderStatus @default(PENDING)

  totalBase    Decimal @db.Decimal(12, 2)
  exchangeRate Decimal @db.Decimal(12, 4)
  totalBs      Decimal @db.Decimal(14, 2)

  kitchenRestaurantId String?
  deliveredAt         DateTime?
  createdAt           DateTime  @default(now())

  restaurant Restaurant    @relation("ClubTabOrderClub", fields: [restaurantId], references: [id], onDelete: Cascade)
  kitchen    Restaurant?   @relation("ClubTabOrderKitchen", fields: [kitchenRestaurantId], references: [id], onDelete: SetNull)
  booking    ClubBooking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  items      ClubTabItem[]

  @@index([restaurantId, status])
  @@index([bookingId])
  @@index([kitchenRestaurantId, status])
  @@map("club_tab_orders")
}

/// Línea de un pedido de cancha. Congela nombre y precio al momento del pedido,
/// igual que OrderItem — el catálogo puede cambiar después.
model ClubTabItem {
  id              String            @id @default(cuid())
  tabOrderId      String
  source          ClubTabItemSource
  /// ShopProduct.id o Product.id según `source`. Informativo, sin FK: el producto
  /// del restaurante vive en otro tenant y puede borrarse.
  sourceProductId String?
  /// Variante del ShopProduct a descontar (los productos de la tienda del club
  /// se crean con una única variante "Unidad" — ver clubStoreApi.ts).
  variantV1       String?
  productName     String
  unitPrice       Decimal           @db.Decimal(12, 2)
  quantity        Int               @default(1)
  lineTotal       Decimal           @db.Decimal(12, 2)

  order ClubTabOrder @relation(fields: [tabOrderId], references: [id], onDelete: Cascade)

  @@index([tabOrderId])
  @@map("club_tab_items")
}

// ============================================================================
//  Torneos sociales de pádel (Americano / Mexicano)
// ============================================================================
//  Un torneo social no es un cuadro de eliminatorias: los jugadores compiten
//  INDIVIDUALMENTE y cambian de pareja en cada ronda. Los puntos que anota tu
//  pareja son tuyos, y la clasificación es la suma de todo lo que anotaste.
//
//  Americano: las parejas rotan buscando que juegues con y contra todo el
//  mundo — los cruces salen de un reparto equitativo (ver generateAmericano).
//  Mexicano: los cruces salen de la tabla de posiciones de la ronda anterior
//  (1º+4º vs 2º+3º), así que los que van ganando siempre se enfrentan entre sí.
//
//  Se corre desde la tablet de la cancha, que es donde están los jugadores.
// ============================================================================

enum ClubTournamentFormat {
  AMERICANO
  MEXICANO
}

enum ClubTournamentStatus {
  RUNNING
  FINISHED
}

/// Cómo se decide que un partido terminó.
enum ClubTournamentScoring {
  POINTS // se juega hasta repartir `pointsPerMatch` puntos entre los dos equipos
  TIME // se juega `minutesPerRound` minutos y vale el marcador que quede
}

model ClubTournament {
  id              String                @id @default(cuid())
  restaurantId    String
  name            String
  format          ClubTournamentFormat
  scoring         ClubTournamentScoring @default(POINTS)
  /// Puntos que se reparten en cada partido (modo POINTS). Ej: 24 → 16-8, 13-11…
  pointsPerMatch  Int                   @default(24)
  /// Duración de cada ronda en minutos (modo TIME).
  minutesPerRound Int                   @default(15)
  /// Canchas donde se juega, en orden. Se congelan los nombres: el torneo es de
  /// una tarde y renombrar una cancha después no debe reescribir su historia.
  courtNames      Json
  status          ClubTournamentStatus  @default(RUNNING)
  /// Última ronda generada. 0 = todavía ninguna.
  currentRound    Int                   @default(0)
  createdAt       DateTime              @default(now())
  finishedAt      DateTime?

  restaurant Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  players    ClubTournamentPlayer[]
  matches    ClubTournamentMatch[]

  @@index([restaurantId, status])
  @@map("club_tournaments")
}

model ClubTournamentPlayer {
  id           String @id @default(cuid())
  tournamentId String
  name         String
  sortOrder    Int    @default(0)

  tournament ClubTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("club_tournament_players")
}

/// Un partido de una ronda: dos parejas, una cancha y un marcador.
/// Los cuatro jugadores se guardan sueltos (no hay entidad "pareja") porque la
/// pareja solo existe durante este partido — en la ronda siguiente se deshace.
model ClubTournamentMatch {
  id           String @id @default(cuid())
  tournamentId String
  round        Int
  /// Nombre de la cancha donde se juega, congelado (ver courtNames).
  courtName    String

  teamAPlayer1Id String
  teamAPlayer2Id String
  teamBPlayer1Id String
  teamBPlayer2Id String

  /// Null = todavía no se cargó el resultado.
  scoreA Int?
  scoreB Int?

  createdAt DateTime  @default(now())
  playedAt  DateTime?

  tournament ClubTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, round])
  @@map("club_tournament_matches")
}

// ============================================================================
//  Academia de Pádel  — ver docs/ACADEMIA-PADEL.md
// ============================================================================
//  Una clase NO tiene tabla de calendario propia: es un ClubCourtBlock con
//  kind = CLASS, así que la restricción club_court_blocks_no_overlap la protege
//  contra el alquiler libre sin una sola línea de lógica de solapamiento nueva.
//  ClubClassSession es la tabla satélite que cuelga de ese bloque, igual que
//  ClubBooking cuelga del suyo.
// ============================================================================

enum ClubClassType {
  GROUP // clase de grupo recurrente
  PRIVATE // particular (uno a uno o pareja)
  CLINIC // clínica/intensivo puntual
}

/// Cómo se le paga al profesor. Lo elige el administrador POR profesor: un club
/// suele tener al titular a sueldo y al suplente por comisión.
enum ClubCoachPayType {
  FIXED_PER_SESSION // tarifa plana por clase dada
  HOURLY // por hora (grupos de 60 y 90 min mezclados)
  COMMISSION_ON_CONSUMED // % de lo que consumieron los alumnos PRESENTES
  COMMISSION_ON_ENROLLMENT // % de la mensualidad de sus inscritos, asistan o no
  MIXED // piso fijo por sesión + % sobre lo consumido
}

enum ClubGroupStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum ClubClassSessionStatus {
  SCHEDULED // generada y con cancha
  NEEDS_COURT // la fecha chocaba con una reserva: hay que reubicarla a mano
  PENDING_PAYMENT // particular reservada por el alumno, con hold que vence
  CONFIRMED // llegó al cupo mínimo, ya no se libera
  DONE // se dio y se pasó lista
  CANCELLED // la canceló el club
  RELEASED // se liberó por no llegar al cupo mínimo
}

enum ClubBillingMode {
  MONTHLY
  PACKAGE
  PER_CLASS
}

enum ClubEnrollmentStatus {
  ACTIVE
  PAUSED
  CANCELLED
  FINISHED
}

enum ClubAttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED // canceló dentro del plazo: no pierde la clase
  MAKEUP // vino a recuperar una clase de otro día
}

enum ClubCreditReason {
  PACKAGE_PURCHASE
  CLASS_CONSUMED
  CANCELLATION_TOKEN
  EXPIRED
  MANUAL_ADJUST
  REFUND
}

enum ClubAcademyPaymentKind {
  PACKAGE
  MONTHLY
  SINGLE_CLASS
  ENROLLMENT_FEE
}

enum ClubChargeStatus {
  PENDING
  PAID
  WAIVED
  OVERDUE
}

/// Programa o categoría de la academia: Infantil, Adultos, Competición, Clínicas.
///
/// Es una tabla y no un enum porque cada club nombra su oferta distinto —uno tiene
/// "Menores 8-12" y otro "Escuela"— y un enum obligaría a migrar el esquema cada
/// vez que un club quiera abrir una categoría nueva.
model ClubProgram {
  id           String @id @default(cuid())
  restaurantId String

  name        String
  description String?
  /// Color para distinguirlo de un vistazo en el calendario y los reportes.
  color       String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  groups     ClubClassGroup[]

  @@index([restaurantId, active])
  @@map("club_programs")
}

enum ClubWaitlistStatus {
  WAITING // anotado, esperando que se libere un puesto
  OFFERED // se le ofreció el puesto, esperando que confirme
  ENROLLED // entró al grupo
  CANCELLED
}

/// Lista de espera de un grupo lleno.
///
/// Se guarda el ORDEN de llegada (createdAt) y no una posición numérica: una
/// posición guardada habría que reordenarla a mano cada vez que alguien se cae
/// de la lista, y se desincroniza al primer fallo. El puesto se deriva.
model ClubWaitlistEntry {
  id           String @id @default(cuid())
  restaurantId String
  groupId      String
  studentId    String

  status     ClubWaitlistStatus @default(WAITING)
  note       String?
  /// Cuándo se le avisó que había puesto, para no volver a avisarle cada barrido.
  notifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  group      ClubClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student    ClubStudent    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Nadie se anota dos veces al mismo grupo.
  @@unique([groupId, studentId])
  @@index([restaurantId, status])
  @@map("club_waitlist_entries")
}

/// Reglas de reserva de la academia. Una fila por tenant con los valores por
/// defecto; el grupo solo sobreescribe releaseHoursBefore donde haga falta.
/// Repetir estas columnas en cada grupo sería ruido en el 95% de los casos.
model ClubAcademySettings {
  id           String @id @default(cuid())
  restaurantId String @unique

  /// Horas antes de la clase en que se decide si hay cupo mínimo o se libera.
  defaultReleaseHoursBefore Int  @default(12)
  /// Hasta cuándo el alumno puede cancelar sin perder la clase (gana ficha).
  cancelDeadlineHours       Int  @default(24)
  /// Tope de recuperaciones por mes: evita que el bono se use como ahorro.
  maxMakeupPerMonth         Int  @default(2)
  /// Vencimiento por defecto de las fichas. Editable después por paquete.
  creditExpiryDays          Int? @default(90)
  enrollmentOpensDaysBefore Int  @default(30)
  /// Minutos que se sostiene la cancha de una particular sin pago verificado.
  privateHoldMinutes        Int  @default(30)

  enforceLevelOnEnroll Boolean @default(true)
  notifyCoachOnEnroll  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("club_academy_settings")
}

/// El profesor es entidad propia, NO un User ni un Employee:
///  1. muchos no inician sesión nunca (el admin pasa lista por ellos),
///  2. el aviso de WhatsApp necesita su teléfono aunque no tenga cuenta,
///  3. cobra por la nómina que ya existe (Employee/EmployeePayment).
/// Así su identidad sobrevive a que se le borre el login o se le saque de la
/// nómina, y sus sesiones históricas siguen atribuidas.
model ClubCoach {
  id           String @id @default(cuid())
  restaurantId String

  displayName String
  phone       String // obligatorio: es el canal del aviso por WhatsApp
  email       String?

  /// Acceso al portal del entrenador. Opcional.
  userId     String? @unique
  /// Vínculo con la nómina para liquidarle honorarios. Opcional.
  employeeId String?

  /// Qué niveles puede dar (1.0 - 6.0). Null = sin restricción.
  levelMin Decimal? @db.Decimal(2, 1)
  levelMax Decimal? @db.Decimal(2, 1)

  bio       String?
  photoUrl  String?
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  // Honorarios. Se COPIAN congelados a cada sesión al generarla: si en marzo se
  // le sube la tarifa, las sesiones de febrero no pueden cambiar de costo.
  // payAmountBase y commissionPercent conviven a propósito — MIXED usa las dos.
  payType           ClubCoachPayType @default(FIXED_PER_SESSION)
  payAmountBase     Decimal?         @db.Decimal(12, 2)
  commissionPercent Decimal?         @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User?                   @relation("ClubCoachUser", fields: [userId], references: [id], onDelete: SetNull)
  employee     Employee?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  availability ClubCoachAvailability[]
  timeOff      ClubCoachTimeOff[]
  groups       ClubClassGroup[]
  sessions     ClubClassSession[]
  payouts      ClubCoachPayout[]

  @@index([restaurantId, active])
  @@index([employeeId])
  @@map("club_coaches")
}

/// Franjas en las que el profesor acepta dar clase. NO bloquea cancha: solo
/// restringe a qué grupos y particulares se le puede asignar. Si la
/// disponibilidad ocupara la rejilla, un club con cuatro profesores no podría
/// vender una sola hora libre.
model ClubCoachAvailability {
  id      String @id @default(cuid())
  coachId String

  weekday   Int // 0 = domingo … 6 = sábado
  startTime String // "HH:mm" hora local del club
  endTime   String // "HH:mm" — exclusivo

  coach ClubCoach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, weekday])
  @@map("club_coach_availability")
}

/// Ausencia puntual del profesor (vacaciones, lesión, viaje).
model ClubCoachTimeOff {
  id      String @id @default(cuid())
  coachId String

  startsAt DateTime
  endsAt   DateTime
  reason   String?

  createdAt DateTime @default(now())

  coach ClubCoach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, startsAt])
  @@map("club_coach_time_off")
}

/// Grupo de la academia. Su horario recurrente vive en ClubClassSlot (una fila
/// por día de la semana en que se reúne), no en un JSON ni en dos grupos.
model ClubClassGroup {
  id           String  @id @default(cuid())
  restaurantId String
  coachId      String
  /// Programa al que pertenece (Infantil, Adultos, Competición…). Opcional para
  /// no romper los grupos que ya existían sin programa.
  programId    String?

  name String // "Iniciación adultos", "Competición 4.5"

  // Nivel como Decimal, no enum: la consulta que importa es "qué grupos admiten
  // a un alumno de 3.5", y con un enum de once valores haría falta un mapa de
  // orden paralelo. Aquí es levelMin <= 3.5 AND levelMax >= 3.5.
  levelMin Decimal @db.Decimal(2, 1)
  levelMax Decimal @db.Decimal(2, 1)

  classType   ClubClassType @default(GROUP)
  capacityMin Int           @default(2)
  capacityMax Int           @default(4)

  seasonStart DateTime
  seasonEnd   DateTime?

  priceMonthlyBase  Decimal? @db.Decimal(12, 2)
  pricePerClassBase Decimal? @db.Decimal(12, 2)
  packagePriceBase  Decimal? @db.Decimal(12, 2)
  /// Clases que trae el lote de este grupo (para la silla recurrente).
  packageClasses    Int?

  /// Null = hereda defaultReleaseHoursBefore de ClubAcademySettings.
  releaseHoursBefore Int?

  status ClubGroupStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant  Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  coach       ClubCoach           @relation(fields: [coachId], references: [id], onDelete: Restrict)
  program     ClubProgram?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  slots       ClubClassSlot[]
  sessions    ClubClassSession[]
  enrollments ClubEnrollment[]
  packages    ClubClassPackage[]
  waitlist    ClubWaitlistEntry[]

  @@index([restaurantId, status])
  @@index([coachId])
  @@map("club_class_groups")
}

/// Un horario recurrente del grupo. Lunes y miércoles son DOS filas.
model ClubClassSlot {
  id      String @id @default(cuid())
  groupId String

  weekday         Int
  startTime       String // "HH:mm"
  durationMinutes Int     @default(60)
  /// Null = el generador busca cualquier cancha libre en esa franja.
  courtId         String?

  group    ClubClassGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  court    ClubCourt?         @relation(fields: [courtId], references: [id], onDelete: SetNull)
  packages ClubClassPackage[]

  @@index([groupId, weekday])
  @@map("club_class_slots")
}

/// Una ocurrencia concreta de clase.
model ClubClassSession {
  id           String @id @default(cuid())
  restaurantId String

  /// NULL cuando la fecha chocaba con una reserva ya existente (NEEDS_COURT).
  /// Es la diferencia con ClubBooking, donde el bloque es obligatorio: una
  /// reserva sin cancha no existe, pero una clase sin cancha sí — es una clase
  /// que hay que reubicar.
  blockId String? @unique
  groupId String? // NULL en particular/clínica suelta
  coachId String
  courtId String?

  // Duplicados del bloque A PROPÓSITO — única excepción consciente a no
  // denormalizar: una sesión liberada tiene su bloque CANCELLED, y el reporte
  // de "clases que no se llenaron" necesita la hora que iba a tener.
  startsAt DateTime
  endsAt   DateTime

  classType          ClubClassType
  capacityMin        Int
  capacityMax        Int
  /// Congelado al generar: la regla que aplicaba entonces, no la de hoy.
  releaseHoursBefore Int

  // Honorario del profesor congelado al generar la sesión.
  payType           ClubCoachPayType
  payAmountBase     Decimal?         @db.Decimal(12, 2)
  commissionPercent Decimal?         @db.Decimal(5, 2)
  /// Se resuelve al cerrar la sesión, con el criterio ya congelado arriba.
  coachFeeBase      Decimal?         @db.Decimal(12, 2)

  status ClubClassSessionStatus @default(SCHEDULED)

  /// Hasta cuándo se sostiene la cancha de una particular sin pago verificado.
  holdExpiresAt   DateTime?
  cancelReason    String?
  notifiedCoachAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant  Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  block       ClubCourtBlock?        @relation(fields: [blockId], references: [id], onDelete: SetNull)
  group       ClubClassGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  coach       ClubCoach              @relation(fields: [coachId], references: [id], onDelete: Restrict)
  court       ClubCourt?             @relation(fields: [courtId], references: [id], onDelete: SetNull)
  attendances ClubAttendance[]
  credits     ClubClassCreditEntry[]
  payments    ClubAcademyPayment[]

  @@unique([groupId, startsAt])
  @@index([restaurantId, startsAt])
  @@index([coachId, startsAt])
  @@index([restaurantId, status])
  @@map("club_class_sessions")
}

/// El alumno ES un Customer (identidad por teléfono, única por tenant), con una
/// extensión. Una identidad separada partiría su historial en dos: la misma
/// persona alquila cancha y toma clases.
model ClubStudent {
  id           String @id @default(cuid())
  restaurantId String
  customerId   String @unique

  level     Decimal?  @db.Decimal(2, 1)
  birthDate DateTime?

  // Menores de edad: a quién se avisa y a quién se le cobra.
  guardianName  String?
  guardianPhone String?

  /// Portal del alumno sin login — mismo patrón que ClubBooking.accessToken.
  accessToken String @unique

  medicalNotes String?
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant  Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer    Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  enrollments ClubEnrollment[]
  attendances ClubAttendance[]
  packages    ClubClassPackage[]
  credits     ClubClassCreditEntry[]
  payments    ClubAcademyPayment[]
  waitlist    ClubWaitlistEntry[]

  @@index([restaurantId, active])
  @@map("club_students")
}

model ClubEnrollment {
  id           String @id @default(cuid())
  restaurantId String
  studentId    String
  groupId      String

  billingMode ClubBillingMode @default(MONTHLY)
  /// Congelado al inscribir: subir el precio del grupo no reprecia al inscrito.
  priceBase   Decimal         @db.Decimal(12, 2)
  /// Día del mes en que se le genera el cargo (solo MONTHLY).
  billingDay  Int?

  status   ClubEnrollmentStatus @default(ACTIVE)
  startsAt DateTime
  endsAt   DateTime?

  /// Por qué se saltó la regla de nivel. Queda como rastro de la excepción.
  levelOverrideReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  student    ClubStudent         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group      ClubClassGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  charges    ClubAcademyCharge[]

  @@unique([studentId, groupId, startsAt])
  @@index([restaurantId, status])
  @@index([groupId, status])
  @@map("club_enrollments")
}

model ClubAttendance {
  id        String @id @default(cuid())
  sessionId String
  studentId String

  status ClubAttendanceStatus @default(PRESENT)

  /// El dinero que consumió esta silla, congelado al pasar lista.
  /// Es la columna que hace que salgan solos el honorario por comisión, la
  /// rentabilidad por grupo y el ingreso por sesión — sin reconstruir a
  /// posteriori por qué vía llegó el alumno (mensualidad, ficha o pago suelto).
  consumedValueBase Decimal @default(0) @db.Decimal(12, 2)

  /// Qué ficha se gastó, si se gastó una.
  creditEntryId String? @unique

  markedByUserId String?
  markedAt       DateTime @default(now())

  session     ClubClassSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     ClubStudent           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy    User?                 @relation("ClubAttendanceMarkedBy", fields: [markedByUserId], references: [id], onDelete: SetNull)
  creditEntry ClubClassCreditEntry? @relation(fields: [creditEntryId], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("club_attendance")
}

/// Lote de clases. NO es un bono flotante: al comprarlo el alumno escoge un
/// horario fijo ("todos los lunes 7pm") y reserva esa silla durante meses, así
/// que el cupo se cuenta hacia adelante (ver plazasOcupadas en el servicio).
/// La ficha, al gastarse, sí es genérica: sirve para recuperar en otro día.
model ClubClassPackage {
  id           String @id @default(cuid())
  restaurantId String
  studentId    String

  name              String
  totalClasses      Int
  priceBase         Decimal @db.Decimal(12, 2)
  /// priceBase / totalClasses, congelado: es lo que vale cada ficha al gastarse.
  pricePerClassBase Decimal @db.Decimal(12, 2)

  groupId   String?
  /// La franja recurrente que este lote le reserva al alumno.
  slotId    String?
  /// Si el lote ocupa cupo hacia adelante o es solo saldo de fichas.
  holdsSeat Boolean @default(true)

  purchasedAt DateTime  @default(now())
  /// Sale de creditExpiryDays al comprar, pero es EDITABLE por paquete: un
  /// alumno lesionado dos meses no puede perder lo que pagó porque el plazo
  /// por defecto no contemplaba eso.
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  student    ClubStudent            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group      ClubClassGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  slot       ClubClassSlot?         @relation(fields: [slotId], references: [id], onDelete: SetNull)
  credits    ClubClassCreditEntry[]
  payments   ClubAcademyPayment[]

  @@index([restaurantId, studentId])
  @@index([slotId, expiresAt])
  @@map("club_class_packages")
}

/// Libro mayor de fichas. El saldo es SUM(delta), NUNCA un contador mutable:
/// un contador se desincroniza en el primer error a mitad de transacción y deja
/// al alumno con clases pagadas que no puede usar, sin forma de auditar dónde
/// se perdieron. Mismo principio que el bloqueo por suscripción, que se calcula
/// en vivo y jamás se persiste.
///
/// La caducidad también se escribe como entrada negativa (EXPIRED) en vez de
/// filtrarse por fecha al leer: así el saldo es una suma plana sin lógica de
/// fechas repartida por diez consultas, y el vencimiento queda auditable.
model ClubClassCreditEntry {
  id           String @id @default(cuid())
  restaurantId String
  studentId    String

  delta  Int // +N al comprar el lote, -1 al pasar lista
  reason ClubCreditReason

  packageId String?
  sessionId String?
  note      String?
  expiresAt DateTime?

  createdAt DateTime @default(now())

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  student    ClubStudent       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  package    ClubClassPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  session    ClubClassSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  attendance ClubAttendance?

  @@index([restaurantId, studentId])
  @@index([studentId, createdAt])
  @@map("club_class_credit_entries")
}

/// Cobro de la academia. DEBE sumarse en collectPayments del arqueo
/// (cash-session.service.ts) o el club cierra la caja con diferencia todos los
/// días — es el mismo fallo que ya tuvo este vertical con las ventas de tienda.
model ClubAcademyPayment {
  id           String @id @default(cuid())
  restaurantId String
  studentId    String

  kind ClubAcademyPaymentKind

  packageId String?
  chargeId  String?
  sessionId String?

  amountBase   Decimal @db.Decimal(12, 2)
  exchangeRate Decimal @db.Decimal(12, 4)
  amountBs     Decimal @db.Decimal(14, 2)

  method          PaymentMethod
  referenceNumber String?
  proofImageUrl   String?

  receivedByUserId String?
  createdAt        DateTime @default(now())

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  student    ClubStudent        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  package    ClubClassPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  charge     ClubAcademyCharge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  session    ClubClassSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  receivedBy User?              @relation("ClubAcademyPaymentReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([studentId])
  @@map("club_academy_payments")
}

/// Mensualidad de un alumno. El @@unique es lo que hace idempotente la
/// generación: se puede correr diez veces el mismo día sin duplicarle la deuda.
model ClubAcademyCharge {
  id           String @id @default(cuid())
  restaurantId String
  enrollmentId String

  periodYear  Int
  periodMonth Int

  amountBase Decimal  @db.Decimal(12, 2)
  dueDate    DateTime

  status     ClubChargeStatus @default(PENDING)
  notifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  enrollment ClubEnrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  payments   ClubAcademyPayment[]

  @@unique([enrollmentId, periodYear, periodMonth])
  @@index([restaurantId, status])
  @@map("club_academy_charges")
}

// ============================================================================
//  Jugadores: cuenta propia, verificación por WhatsApp, lista negra y puntos
// ============================================================================

/// Reglas del alquiler de canchas. Una fila por club.
model ClubBookingSettings {
  id           String @id @default(cuid())
  restaurantId String @unique

  /// Exigir código de WhatsApp para cerrar una reserva pública.
  requirePhoneVerification Boolean @default(true)
  otpTtlMinutes            Int     @default(10)

  /// Lista negra automática por ausencias.
  ///
  /// CUIDADO: settlePastBookings marca NO_SHOW toda reserva sin check-in, así que
  /// en un club que no escanea los QR esto bloquearía a TODOS. Por eso el
  /// servicio no auto-bloquea si el club nunca ha registrado un check-in — sin
  /// escaneos, el dato de ausencia no significa nada.
  autoBlacklistEnabled Boolean @default(true)
  noShowStrikesToBlock Int     @default(1)

  /// Fidelización por uso y consumo.
  loyaltyEnabled        Boolean @default(true)
  pointsPerBooking      Int     @default(10)
  /// Puntos por cada unidad de la moneda base gastada (cancha + tienda).
  pointsPerCurrencyUnit Decimal @default(1) @db.Decimal(8, 2)
  /// Cuántos puntos equivalen a 1 unidad de la moneda base al canjear.
  pointsPerRedeemUnit   Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("club_booking_settings")
}

/// Código de un solo uso enviado por WhatsApp para verificar el teléfono antes
/// de cerrar una reserva.
///
/// El código se guarda HASHEADO, nunca en claro: una fuga de la base no puede
/// entregar códigos vivos. Y lleva contador de intentos porque seis dígitos se
/// adivinan por fuerza bruta en segundos si se deja intentar sin límite.
model ClubPhoneVerification {
  id           String @id @default(cuid())
  restaurantId String

  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  /// Se marca al usarlo; un código consumido no vale una segunda vez.
  consumedAt DateTime?

  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, phone, expiresAt])
  @@map("club_phone_verifications")
}

/// Cuenta del jugador para no repetir sus datos en cada alquiler.
///
/// Es un TERCER ámbito de autenticación, aparte del token de staff y del de la
/// plataforma: el JWT lleva `scope: 'player'` para que no pueda usarse contra
/// las rutas del panel aunque esté firmado con el mismo secreto.
model ClubPlayerAccount {
  id           String @id @default(cuid())
  restaurantId String
  customerId   String @unique

  /// Único por club, no globalmente: dos clubes distintos pueden tener su "carlos".
  username     String
  passwordHash String

  lastLoginAt DateTime?
  active      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings        ClubBooking[]
  invitesSent     ClubPlayInvite[] @relation("PlayInviteFrom")
  invitesReceived ClubPlayInvite[] @relation("PlayInviteTo")

  @@unique([restaurantId, username])
  @@index([restaurantId, active])
  @@map("club_player_accounts")
}

/// Jugador bloqueado para reservar por su cuenta.
///
/// Se guarda por TELÉFONO y no por customerId: quien falta suele volver a
/// intentarlo con otro nombre, y el teléfono es la identidad estable del
/// sistema (Customer ya es único por teléfono y tenant).
model ClubBlacklistEntry {
  id           String @id @default(cuid())
  restaurantId String

  phone       String
  customerId  String?
  reason      String
  /// Automática por ausencias, o puesta a mano por el club.
  automatic   Boolean @default(false)
  noShowCount Int     @default(0)

  /// Null = bloqueo vigente. Se levanta poniendo fecha, no borrando la fila:
  /// el historial de por qué se bloqueó no debe desaparecer al perdonar.
  liftedAt       DateTime?
  liftedByUserId String?
  liftedReason   String?

  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([restaurantId, phone, liftedAt])
  @@map("club_blacklist_entries")
}

enum ClubLoyaltyReason {
  BOOKING // reservó y jugó
  CONSUMPTION // consumió en la tienda/cancha
  MANUAL // ajuste del club
  REDEEM // canjeó puntos
  EXPIRED
}

/// Libro mayor de puntos. Mismo principio que las fichas de la academia: el
/// saldo es SUM(delta) y jamás un contador guardado, para que no se desincronice
/// y para que se pueda auditar de dónde salió cada punto.
model ClubLoyaltyEntry {
  id           String @id @default(cuid())
  restaurantId String
  customerId   String

  delta  Int
  reason ClubLoyaltyReason
  note   String?

  bookingId  String?
  /// Monto que originó los puntos, congelado: si mañana cambian las reglas de
  /// fidelización, lo ya otorgado no se recalcula.
  amountBase Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking    ClubBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([restaurantId, customerId])
  @@index([bookingId])
  @@map("club_loyalty_entries")
}

enum ClubInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// Invitación de un jugador a otro para completar un partido.
model ClubPlayInvite {
  id           String @id @default(cuid())
  restaurantId String

  fromAccountId String
  /// Si el invitado ya tiene cuenta. Si no, se invita por teléfono.
  toAccountId   String?
  toPhone       String?
  toName        String?

  bookingId String?
  message   String?
  status    ClubInviteStatus @default(PENDING)

  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  restaurant  Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  fromAccount ClubPlayerAccount  @relation("PlayInviteFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   ClubPlayerAccount? @relation("PlayInviteTo", fields: [toAccountId], references: [id], onDelete: Cascade)
  booking     ClubBooking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status])
  @@index([toAccountId, status])
  @@map("club_play_invites")
}

/// Liquidación de honorarios de un período. El pago real se registra como
/// Movement(EXPENSE, PAYROLL) + EmployeePayment reutilizando el módulo de
/// nómina, para que el honorario pese en el balance y en el arqueo en vez de
/// ser un gasto invisible.
///
/// movementId/employeePaymentId van SIN FK a propósito, igual que
/// ShopOrder.shopSaleId: la nómina es un módulo compartido con los otros
/// verticales y no debe conocer a la academia.
model ClubCoachPayout {
  id           String @id @default(cuid())
  restaurantId String
  coachId      String

  periodStart   DateTime
  periodEnd     DateTime
  sessionsCount Int
  amountBase    Decimal  @db.Decimal(12, 2)

  movementId        String?
  employeePaymentId String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  coach      ClubCoach  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([restaurantId, coachId])
  @@map("club_coach_payouts")
}

enum ClubReportedPaymentStatus {
  PENDING // el jugador lo reportó, nadie lo confirmó todavía
  CONFIRMED
  REJECTED
}

/// Pago que el JUGADOR reporta desde la tablet: transfirió y escribió su número
/// de referencia. No es plata confirmada, y por eso vive en su propia tabla y no
/// en ClubBookingPayment — así no ensucia saldos, deudas ni arqueo de caja hasta
/// que el cobrador lo apruebe. QuickTap no tiene pasarela: el cobro siempre lo
/// valida una persona.
model ClubReportedPayment {
  id                String                    @id @default(cuid())
  /// El club, dueño de la fila (la reserva es suya aunque cobre otro).
  restaurantId      String
  bookingId         String
  /// A quién dice haberle pagado. null = al club (cancha o su tienda propia);
  /// si no, la tienda vinculada que cobra lo suyo.
  payeeRestaurantId String?
  amountBase        Decimal                   @db.Decimal(12, 2)
  /// Congelados al reportar, igual que en Order: si la tasa cambia después, el
  /// monto que el jugador dice haber transferido no se reescribe.
  exchangeRate      Decimal                   @db.Decimal(12, 4)
  amountBs          Decimal                   @db.Decimal(14, 2)
  method            PaymentMethod
  referenceNumber   String?
  status            ClubReportedPaymentStatus @default(PENDING)
  reviewedAt        DateTime?
  /// Al aprobar un pago al club se crea el ClubBookingPayment real; queda su id
  /// para poder rastrear de dónde salió.
  bookingPaymentId  String?
  createdAt         DateTime                  @default(now())

  restaurant Restaurant  @relation("ClubReportedPaymentClub", fields: [restaurantId], references: [id], onDelete: Cascade)
  payee      Restaurant? @relation("ClubReportedPaymentPayee", fields: [payeeRestaurantId], references: [id], onDelete: SetNull)
  booking    ClubBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([payeeRestaurantId, status])
  @@index([bookingId])
  @@map("club_reported_payments")
}

/// Token de push (FCM) de un dispositivo — app de escritorio (Electron) o Android (Capacitor).
/// Un usuario puede tener varios dispositivos; se manda el push a todos los suyos. El token en
/// sí lo entrega Firebase al registrarse en el dispositivo, ver PushNotifications.addListener
/// en el frontend.
model DeviceToken {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String
  token        String   @unique
  platform     String // "android" | "ios" | "windows"
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("device_tokens")
}

/// Registro inborrable de comandas eliminadas: quién la borró, cuándo y qué tenía.
/// No existe NINGÚN endpoint para borrar filas de esta tabla a propósito — el
/// registro es permanente; solo Dueño/Admin pueden consultarlo.
model OrderDeletionLog {
  id            String   @id @default(cuid())
  restaurantId  String
  orderNumber   Int
  channel       String
  status        String
  tableName     String?
  customerName  String?
  totalBase     Decimal  @db.Decimal(12, 2)
  /// Cuánto se había COBRADO ya de ese pedido cuando lo borraron (cobros + descuentos
  /// otorgados, mismo criterio que settledOf). Sin esto la bitácora no distinguía borrar un
  /// pedido que nadie pagó de borrar uno del que ya se había recibido el efectivo — que es
  /// justo el caso que un registro de borrados existe para poder revisar.
  paidBase      Decimal  @default(0) @db.Decimal(12, 2)
  /// Con qué se había cobrado, para cruzarlo contra el arqueo del turno.
  paidMethods   Json?
  /// Snapshot de los renglones al momento del borrado: [{ name, quantity, unitPrice, variantName, modifiers }]
  items         Json
  deletedByName String
  deletedByRole String
  deletedAt     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, deletedAt])
  @@map("order_deletion_logs")
}

/// Registro inborrable de ventas eliminadas (Locales Comerciales y Tickera, mismo ShopSale):
/// quién la borró, cuándo y qué tenía. No existe NINGÚN endpoint para borrar filas de esta
/// tabla a propósito — el registro es permanente; solo Dueño/Admin pueden consultarlo.
model ShopSaleDeletionLog {
  id            String   @id @default(cuid())
  restaurantId  String
  total         Float
  time          DateTime
  customerName  String?
  customerPhone String?
  creditTerms   String?
  /// Snapshot de los renglones al momento del borrado: [{ name, qty, price }]
  items         Json
  /// Cuántas entradas de evento (ShopTicket) se borraron con esta venta, si tenía.
  ticketsCount  Int      @default(0)
  deletedByName String
  deletedByRole String
  deletedAt     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, deletedAt])
  @@map("shop_sale_deletion_logs")
}

/// Intento de registro en la pasarela (/empezar → /admin/register), completado o no.
///
/// Existe para responder "¿cuánta gente empieza a registrarse y no termina?" y, sobre todo, para
/// no perder a quien dejó su contacto a medio camino: cada fila guarda lo que alcanzó a escribir
/// (nunca la contraseña) para que el equipo pueda llamarlo después.
///
/// Se identifica por `sessionId`, un id opaco que genera el navegador y vive en su
/// sessionStorage: sin cuenta todavía no hay a quién atarlo, y usar la IP mezclaría a todos los
/// que comparten una. Una misma persona que vuelve en otra pestaña cuenta como intento nuevo, a
/// propósito — es un intento de registro, no una persona.
model RegistrationAttempt {
  id        String @id @default(cuid())
  sessionId String @unique

  /// Hasta dónde llegó: START (eligió vertical) | FORM (abrió el formulario) | COMPLETED (se registró).
  stage String @default("START")

  /// Vertical elegido en /empezar: restaurant | shop | club | office.
  businessType String?
  /// Rubro de Local Comercial, cuando aplica.
  shopRubro    String?

  // Lo que alcanzó a escribir en el formulario. La contraseña NUNCA se guarda ni viaja al
  // servidor — el frontend no la manda en el seguimiento.
  restaurantName String?
  slug           String?
  whatsappPhone  String?
  ownerName      String?
  email          String?

  /// De dónde venía (?plan=, utm_*, etc.), para saber qué campaña trae gente que no cierra.
  landingQuery String?

  /// Último error que le impidió registrarse ("Ese slug ya está en uso"), si lo intentó.
  lastError String?

  /// Se llena solo cuando termina el registro — sirve para el % de conversión y para no
  /// llamar a quien ya es cliente.
  completedAt  DateTime?
  restaurantId String?

  /// Marcado por el equipo cuando ya lo contactó, para no llamar dos veces.
  contactedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage, createdAt])
  @@index([completedAt])
  @@map("registration_attempts")
}
